/* theme/qss/60_processing.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

/* Runtime path dialog */
QLabel#RuntimePathsDescription {
    color: #425467;
}

QLabel#RuntimePathsStatusLabel[state="normal"] {
    color: #64748b;
    font-weight: 400;
}

QLabel#RuntimePathsStatusLabel[state="warning"] {
    color: #b45309;
    font-weight: 600;
}

QLabel#RuntimePathsStatusBadge {
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: bold;
    font-size: 11px;
    qproperty-alignment: AlignCenter;
}

QLabel#RuntimePathsStatusBadge[state="ok"] {
    background-color: #ecfdf5;
    border: 1px solid #10b981;
    color: #047857;
}

QLabel#RuntimePathsStatusBadge[state="nok"] {
    background-color: #fef2f2;
    border: 1px solid #f87171;
    color: #b91c1c;
}

QLabel#RuntimePathsLabel {
    min-width: 160px;
    max-width: 160px;
}

QLineEdit#RuntimePathsLineEdit {
    min-width: 150px;
}

QPushButton#RuntimePathsBrowseButton {
    min-width: 75px;
    max-width: 75px;
}

QPushButton#RuntimePathsApplyButton {
    background-color: #00457C;
    color: #ffffff;
    border: 1px solid #00335e;
}

QPushButton#RuntimePathsApplyButton:hover {
    background-color: #005a9e;
}

QPushButton#RuntimePathsApplyButton:pressed {
    background-color: #00335e;
}


/* OpenCV processing panel */
QLabel#ProcessingEditorTitle,
QLabel#ProcessingParamTitle {
    font-weight: 600;
    color: #000000;
}

QToolButton#ProcessingEnableToggle[active="true"] {
    border-color: #cfd9e4;
    background-color: #f1f3f5;
    color: #000000;
}

QToolButton#ProcessingEnableToggle[active="true"]:hover {
    background-color: #e9ecef;
    border-color: #b7c7d8;
}

QWidget#ProcessingEditorContainer {
    background: transparent;
}

QWidget#ProcessingTabBar {
    background-color: #f1f5f9;
    border: 1px solid #cfd9e4;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 28px;
    max-height: 28px;
}

QLabel#ProcessingFileNameLabel {
    background-color: #ffffff;
    color: #1e293b;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border: 1px solid #cfd9e4;
    border-bottom: none;
    font-weight: 600;
    font-size: 11px;
    padding: 0px 16px;
    margin-top: 4px;
    margin-bottom: 0px;
    height: 24px;
    qproperty-alignment: AlignCenter;
}

QToolButton#ProcessingTabLoadBtn,
QToolButton#ProcessingTabSaveBtn {
    width: 20px;
    height: 20px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    border: none;
    background: transparent;
    padding: 1px;
    margin-top: 4px;
}

QToolButton#ProcessingTabLoadBtn:hover,
QToolButton#ProcessingTabSaveBtn:hover {
    background-color: #cbd5e1;
    border-radius: 4px;
}

QToolButton#ProcessingTabLoadBtn:pressed,
QToolButton#ProcessingTabSaveBtn:pressed {
    background-color: #94a3b8;
}

QToolButton#ProcessingTabSaveBtn:disabled {
    opacity: 0.4;
}

QPlainTextEdit#ProcessingCodeEditor {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cfd9e4;
    border-top: 1px solid #cfd9e4;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 0px;
    padding-right: 4px;
    font-family: "JetBrains Mono", monospace;
}

QLabel#ProcessingParamEditorTitle {
    font-weight: 600;
    color: #16202b;
    font-size: 11px;
}

QTextEdit#ProcessingParamEditor {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cfd9e4;
    border-radius: 8px;
    padding: 4px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
}

QLabel#ProcessingParamHintLabel {
    color: #64748b;
    font-style: italic;
    padding: 6px;
    font-size: 11px;
}

QLabel#ProcessingParamEmptyLabel {
    color: #777777;
    font-style: italic;
    padding: 4px;
}

QLabel#ProcessingParamNameLabel {
    color: #000000;
    font-weight: 600;
}

QLabel#ProcessingParamValueLabel {
    font-weight: bold;
    color: #000000;
}

QSlider#ProcessingParamSlider {
    height: 20px;
    min-height: 20px;
    max-height: 20px;
}

QSlider#ProcessingParamSlider::groove:horizontal {
    border: none;
    height: 2px;
    background: #edf2f7;
    border-radius: 1px;
}

QSlider#ProcessingParamSlider::sub-page:horizontal {
    background: #00457C;
    border-radius: 1px;
}

QSlider#ProcessingParamSlider::handle:horizontal {
    background: #ffffff;
    border: 1px solid #cfd9e4;
    width: 12px;
    height: 12px;
    margin: -6px 0;
    border-radius: 7px;
}

QSlider#ProcessingParamSlider::handle:horizontal:hover {
    border-color: #8badc7;
    background: #f8fafc;
}

QSlider#ProcessingParamSlider::handle:horizontal:pressed {
    border-color: #7097b3;
    background: #f1f5f9;
}

QTableWidget#ProcessingParamTable,
QTableWidget#ProcessingAdjustTable {
    background: #ffffff;
    gridline-color: #edf2f7;
    selection-background-color: transparent;
}

QTableWidget#ProcessingParamTable::item:selected,
QTableWidget#ProcessingAdjustTable::item:selected {
    background: transparent;
}

QTableWidget#ProcessingParamTable::item,
QTableWidget#ProcessingAdjustTable::item {
    padding: 0px;
}

QTableWidget#ProcessingParamTable::item:hover,
QTableWidget#ProcessingAdjustTable::item:hover {
    background: transparent;
}

/* Table container and cell widget styling */
QWidget#CellWidgetContainer {
    background: transparent;
    border: none;
}

QTableWidget#ProcessingParamTable QLineEdit,
QTableWidget#ProcessingParamTable QComboBox,
QTableWidget#ProcessingParamTable QAbstractSpinBox,
QTableWidget#ProcessingAdjustTable QLineEdit,
QTableWidget#ProcessingAdjustTable QComboBox,
QTableWidget#ProcessingAdjustTable QSpinBox,
QTableWidget#ProcessingAdjustTable QDoubleSpinBox {
    background: #ffffff;
    border: 1px solid #cfd9e4;
    border-radius: 8px;
}

QTableWidget#ProcessingAdjustTable QSpinBox,
QTableWidget#ProcessingAdjustTable QDoubleSpinBox {
    min-height: 22px;
    max-height: 22px;
}

QCheckBox#ProcessingParamCheckBox {
    padding-left: 3px;
}

QTableWidget#ProcessingParamTable QLineEdit,
QTableWidget#ProcessingAdjustTable QLineEdit {
    padding: 0 4px;
}

QTableWidget#ProcessingParamTable QComboBox,
QTableWidget#ProcessingParamTable QAbstractSpinBox,
QTableWidget#ProcessingAdjustTable QComboBox,
QTableWidget#ProcessingAdjustTable QSpinBox,
QTableWidget#ProcessingAdjustTable QDoubleSpinBox {
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 4px;
    padding-right: 4px;
}

QTableWidget#ProcessingParamTable QLineEdit:hover,
QTableWidget#ProcessingParamTable QComboBox:hover,
QTableWidget#ProcessingParamTable QAbstractSpinBox:hover,
QTableWidget#ProcessingAdjustTable QLineEdit:hover,
QTableWidget#ProcessingAdjustTable QComboBox:hover,
QTableWidget#ProcessingAdjustTable QSpinBox:hover,
QTableWidget#ProcessingAdjustTable QDoubleSpinBox:hover {
    border-color: #cfd9e4;
    background-color: #ffffff;
}

QTableWidget#ProcessingParamTable QLineEdit:focus,
QTableWidget#ProcessingParamTable QComboBox:focus,
QTableWidget#ProcessingParamTable QAbstractSpinBox:focus,
QTableWidget#ProcessingAdjustTable QLineEdit:focus,
QTableWidget#ProcessingAdjustTable QComboBox:focus,
QTableWidget#ProcessingAdjustTable QSpinBox:focus,
QTableWidget#ProcessingAdjustTable QDoubleSpinBox:focus {
    border-color: #8badc7;
    background-color: #ffffff;
}

QTableWidget#ProcessingParamTable QComboBox:on,
QTableWidget#ProcessingAdjustTable QComboBox:on {
    border-color: #8badc7;
    background-color: #ffffff;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom: none;
}

QCheckBox#ParamRowSelectCheck {
    min-width: 24px;
    max-width: 24px;
    width: 24px;
    spacing: 0px;
    padding: 0px;
    margin: 0px;
    background: transparent;
}

QCheckBox#ParamRowSelectCheck::indicator {
    width: 22px;
    height: 22px;
    border-radius: 8px;
}

/* QCodeEditor Line Number Gutter */
QWidget#ProcessingLineNumberArea {
    background-color: transparent;
}

/* Build Log Splitter */
QSplitter#ProcessingEditorSplitter::handle {
    background-color: #e2e8f0;
    height: 2px;
}

/* Build Log Panel Container */
QWidget#ProcessingBuildLogContainer {
    background-color: #ffffff;
    border-top: 1px solid #cfd9e4;
}

/* Build Log Header */
QWidget#ProcessingBuildLogHeader {
    background-color: #f1f5f9;
    border-bottom: 1px solid #e2e8f0;
    min-height: 28px;
    max-height: 28px;
}

QLabel#ProcessingBuildLogTitle {
    font-weight: bold;
    color: #475569;
    font-size: 11px;
    padding-left: 8px;
}

QToolButton#ProcessingBuildLogClose {
    border: none;
    background: transparent;
    padding: 2px;
    border-radius: 4px;
    margin-right: 4px;
}

QToolButton#ProcessingBuildLogClose:hover {
    background-color: #cbd5e1;
}

QToolButton#ProcessingBuildLogClose:pressed {
    background-color: #94a3b8;
}

/* Build Log Table */
QTableWidget#ProcessingBuildLogTable {
    background-color: #ffffff;
    border: none;
    gridline-color: #edf2f7;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
}

QTableWidget#ProcessingBuildLogTable::item {
    padding: 4px 8px;
}

QTableWidget#ProcessingBuildLogTable::item:selected {
    background-color: #f1f5f9;
    color: #0f172a;
}

/* Processing ToolBar */
QToolBar#ProcessingToolBar {
    background: transparent;
    border: none;
    spacing: 4px;
    padding: 0px;
}


