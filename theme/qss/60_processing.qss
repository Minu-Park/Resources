/* theme/qss/60_processing.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

/* Runtime path dialog */
QLabel#RuntimePathsDescription {
    color: #425467;
}

QLabel#RuntimePathsStatusLabel[state="normal"] {
    color: #64748b;
    font-weight: 400;
}

QLabel#RuntimePathsStatusLabel[state="warning"] {
    color: #b45309;
    font-weight: 600;
}

QLabel#RuntimePathsStatusBadge {
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: bold;
    font-size: 11px;
    qproperty-alignment: AlignCenter;
}

QLabel#RuntimePathsStatusBadge[state="ok"] {
    background-color: #ecfdf5;
    border: 1px solid #10b981;
    color: #047857;
}

QLabel#RuntimePathsStatusBadge[state="nok"] {
    background-color: #fef2f2;
    border: 1px solid #f87171;
    color: #b91c1c;
}

QGroupBox#RuntimePathsGroupBox {
    border: 1px solid #d9e1ea;
    border-radius: 8px;
    margin-top: 8px;
    padding-top: 14px;
    font-weight: bold;
}

QGroupBox#RuntimePathsGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: #00457C;
    font-size: 11px;
}

QLabel#RuntimePathsLabel {
    min-width: 160px;
    max-width: 160px;
}

QLineEdit#RuntimePathsLineEdit {
    min-width: 150px;
    min-height: 22px;
    max-height: 22px;
    padding-top: 0px;
    padding-right: 10px;
    padding-bottom: 0px;
    font-size: 12px;
}

QPushButton#RuntimePathsBrowseButton {
    min-width: 75px;
    max-width: 75px;
    min-height: 22px;
    max-height: 22px;
    padding: 0px 6px;
    margin: 0px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#RuntimePathsApplyButton {
    background-color: #00457C;
    color: #ffffff;
    border: 1px solid #00335e;
}

QPushButton#RuntimePathsApplyButton:hover {
    background-color: #005a9e;
}

QPushButton#RuntimePathsApplyButton:pressed {
    background-color: #00335e;
}


/* OpenCV processing panel */
QLabel#ProcessingEditorTitle,
QLabel#ProcessingParamTitle {
    font-weight: 600;
    color: #000000;
}

QToolButton#ProcessingEnableToggle,
QToolButton#ProcessingAddParam,
QToolButton#ProcessingRemoveParam {
    background: #ffffff;
    border: 1px solid #d7dee6;
    border-radius: 9px;
    padding: 0 7px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    margin: 0 2px 0 0;
    color: #000000;
    font-weight: bold;
    font-size: 11px;
}

QToolButton#ProcessingAddParam:hover,
QToolButton#ProcessingRemoveParam:hover {
    background: #eef3f8;
    border-color: #c7d4e2;
    color: #000000;
}

QToolButton#ProcessingAddParam:pressed,
QToolButton#ProcessingRemoveParam:pressed {
    background: #e7eef6;
    border-color: #bccbda;
}

QToolButton#ProcessingEnableToggle[active="true"] {
    border-color: #cfd9e4;
    background-color: #f1f3f5;
    color: #000000;
}

QToolButton#ProcessingEnableToggle[active="true"]:hover {
    background-color: #e9ecef;
    border-color: #b7c7d8;
}

QTextEdit#ProcessingCodeEditor {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cfd9e4;
    border-radius: 8px;
    padding: 6px;
    font-family: "JetBrains Mono", monospace;
}

QLabel#ProcessingParamEditorTitle {
    font-weight: 600;
    color: #16202b;
    font-size: 11px;
}

QTextEdit#ProcessingParamEditor {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cfd9e4;
    border-radius: 8px;
    padding: 4px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
}

QLabel#ProcessingParamHintLabel {
    color: #64748b;
    font-style: italic;
    padding: 6px;
    font-size: 11px;
}

QLabel#ProcessingParamEmptyLabel {
    color: #777777;
    font-style: italic;
    padding: 4px;
}

QLabel#ProcessingParamNameLabel {
    color: #000000;
    font-weight: 600;
}

QLabel#ProcessingParamValueLabel {
    font-weight: bold;
    color: #000000;
}

QSlider#ProcessingParamSlider {
    height: 20px;
    min-height: 20px;
    max-height: 20px;
}

QSlider#ProcessingParamSlider::groove:horizontal {
    border: none;
    height: 2px;
    background: #edf2f7;
    border-radius: 1px;
}

QSlider#ProcessingParamSlider::sub-page:horizontal {
    background: #00457C;
    border-radius: 1px;
}

QSlider#ProcessingParamSlider::handle:horizontal {
    background: #ffffff;
    border: 1px solid #cfd9e4;
    width: 12px;
    height: 12px;
    margin: -6px 0;
    border-radius: 7px;
}

QSlider#ProcessingParamSlider::handle:horizontal:hover {
    border-color: #8badc7;
    background: #f8fafc;
}

QSlider#ProcessingParamSlider::handle:horizontal:pressed {
    border-color: #7097b3;
    background: #f1f5f9;
}

QTableWidget#ProcessingParamTable,
QTableWidget#ProcessingAdjustTable {
    border: none;
    padding: 0px;
    background: #ffffff;
    gridline-color: #edf2f7;
    selection-background-color: transparent;
}

QTableWidget#ProcessingParamTable::item:selected,
QTableWidget#ProcessingAdjustTable::item:selected {
    background: transparent;
}

QTableWidget#ProcessingParamTable::item,
QTableWidget#ProcessingAdjustTable::item {
    padding: 0px;
}

QTableWidget#ProcessingParamTable::item:hover,
QTableWidget#ProcessingAdjustTable::item:hover {
    background: transparent;
}

/* Table container and cell widget styling */
QWidget#CellWidgetContainer {
    background: transparent;
    border: none;
}

QTableWidget#ProcessingParamTable QLineEdit,
QTableWidget#ProcessingParamTable QComboBox,
QTableWidget#ProcessingParamTable QAbstractSpinBox,
QTableWidget#ProcessingAdjustTable QLineEdit,
QTableWidget#ProcessingAdjustTable QComboBox,
QTableWidget#ProcessingAdjustTable QSpinBox,
QTableWidget#ProcessingAdjustTable QDoubleSpinBox {
    background: #ffffff;
    border: 1px solid #cfd9e4;
    border-radius: 8px;
}

QTableWidget#ProcessingAdjustTable QSpinBox,
QTableWidget#ProcessingAdjustTable QDoubleSpinBox {
    min-height: 22px;
    max-height: 22px;
}

QCheckBox#ProcessingParamCheckBox {
    padding-left: 3px;
}

QTableWidget#ProcessingParamTable QLineEdit,
QTableWidget#ProcessingAdjustTable QLineEdit {
    padding: 0 4px;
}

QTableWidget#ProcessingParamTable QComboBox,
QTableWidget#ProcessingParamTable QAbstractSpinBox,
QTableWidget#ProcessingAdjustTable QComboBox,
QTableWidget#ProcessingAdjustTable QSpinBox,
QTableWidget#ProcessingAdjustTable QDoubleSpinBox {
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 4px;
    padding-right: 4px;
}

QTableWidget#ProcessingParamTable QLineEdit:hover,
QTableWidget#ProcessingParamTable QComboBox:hover,
QTableWidget#ProcessingParamTable QAbstractSpinBox:hover,
QTableWidget#ProcessingAdjustTable QLineEdit:hover,
QTableWidget#ProcessingAdjustTable QComboBox:hover,
QTableWidget#ProcessingAdjustTable QSpinBox:hover,
QTableWidget#ProcessingAdjustTable QDoubleSpinBox:hover {
    border-color: #cfd9e4;
    background-color: #ffffff;
}

QTableWidget#ProcessingParamTable QLineEdit:focus,
QTableWidget#ProcessingParamTable QComboBox:focus,
QTableWidget#ProcessingParamTable QAbstractSpinBox:focus,
QTableWidget#ProcessingAdjustTable QLineEdit:focus,
QTableWidget#ProcessingAdjustTable QComboBox:focus,
QTableWidget#ProcessingAdjustTable QSpinBox:focus,
QTableWidget#ProcessingAdjustTable QDoubleSpinBox:focus {
    border-color: #8badc7;
    background-color: #ffffff;
}

QTableWidget#ProcessingParamTable QComboBox:on,
QTableWidget#ProcessingAdjustTable QComboBox:on {
    border-color: #8badc7;
    background-color: #ffffff;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom: none;
}

QCheckBox#ParamRowSelectCheck {
    min-width: 24px;
    max-width: 24px;
    width: 24px;
    spacing: 0px;
    padding: 0px;
    margin: 0px;
    background: transparent;
}

QCheckBox#ParamRowSelectCheck::indicator {
    width: 22px;
    height: 22px;
    border-radius: 8px;
}
