/* theme/qss/60_processing.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

/* Runtime path dialog */
QLabel#RuntimePathsDescription {
    color: #425467;
}

QLabel#RuntimePathsStatusLabel[state="normal"] {
    color: #64748b;
    font-weight: 400;
}

QLabel#RuntimePathsStatusLabel[state="warning"] {
    color: #b45309;
    font-weight: 600;
}

QLabel#RuntimePathsStatusBadge {
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: bold;
    font-size: 11px;
    qproperty-alignment: AlignCenter;
}

QLabel#RuntimePathsStatusBadge[state="ok"] {
    background-color: #ecfdf5;
    border: 1px solid #10b981;
    color: #047857;
}

QLabel#RuntimePathsStatusBadge[state="nok"] {
    background-color: #fef2f2;
    border: 1px solid #f87171;
    color: #b91c1c;
}

QLabel#RuntimePathsLabel {
    min-width: 160px;
    max-width: 160px;
}

QLineEdit#RuntimePathsLineEdit {
    min-width: 150px;
}

QPushButton#RuntimePathsBrowseButton {
    min-width: 75px;
    max-width: 75px;
}

QPushButton#RuntimePathsApplyButton {
    background-color: #00457C;
    color: #ffffff;
    border: 1px solid #00335e;
}

QPushButton#RuntimePathsApplyButton:hover {
    background-color: #005a9e;
}

QPushButton#RuntimePathsApplyButton:pressed {
    background-color: #00335e;
}


/* OpenCV processing panel */
QLabel#ProcessingEditorTitle {
    font-weight: 600;
    color: #000000;
}

QToolButton#ProcessingEnableToggle[active="true"] {
    border-color: #cfd9e4;
    background-color: #f1f3f5;
    color: #000000;
}

QToolButton#ProcessingEnableToggle[active="true"]:hover {
    background-color: #e9ecef;
    border-color: #b7c7d8;
}

QWidget#ProcessingEditorContainer {
    background: transparent;
}

QWidget#ProcessingTabBar {
    background-color: #f1f5f9;
    border: 1px solid #cfd9e4;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 32px;
    max-height: 32px;
}

QToolButton#ProcessingTabAddBtn,
QToolButton#ProcessingTabDeleteBtn,
QToolButton#ProcessingTabLoadBtn,
QToolButton#ProcessingTabSaveBtn {
    width: 20px;
    height: 20px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    border: none;
    background: transparent;
    padding: 1px;
}

QToolButton#ProcessingTabAddBtn:hover,
QToolButton#ProcessingTabDeleteBtn:hover,
QToolButton#ProcessingTabLoadBtn:hover,
QToolButton#ProcessingTabSaveBtn:hover {
    background-color: #cbd5e1;
    border-radius: 4px;
}

QToolButton#ProcessingTabAddBtn:pressed,
QToolButton#ProcessingTabDeleteBtn:pressed,
QToolButton#ProcessingTabLoadBtn:pressed,
QToolButton#ProcessingTabSaveBtn:pressed {
    background-color: #94a3b8;
}

QToolButton#ProcessingTabDeleteBtn:disabled,
QToolButton#ProcessingTabSaveBtn:disabled {
    opacity: 0.4;
}

QComboBox#ProcessingScriptComboBox {
    font-weight: 600;
    font-size: 11px;
    min-width: 120px;
    max-width: 200px;
}

QPlainTextEdit#ProcessingCodeEditor {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cfd9e4;
    border-top: 1px solid #cfd9e4;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 0px;
    padding-right: 4px;
    font-family: "JetBrains Mono";
}

QLabel#ProcessingParamEditorTitle {
    font-weight: 600;
    color: #16202b;
    font-size: 11px;
}

QTextEdit#ProcessingParamEditor {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cfd9e4;
    border-radius: 8px;
    padding: 4px;
    font-family: "JetBrains Mono";
    font-size: 11px;
}

QLabel#ProcessingParamHintLabel {
    color: #64748b;
    font-style: italic;
    padding: 6px;
    font-size: 11px;
}

QLabel#ProcessingParamNameLabel {
    color: #000000;
    font-weight: 400;
}

QSlider#ProcessingParamSlider {
    height: 20px;
    min-height: 20px;
    max-height: 20px;
}

QSlider#ProcessingParamSlider::groove:horizontal {
    border: none;
    height: 2px;
    background: #edf2f7;
    border-radius: 1px;
}

QSlider#ProcessingParamSlider::sub-page:horizontal {
    background: #00457C;
    border-radius: 1px;
}

QSlider#ProcessingParamSlider::handle:horizontal {
    background: #ffffff;
    border: 1px solid #cfd9e4;
    width: 12px;
    height: 12px;
    margin: -6px 0;
    border-radius: 7px;
}

QSlider#ProcessingParamSlider::handle:horizontal:hover {
    border-color: #8badc7;
    background: #f8fafc;
}

QSlider#ProcessingParamSlider::handle:horizontal:pressed {
    border-color: #7097b3;
    background: #f1f5f9;
}

QCheckBox#ProcessingParamCheckBox {
    padding-left: 3px;
}

/* QCodeEditor Line Number Gutter */
QWidget#ProcessingLineNumberArea {
    background-color: transparent;
}

/* Build Log Splitter */
QSplitter#ProcessingEditorSplitter::handle {
    background-color: #e2e8f0;
    height: 2px;
}

/* Build Log Panel Container */
QWidget#ProcessingBuildLogContainer {
    background: transparent;
    border: none;
}

/* Build Log Header */
QWidget#ProcessingBuildLogHeader {
    background-color: #f1f5f9;
    border: 1px solid #cfd9e4;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 32px;
    max-height: 32px;
}

QLabel#ProcessingBuildLogTitle {
    font-weight: bold;
    color: #475569;
    font-size: 11px;
    background: transparent;
    border: none;
    padding-left: 8px;
}

QToolButton#ProcessingBuildLogClear {
    border: none;
    background: transparent;
    color: #64748b;
    font-weight: 600;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 4px;
    margin-right: 4px;
}

QToolButton#ProcessingBuildLogClear:hover {
    color: #0f172a;
}

QToolButton#ProcessingBuildLogClear:pressed {
    color: #475569;
}

QToolButton#ProcessingBuildLogClose {
    border: none;
    background: transparent;
    color: #64748b;
    padding: 2px;
    border-radius: 4px;
    margin-right: 8px;
}

QToolButton#ProcessingBuildLogClose:hover {
    color: #0f172a;
}

QToolButton#ProcessingBuildLogClose:pressed {
    color: #475569;
}

/* Processing Console Log */
QPlainTextEdit#ProcessingConsoleLog {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cfd9e4;
    border-top: 1px solid #cfd9e4;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    padding: 8px;
    font-family: "JetBrains Mono";
    font-size: 11px;
}

/* Processing ToolBar */
QToolBar#ProcessingToolBar {
    background: transparent;
    border: none;
    spacing: 4px;
    padding: 0px;
}
