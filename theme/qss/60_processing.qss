/* theme/qss/60_processing.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

/* Runtime path lists reuse the base themed tree and row interaction surface. */

/* Libraries use one frame around the list and its compact action strip. */
QFrame#RuntimePathsListPanel {
    background: @HOVER@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 9px;
}
QTreeWidget#RuntimePathsListWidget,
QTreeWidget#RuntimePathEntriesList {
    border: none;
    border-radius: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    background: @SURFACE@;
}
QToolBar#RuntimePathsActionToolBar {
    background: @HOVER@;
    border: none;
    border-top: 1px solid @CONTROLBORDER@;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    spacing: 2px;
    padding: 2px 4px;
}
QToolBar#RuntimePathsActionToolBar QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    min-width: 16px;
    max-width: 16px;
    min-height: 16px;
    max-height: 16px;
    padding: 2px;
    margin: 0;
    qproperty-iconSize: 14px 14px;
}
QToolBar#RuntimePathsActionToolBar QToolButton:hover {
    background: @SURFACE@;
}
QTreeWidget#RuntimePathsListWidget {
    font-weight: 600;
}
QWidget#RuntimePathsFormContainer QLabel#RuntimePathsLabel {
    min-width: 112px;
    max-width: 112px;
    font-weight: 600;
}
QLabel#RuntimePathsHeading {
    font-size: 13px;
    font-weight: 600;
}
QLabel#RuntimePathsHint {
    color: @SECONDARYTEXT@;
    font-size: 11px;
    font-weight: 400;
    padding: 0;
    margin: 0;
}
QLineEdit#RuntimePathsNameEdit {
    font-weight: 600;
}
QLabel#RuntimePathsStatusLabel[state="normal"] {
    color: @SECONDARYTEXT@;
    font-weight: 400;
}
QLabel#RuntimePathsStatusLabel[state="warning"] {
    color: @WARNINGTEXT@;
    font-weight: 600;
}
QLineEdit#RuntimePathsLineEdit {
    min-width: 150px;
}

QPushButton#RuntimePathsBrowseButton {
    min-width: 48px;
    max-width: 48px;
}



/* OpenCV processing panel */
QLabel#ProcessingEditorTitle {
    font-weight: 600;
    color: @TEXT@;
}

QWidget#ProcessingEditorContainer {
    background: transparent;
}

QWidget#ProcessingTabBar {
    background-color: @HOVER@;
    border: 1px solid @CONTROLBORDER@;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 32px;
    max-height: 32px;
}

QToolButton#ProcessingTabAddBtn,
QToolButton#ProcessingTabDeleteBtn,
QToolButton#ProcessingTabLoadBtn,
QToolButton#ProcessingTabSaveBtn {
    width: 20px;
    height: 20px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    border: none;
    background: transparent;
    padding: 1px;
}

QToolButton#ProcessingTabAddBtn:hover,
QToolButton#ProcessingTabDeleteBtn:hover,
QToolButton#ProcessingTabLoadBtn:hover,
QToolButton#ProcessingTabSaveBtn:hover {
    background-color: @PRESSED@;
    border-radius: 4px;
}

QToolButton#ProcessingTabAddBtn:pressed,
QToolButton#ProcessingTabDeleteBtn:pressed,
QToolButton#ProcessingTabLoadBtn:pressed,
QToolButton#ProcessingTabSaveBtn:pressed {
    background-color: @DISABLEDTEXT@;
}

QToolButton#ProcessingTabDeleteBtn:disabled,
QToolButton#ProcessingTabSaveBtn:disabled {
    opacity: 0.4;
}

QComboBox#ProcessingScriptComboBox {
    font-weight: 600;
    font-size: 11px;
    min-width: 120px;
    max-width: 200px;
}

QPlainTextEdit#ProcessingCodeEditor {
    background-color: @SURFACE@;
    color: @TEXT@;
    border: 1px solid @CONTROLBORDER@;
    border-top: 1px solid @CONTROLBORDER@;
    border-bottom: none;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    padding-top: 0px;
    padding-bottom: 0px;
    padding-left: 0px;
    padding-right: 4px;
    font-family: "JetBrains Mono";
}

QLabel#ProcessingParamEditorTitle {
    font-weight: 600;
    color: @TEXT@;
    font-size: 11px;
}

QTextEdit#ProcessingParamEditor {
    background-color: @SURFACE@;
    color: @TEXT@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 8px;
    padding: 0px 8px;
    font-family: "JetBrains Mono";
    font-size: 11px;
}

QLabel#ProcessingParamHintLabel {
    color: @SECONDARYTEXT@;
    font-style: italic;
    padding: 6px;
    font-size: 11px;
}

QLabel#ProcessingParamNameLabel {
    color: @TEXT@;
    font-weight: 400;
}



QCheckBox#ProcessingParamCheckBox {
    padding-left: 3px;
}

/* Code editor line number gutter */
QWidget#CodeEditorLineNumberArea {
    background-color: transparent;
}

/* Build Log Splitter */
QSplitter#ProcessingEditorSplitter::handle {
    background-color: transparent;
    height: 2px;
}

QSplitter#ProcessingEditorSplitter::handle:hover {
    background-color: transparent;
}

/* Compiler Console Panel Container */
QWidget#ProcessingConsoleContainer {
    background: transparent;
    border: none;
}

/* Compiler Console Header */
QWidget#ProcessingConsoleHeader {
    background-color: @HOVER@;
    border: 1px solid @CONTROLBORDER@;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 32px;
    max-height: 32px;
}

QLabel#ProcessingConsoleTitle {
    font-weight: bold;
    color: @TEXT@;
    font-size: 11px;
    background: transparent;
    border: none;
    padding-left: 8px;
}

QToolButton#ProcessingConsoleClear {
    border: none;
    background: transparent;
    color: @SECONDARYTEXT@;
    font-weight: 600;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 4px;
    margin-right: 4px;
}

QToolButton#ProcessingConsoleClear:hover {
    color: @TEXT@;
}

QToolButton#ProcessingConsoleClear:pressed {
    color: @TEXT@;
}

QToolButton#ProcessingConsoleClose {
    border: none;
    background: transparent;
    color: @SECONDARYTEXT@;
    padding: 2px;
    border-radius: 4px;
    margin-right: 8px;
}

QToolButton#ProcessingConsoleClose:hover {
    color: @TEXT@;
}

QToolButton#ProcessingConsoleClose:pressed {
    color: @TEXT@;
}

/* Processing Console Log */
QPlainTextEdit#ProcessingConsoleLog {
    background-color: @SURFACE@;
    color: @TEXT@;
    border: 1px solid @CONTROLBORDER@;
    border-top: 1px solid @CONTROLBORDER@;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    padding: 0px 12px;
    font-family: "JetBrains Mono";
    font-size: 11px;
}

/* Processing ToolBar */
QToolBar#ProcessingToolBar {
    background: transparent;
    border: none;
    spacing: 4px;
    padding: 0px;
}

/* Editor StatusBar */
QFrame#EditorStatusBar {
    background-color: @SURFACE@;
    border: 1px solid @CONTROLBORDER@;
    border-top: 1px solid @CONTROLBORDER@;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    min-height: 22px;
    max-height: 22px;
}

QFrame#EditorStatusBar QLabel {
    color: @TEXT@;
    font-family: "JetBrains Mono", "Inter";
    font-size: 10px;
    font-weight: 500;
    min-height: 0px;
}

/* Save State Styles */
QFrame#EditorStatusBar QLabel#EditorStatusSaveStatus[saveState="modified"] {
    font-weight: 600;
}

/* Clangd State Styles */
QFrame#EditorStatusBar QLabel#EditorStatusClangd[clangdState="ready"] {
    font-weight: 600;
}

QFrame#EditorStatusBar QLabel#EditorStatusClangd[clangdState="error"] {
    font-weight: 600;
}

/* Code Editor Signature Help */
QLabel#SignatureHelpLabel {
    color: @TEXT@;
    background-color: transparent;
    border: 1px solid transparent;
    padding: 1px 3px;
}
