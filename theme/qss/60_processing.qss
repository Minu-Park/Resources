/* theme/qss/60_processing.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

/* Runtime path dialog */
QListWidget#RuntimePathsListWidget,
QListWidget#RuntimePathEntriesList {
    border: 1px solid #cfd9e4;
    border-radius: 8px;
    padding: 4px;
    background-color: #ffffff;
    outline: none;
    qproperty-iconSize: 8px 8px;
}



QListWidget#RuntimePathsListWidget::item,
QListWidget#RuntimePathEntriesList::item {
    padding: 6px 8px;
    border-radius: 4px;
    color: #334155;
    margin-bottom: 2px;
}

QListWidget#RuntimePathsListWidget::item:hover,
QListWidget#RuntimePathEntriesList::item:hover {
    background-color: #f8fafc;
    color: #0f172a;
}

QListWidget#RuntimePathsListWidget::item:selected,
QListWidget#RuntimePathEntriesList::item:selected {
    background-color: #e2e8f0;
    color: #0f172a;
    font-weight: 600;
}

QLabel#RuntimePathsDescription {
    color: #425467;
}

QLabel#RuntimePathEntriesDescription {
    color: #64748b;
}

QLabel#RuntimePathsStatusLabel[state="normal"] {
    color: #64748b;
    font-weight: 400;
}

QLabel#RuntimePathsStatusLabel[state="warning"] {
    color: #b45309;
    font-weight: 600;
}

QLabel#RuntimePathsStatusBadge {
    background: transparent;
    border: none;
    padding: 0;
    font-weight: bold;
    font-size: 11px;
    qproperty-alignment: AlignLeft;
}

QLabel#RuntimePathsStatusBadge[state="ok"] {
    color: #10b981;
}

QLabel#RuntimePathsStatusBadge[state="nok"] {
    color: #ef4444;
}

QLabel#RuntimePathsLabel {
    min-width: 160px;
    max-width: 160px;
}

QLineEdit#RuntimePathsLineEdit {
    min-width: 150px;
}

QPushButton#RuntimePathsBrowseButton {
    min-width: 75px;
    max-width: 75px;
}



/* OpenCV processing panel */
QLabel#ProcessingEditorTitle {
    font-weight: 600;
    color: #000000;
}

QToolButton#ProcessingEnableToggle[active="true"] {
    border-color: #cfd9e4;
    background-color: #f1f3f5;
    color: #000000;
}

QToolButton#ProcessingEnableToggle[active="true"]:hover {
    background-color: #e9ecef;
    border-color: #b7c7d8;
}

QWidget#ProcessingEditorContainer {
    background: transparent;
}

QWidget#ProcessingTabBar {
    background-color: #f1f5f9;
    border: 1px solid #cfd9e4;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 32px;
    max-height: 32px;
}

QToolButton#ProcessingTabAddBtn,
QToolButton#ProcessingTabDeleteBtn,
QToolButton#ProcessingTabLoadBtn,
QToolButton#ProcessingTabSaveBtn {
    width: 20px;
    height: 20px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    border: none;
    background: transparent;
    padding: 1px;
}

QToolButton#ProcessingTabAddBtn:hover,
QToolButton#ProcessingTabDeleteBtn:hover,
QToolButton#ProcessingTabLoadBtn:hover,
QToolButton#ProcessingTabSaveBtn:hover {
    background-color: #cbd5e1;
    border-radius: 4px;
}

QToolButton#ProcessingTabAddBtn:pressed,
QToolButton#ProcessingTabDeleteBtn:pressed,
QToolButton#ProcessingTabLoadBtn:pressed,
QToolButton#ProcessingTabSaveBtn:pressed {
    background-color: #94a3b8;
}

QToolButton#ProcessingTabDeleteBtn:disabled,
QToolButton#ProcessingTabSaveBtn:disabled {
    opacity: 0.4;
}

QComboBox#ProcessingScriptComboBox {
    font-weight: 600;
    font-size: 11px;
    min-width: 120px;
    max-width: 200px;
}

QPlainTextEdit#ProcessingCodeEditor {
    background-color: #ffffff;
    color: #334155;
    border: 1px solid #cfd9e4;
    border-top: 1px solid #cfd9e4;
    border-bottom: none;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 0px;
    padding-right: 4px;
    font-family: "JetBrains Mono";
}

QLabel#ProcessingParamEditorTitle {
    font-weight: 600;
    color: #16202b;
    font-size: 11px;
}

QTextEdit#ProcessingParamEditor {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cfd9e4;
    border-radius: 8px;
    padding: 4px;
    font-family: "JetBrains Mono";
    font-size: 11px;
}

QLabel#ProcessingParamHintLabel {
    color: #64748b;
    font-style: italic;
    padding: 6px;
    font-size: 11px;
}

QLabel#ProcessingParamNameLabel {
    color: #000000;
    font-weight: 400;
}



QCheckBox#ProcessingParamCheckBox {
    padding-left: 3px;
}

/* QCodeEditor Line Number Gutter */
QWidget#ProcessingLineNumberArea {
    background-color: transparent;
}

/* Build Log Splitter */
QSplitter#ProcessingEditorSplitter::handle {
    background-color: transparent;
    height: 2px;
}

QSplitter#ProcessingEditorSplitter::handle:hover {
    background-color: transparent;
}

/* Compiler Console Panel Container */
QWidget#ProcessingConsoleContainer {
    background: transparent;
    border: none;
}

/* Compiler Console Header */
QWidget#ProcessingConsoleHeader {
    background-color: #f1f5f9;
    border: 1px solid #cfd9e4;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 32px;
    max-height: 32px;
}

QLabel#ProcessingConsoleTitle {
    font-weight: bold;
    color: #475569;
    font-size: 11px;
    background: transparent;
    border: none;
    padding-left: 8px;
}

QToolButton#ProcessingConsoleClear {
    border: none;
    background: transparent;
    color: #64748b;
    font-weight: 600;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 4px;
    margin-right: 4px;
}

QToolButton#ProcessingConsoleClear:hover {
    color: #0f172a;
}

QToolButton#ProcessingConsoleClear:pressed {
    color: #475569;
}

QToolButton#ProcessingConsoleClose {
    border: none;
    background: transparent;
    color: #64748b;
    padding: 2px;
    border-radius: 4px;
    margin-right: 8px;
}

QToolButton#ProcessingConsoleClose:hover {
    color: #0f172a;
}

QToolButton#ProcessingConsoleClose:pressed {
    color: #475569;
}

/* Processing Console Log */
QPlainTextEdit#ProcessingConsoleLog {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #cfd9e4;
    border-top: 1px solid #cfd9e4;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    padding: 8px;
    font-family: "JetBrains Mono";
    font-size: 11px;
}

/* Processing ToolBar */
QToolBar#ProcessingToolBar {
    background: transparent;
    border: none;
    spacing: 4px;
    padding: 0px;
}

QToolButton#ProcessingCompileButton {
    background: #ffffff;
    border: 1px solid #d7dee6;
    border-radius: 9px;
    padding: 0 7px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    color: #425467;
}

QToolButton#ProcessingCompileButton:hover {
    background: #eef3f8;
    border-color: #c7d4e2;
    color: #26384a;
}

QToolButton#ProcessingCompileButton:pressed {
    background: #e7eef6;
    border-color: #bccbda;
}

QToolButton#ProcessingCompileButton:disabled {
    background: #ffffff;
    border-color: #e2e8f0;
    color: #94a3b8;
}

/* Editor StatusBar */
QFrame#EditorStatusBar {
    background-color: #ffffff;
    border: 1px solid #cfd9e4;
    border-top: 1px solid #cfd9e4;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    min-height: 22px;
    max-height: 22px;
}

QFrame#EditorStatusBar QLabel {
    color: #475569;
    font-family: "JetBrains Mono", "Inter";
    font-size: 10px;
    font-weight: 500;
    min-height: 0px;
}

/* Save State Styles */
QFrame#EditorStatusBar QLabel#EditorStatusSaveStatus[saveState="modified"] {
    color: #b45309; /* warm orange/amber */
    font-weight: 600;
}

QFrame#EditorStatusBar QLabel#EditorStatusSaveStatus[saveState="saved"] {
    color: #10b981; /* green */
}

/* Clangd State Styles */
QFrame#EditorStatusBar QLabel#EditorStatusClangd[clangdState="ready"] {
    color: #10b981; /* green (connected) */
    font-weight: 600;
}

QFrame#EditorStatusBar QLabel#EditorStatusClangd[clangdState="starting"] {
    color: #3b82f6; /* blue (initial/starting) */
}

QFrame#EditorStatusBar QLabel#EditorStatusClangd[clangdState="error"] {
    color: #ef4444; /* red (error) */
    font-weight: 600;
}

QFrame#EditorStatusBar QLabel#EditorStatusClangd[clangdState="offline"] {
    color: #ef4444; /* red (offline) */
}

/* Code Editor Signature Help */
QLabel#SignatureHelpLabel {
    color: #16202b;
    background-color: transparent;
    border: 1px solid transparent;
    padding: 1px 3px;
}
