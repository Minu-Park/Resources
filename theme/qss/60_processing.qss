/* theme/qss/60_processing.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

/* Runtime path lists reuse the base themed tree and row interaction surface. */

/* Libraries use one frame around the list and its compact action strip. */
QFrame#RuntimePathsListPanel {
    background: @HOVER@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 9px;
}

QTreeWidget#RuntimePathsListWidget,
QTreeWidget#RuntimePathEntriesList {
    border: none;
    border-radius: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    background: @SURFACE@;
}

QToolBar#RuntimePathsActionToolBar {
    background: @HOVER@;
    border: none;
    border-top: 1px solid @CONTROLBORDER@;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    spacing: 2px;
    padding: 2px 4px;
}

/* 20px compact actions: padding absorbs the shared 1px state border. */
QToolBar#RuntimePathsActionToolBar QToolButton {
    background: transparent;
    border-radius: 6px;
    min-width: 16px;
    max-width: 16px;
    min-height: 16px;
    max-height: 16px;
    padding: 1px;
    margin: 0;
    qproperty-iconSize: 14px 14px;
}/* Dialog typography is owned by 40_chrome.qss; retain only layout here. */
QWidget#RuntimePathsFormContainer QLabel#RuntimePathsLabel {
    min-width: 112px;
    max-width: 112px;
}

QLabel#RuntimePathsHint {
    color: @SECONDARYTEXT@;
    padding: 0;
    margin: 0;

    font-size: @FONT_CAPTION@px;
    font-weight: @WEIGHT_NORMAL@;
}

QLabel#RuntimePathsStatusLabel[state="normal"] {
    color: @SECONDARYTEXT@;

    font-weight: @WEIGHT_NORMAL@;
}

QLabel#RuntimePathsStatusLabel[state="warning"] {
    color: @WARNINGTEXT@;

    font-weight: @WEIGHT_EMPHASIS@;
}

QLineEdit#RuntimePathsLineEdit {
    min-width: 150px;
}

QPushButton#RuntimePathsBrowseButton {
    min-width: 48px;
    max-width: 48px;
}/* OpenCV processing panel */
QLabel#ProcessingEditorTitle {
    color: @TEXT@;

    font-weight: @WEIGHT_EMPHASIS@;
}

QWidget#ProcessingEditorContainer {
    background: transparent;
}

QWidget#ProcessingTabBar {
    background-color: @HOVER@;
    border: 1px solid @CONTROLBORDER@;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 32px;
    max-height: 32px;
}

/* 20px compact actions: 18px contents plus the shared 1px state border. */
QToolButton#ProcessingTabAddBtn,
QToolButton#ProcessingTabDeleteBtn,
QToolButton#ProcessingTabLoadBtn,
QToolButton#ProcessingTabSaveBtn {
    width: 18px;
    height: 18px;
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
    background: transparent;
    padding: 0;
    border-radius: 6px;
}

QToolButton#ProcessingTabDeleteBtn:disabled,
QToolButton#ProcessingTabSaveBtn:disabled {
    opacity: 0.4;
}

QComboBox#ProcessingScriptComboBox {
    min-width: 120px;
    max-width: 200px;

    color: @TEXT@;

    font-weight: @WEIGHT_EMPHASIS@;
    font-size: @FONT_CAPTION@px;
}

QPlainTextEdit#ProcessingCodeEditor {
    background-color: @SURFACE@;
    color: @TEXT@;
    border: 1px solid @CONTROLBORDER@;
    border-top: 1px solid @CONTROLBORDER@;
    border-bottom: none;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    padding-top: 0px;
    padding-bottom: 0px;
    padding-left: 0px;
    padding-right: 4px;

    font-family: "@FONT_MONO@";
}

QLabel#ProcessingParamEditorTitle {
    color: @TEXT@;

    font-weight: @WEIGHT_EMPHASIS@;
    font-size: @FONT_CAPTION@px;
}

QTextEdit#ProcessingParamEditor {
    background-color: @SURFACE@;
    color: @TEXT@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 8px;
    padding: 0px 8px;

    font-family: "@FONT_MONO@";
    font-size: @FONT_CAPTION@px;
}

QLabel#ProcessingParamHintLabel {
    color: @SECONDARYTEXT@;
    font-style: italic;
    padding: 6px;

    font-size: @FONT_CAPTION@px;
}

QLabel#ProcessingParamNameLabel {
    color: @TEXT@;

    font-weight: @WEIGHT_NORMAL@;
}

QCheckBox#ProcessingParamCheckBox {
    padding-left: 3px;
}/* Code editor line number gutter */
QWidget#CodeEditorLineNumberArea {
    background-color: transparent;
}/* Build Log Splitter */
QSplitter#ProcessingEditorSplitter::handle {
    background-color: transparent;
    height: 2px;
}

QSplitter#ProcessingEditorSplitter::handle:hover {
    background-color: transparent;
}/* Compiler Console Panel Container */
QWidget#ProcessingConsoleContainer {
    background: transparent;
    border: none;
}/* Compiler Console Header */
QWidget#ProcessingConsoleHeader {
    background-color: @HOVER@;
    border: 1px solid @CONTROLBORDER@;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 32px;
    max-height: 32px;
}

QLabel#ProcessingConsoleTitle {
    color: @TEXT@;
    background: transparent;
    border: none;
    padding-left: 8px;

    font-weight: @WEIGHT_WIDGET_BOLD@;
    font-size: @FONT_CAPTION@px;
}

QToolButton#ProcessingConsoleClear {
    background: transparent;
    color: @SECONDARYTEXT@;
    padding: 2px 8px;
    border-radius: 4px;
    margin-right: 4px;

    font-weight: @WEIGHT_EMPHASIS@;
    font-size: @FONT_CAPTION@px;

    border: none;
    outline: none;
}

QToolButton#ProcessingConsoleClear:hover {
    color: @TEXT@;

    border: none;
    outline: none;
}

QToolButton#ProcessingConsoleClear:pressed {
    color: @TEXT@;

    border: none;
    outline: none;
}

QToolButton#ProcessingConsoleClose {
    background: transparent;
    color: @SECONDARYTEXT@;
    padding: 2px;
    border-radius: 4px;
    margin-right: 8px;

    border: none;
    outline: none;
}

QToolButton#ProcessingConsoleClose:hover {
    color: @TEXT@;

    border: none;
    outline: none;
}

QToolButton#ProcessingConsoleClose:pressed {
    color: @TEXT@;

    border: none;
    outline: none;
}/* Processing Console Log */
QPlainTextEdit#ProcessingConsoleLog {
    background-color: @SURFACE@;
    color: @TEXT@;
    border: 1px solid @CONTROLBORDER@;
    border-top: 1px solid @CONTROLBORDER@;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    padding: 0px 12px;

    font-family: "@FONT_MONO@";
    font-size: @FONT_CAPTION@px;
}/* Processing ToolBar */
QToolBar#ProcessingToolBar {
    background: transparent;
    border: none;
    spacing: 4px;
    padding: 0px;
}/* Editor StatusBar */
QFrame#EditorStatusBar {
    background-color: @SURFACE@;
    border: 1px solid @CONTROLBORDER@;
    border-top: 1px solid @CONTROLBORDER@;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    min-height: 22px;
    max-height: 22px;
}

QFrame#EditorStatusBar QLabel {
    color: @TEXT@;
    min-height: 0px;

    font-family: "@FONT_MONO@", "@FONT_UI@";
    font-size: @FONT_COMPACT@px;
    font-weight: @WEIGHT_WIDGET_MEDIUM@;
}/* Save State Styles */
QFrame#EditorStatusBar QLabel#EditorStatusSaveStatus[saveState="modified"] {

    color: @TEXT@;

    font-weight: @WEIGHT_EMPHASIS@;
}/* Clangd State Styles */
QFrame#EditorStatusBar QLabel#EditorStatusClangd[clangdState="ready"] {

    color: @TEXT@;

    font-weight: @WEIGHT_EMPHASIS@;
}

QFrame#EditorStatusBar QLabel#EditorStatusClangd[clangdState="error"] {

    color: @TEXT@;

    font-weight: @WEIGHT_EMPHASIS@;
}/* Code Editor Signature Help */
QLabel#SignatureHelpLabel {
    color: @TEXT@;
    background-color: transparent;
    border: 1px solid transparent;
    padding: 1px 3px;
}
