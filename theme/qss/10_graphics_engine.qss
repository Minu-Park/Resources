/* theme/qss/10_graphics_engine.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

QToolBar {
    background: #ffffff;
    border: none;
    border-top: 1px solid #d9e1ea;
    border-bottom: 1px solid #d9e1ea;
    spacing: 3px;
    padding: 3px 3px;
}

QToolBar#EngineToolBar {
    background: #ffffff;
    border-top: none;
    border-bottom: 1px solid #d3dde8;
    min-height: 32px;
    padding: 6px;
    spacing: 3px;
}

QToolBar#EngineToolBar QToolButton {
    min-width: 18px;
    min-height: 18px;
    padding: 3px;
}

QToolBar::separator {
    background: #cfdae5;
    width: 1px;
    margin: 2px 6px;
}

QWidget#EngineToolbarBrand {
    background: transparent;
}

QLabel#EngineToolbarLogo {
    padding: 0 6px 0 0;
    margin: 0;
    min-height: 20px;
    background: transparent;
}

QLabel#GraphicsSourceTitle {
    background: rgba(255, 255, 255, 220);
    color: #354657;
    border: 1px solid #d7dee6;
    border-radius: 9px;
    padding: 0 7px;
    min-height: 24px;
    max-height: 24px;
    margin: 6px;
    font-weight: 700;
}

QTabBar#GraphicsSourceTabBar {
    border-top: 1px solid #d9e1ea;
    border-right: none;
    border-bottom: none;
    border-left: none;
    margin-left: 0;
    padding-left: 6px;
}

QTabBar#GraphicsSourceTabBar::tab {
    border-top: 2px solid transparent;
    border-bottom: none;
    padding: 5px 8px;
}

QTabBar#GraphicsSourceTabBar::tab:selected {
    border-top: 2px solid #00457C;
    border-bottom: none;
}

QTabBar#GraphicsSourceTabBar::tab:hover:!selected {
    border-top: 2px solid #cbd5e1;
    border-bottom: none;
}

QScrollBar#ImageViewOverlayScrollBar:horizontal,
QScrollBar#ImageViewOverlayScrollBar:vertical {
    background: transparent;
    border: none;
    margin: 0;
    width: 10px;
    height: 10px;
}

QScrollBar#ImageViewOverlayScrollBar::handle:horizontal,
QScrollBar#ImageViewOverlayScrollBar::handle:vertical {
    background: rgba(110, 110, 110, 150);
    border: none;
    border-radius: 5px;
    min-width: 34px;
    min-height: 34px;
    margin: 1px;
}

QScrollBar#ImageViewOverlayScrollBar::handle:horizontal:hover,
QScrollBar#ImageViewOverlayScrollBar::handle:vertical:hover {
    background: rgba(95, 95, 95, 190);
}

QScrollBar#ImageViewOverlayScrollBar::add-line,
QScrollBar#ImageViewOverlayScrollBar::sub-line,
QScrollBar#ImageViewOverlayScrollBar::add-page,
QScrollBar#ImageViewOverlayScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0px;
    height: 0px;
}

QLabel#PlotLineProfilePointLabel {
    background: transparent;
    color: #354657;
    font-weight: 700;
}

/* Embedded Analysis Panel */
QWidget#AnalysisPanel {
    background: transparent;
    border: none;
}

QTabWidget#AnalysisPanelTabs {
    background: transparent;
    border: none;
}

QTabWidget#AnalysisPanelTabs::pane {
    border: none;
    border-top: 1px solid #d9e1ea;
    background: transparent;
    top: 0px;
    left: -6px;
    right: -6px;
}

QTabWidget#AnalysisPanelTabs::tab-bar {
    alignment: left;
    left: 8px;
}

QTabWidget#AnalysisPanelTabs QTabBar {
    margin-left: 0px;
}

QTabWidget#AnalysisPanelTabs QTabBar::tab {
    min-height: 24px;
    max-height: 24px;
    padding: 0 6px;
    background: transparent;
}

QTabWidget#AnalysisPanelTabs QTabBar::close-button {
    image: url(:/Resources/Icons/icons8-close-window-48.png);
}

QToolButton#PlotResetButton {
    min-height: 20px;
    max-height: 20px;
    padding: 0;
    background: transparent;
    border: none;
}
