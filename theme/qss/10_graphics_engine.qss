/* theme/qss/10_graphics_engine.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

/* Display-mode actions retain exclusive state while their glyphs identify each view. */
QMenu#EngineModeMenu::indicator {
    width: 18px;
    height: 18px;
    image: none;
}

QMenu#EngineModeMenu::item:checked {
    background-color: @HOVER@;
}

QMenu#EngineModeMenu::item:selected {
    background-color: @SELECTION@;
}

QToolBar {
    background: @SURFACE@;
    border: none;
    border-top: 1px solid @BORDER@;
    border-bottom: 1px solid @BORDER@;
    spacing: 3px;
    padding: 3px 3px;
}

QToolBar#EngineToolBar {
    background: @SURFACE@;
    border-top: none;
    border-bottom: 1px solid @BORDER@;
    min-height: 32px;
    padding: 6px;
    spacing: 3px;
}

QToolBar#EngineToolBar QToolButton {
    min-width: 18px;
    min-height: 18px;
    padding: 2px;
}

QToolBar::separator {
    background: @BORDER@;
    width: 1px;
    margin: 2px 6px;
}

QLabel#GraphicsSourceTitle {
    background: rgba(@SURFACE_RGB@, 220);
    color: @TEXT@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 9px;
    padding: 0 7px;
    min-height: @CONTROL_HEIGHT@px;
    max-height: @CONTROL_HEIGHT@px;
    margin: 6px;

    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QTabBar#GraphicsSourceTabBar {
    border-top: 1px solid @BORDER@;
    border-right: none;
    border-bottom: none;
    border-left: none;
    margin-left: 0;
    padding-left: 6px;
}

QTabBar#GraphicsSourceTabBar::tab {
    border-top: none;
    border-bottom: 2px solid transparent;
    padding: 5px 8px;
}

QTabBar#GraphicsSourceTabBar::tab:selected {
    border-top: none;
    border-bottom: 2px solid @SELECTIONACCENT@;
}

QTabBar#GraphicsSourceTabBar::tab:hover:!selected {
    border-top: none;
    border-bottom: 2px solid @HOVERBORDER@;
}

QScrollBar#ImageViewOverlayScrollBar:horizontal,
QScrollBar#ImageViewOverlayScrollBar:vertical {
    background: transparent;
    border: none;
    margin: 0;
    width: 10px;
    height: 10px;
}

QScrollBar#ImageViewOverlayScrollBar::handle:horizontal,
QScrollBar#ImageViewOverlayScrollBar::handle:vertical {
    background: rgba(110, 110, 110, 150);
    border: none;
    border-radius: 5px;
    min-width: 34px;
    min-height: 34px;
    margin: 1px;
}

QScrollBar#ImageViewOverlayScrollBar::handle:horizontal:hover,
QScrollBar#ImageViewOverlayScrollBar::handle:vertical:hover {
    background: rgba(95, 95, 95, 190);
}

QScrollBar#ImageViewOverlayScrollBar::add-line,
QScrollBar#ImageViewOverlayScrollBar::sub-line,
QScrollBar#ImageViewOverlayScrollBar::add-page,
QScrollBar#ImageViewOverlayScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0px;
    height: 0px;
}

QLabel#PlotLineProfilePointLabel {
    background: transparent;
    color: @TEXT@;

    font-weight: @WEIGHT_WIDGET_BOLD@;
}/* Right-side Graphics Settings Panel */
QWidget#GraphicsSettingsPanel {
    background: @SURFACE@;
    border-left: 1px solid @BORDER@;
}

QWidget#GraphicsSettingsPanelHeader {
    background: @SURFACE@;
    border-bottom: 1px solid @BORDER@;
}

QLabel#GraphicsSettingsPanelTitle {
    background: transparent;
    color: @TEXT@;

    font-size: @FONT_COMPACT@px;
    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QToolButton#GraphicsSettingsPanelCloseButton {
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0;
    background: transparent;
    border-radius: 6px;

    border: none;
    outline: none;
}

QToolButton#GraphicsSettingsPanelCloseButton:hover,
QToolButton#GraphicsSettingsPanelCloseButton:pressed {
    background: transparent;

    border: none;
    outline: none;
}

QTabWidget#GraphicsSettingsPanelTabs {
    background: transparent;
    border: none;
}

QTabWidget#GraphicsSettingsPanelTabs::pane {
    padding: 0;
    background: @SURFACE@;
    border: none;
    border-top: 1px solid @BORDER@;
    border-radius: 0;
    top: 0;
}

QTabWidget#GraphicsSettingsPanelTabs > QTabBar {
    background: transparent;
    border-top: none;
    padding-top: 0;
}

QTabWidget#GraphicsSettingsPanelTabs QTabBar {
    margin-left: 0;
}

QTabWidget#GraphicsSettingsPanelTabs QTabBar::tab {
    min-height: 26px;
    max-height: 26px;
    padding: 0 8px;
    background: transparent;
}

QTabWidget#GraphicsSettingsPanelTabs QTabBar QToolButton:hover,
QTabWidget#GraphicsSettingsPanelTabs QTabBar QToolButton:pressed {
    background-color: transparent;

    border: none;
    outline: none;
}

QScrollArea#GraphicsSettingsPageScrollArea {
    background: @SURFACE@;
    border: none;
}

QWidget#GraphicsSettingsPageViewport,
QWidget#GraphicsSettingsGeneralPage,
QWidget#GraphicsSettingsColorPage,
QWidget#GraphicsSettingsDiagnosticsPage,
QWidget#GraphicsSettingsSurfacePage,
QWidget#GraphicsSettingsPointCloudPage,
QWidget#GraphicsSettingsRangePage {
    background: @SURFACE@;
}

QLabel#GraphicsSettingsSectionTitle {
    background: transparent;
    color: @TEXT@;

    font-size: @FONT_CAPTION@px;
    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QLabel#GraphicsSettingsRangeChannelNote {
    color: @SECONDARYTEXT@;
}/* Embedded Analysis Panel */
QWidget#AnalysisPanel {
    background: transparent;
    border: none;
}

QTabWidget#AnalysisPanelTabs {
    background: transparent;
    border: none;
}

QTabWidget#AnalysisPanelTabs::pane {
    padding: 0;
    border: none;
    border-top: 1px solid @BORDER@;
    background: transparent;
    top: 0px;
    left: -6px;
    right: -6px;
}

QTabWidget#AnalysisPanelTabs::tab-bar {
    alignment: left;
}

QTabWidget#AnalysisPanelTabs QTabBar {
    margin-left: 0px;
}

QTabWidget#AnalysisPanelTabs QTabBar::tab {
    min-height: 26px;
    max-height: 26px;
    padding: 0 6px;
    background: transparent;
}

QToolButton#AnalysisTabCloseButton {
    min-width: 16px;
    max-width: 16px;
    min-height: 16px;
    max-height: 16px;
    padding: 0;
    background: transparent;
    qproperty-text: "";

    border: none;
    outline: none;
}

/* 20px compact actions: 18px contents plus the shared 1px state border. */
QToolButton#PlotViewActionButton,
QToolButton[plotActionRole="action"] {
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
    padding: 0;
    border-radius: 6px;
}

QFrame#PlotViewReadout {
    background: rgba(@SURFACE_RGB@, 232);
    border: 1px solid rgba(@BORDER_RGB@, 220);
    border-radius: 9px;
    padding: 8px 12px;
}

QLabel#PlotViewReadoutText {
    background: transparent;
    color: @TEXT@;
}

QFrame#PlotViewYRangePopup,
QFrame#PlotViewHistogramBinPopup {
    background: transparent;
    border: none;
}

QFrame#PlotViewYRangePopup QLabel,
QFrame#PlotViewHistogramBinPopup QLabel {
    background: transparent;
    color: @TEXT@;
}

QFrame#PlotViewYRangePopup QLabel#PlotViewYRangePopupTitle,
QFrame#PlotViewHistogramBinPopup QLabel#PlotViewHistogramBinPopupTitle {
    min-height: 20px;
    background: transparent;
    color: @TEXT@;
    font-weight: @WEIGHT_WIDGET_BOLD@;
}/* Plot UI roles; series and inspection colors encode data identity. */
PlotViewWidget {
    qproperty-plotSurfaceColor: @SURFACE@;
    qproperty-plotBorderColor: @BORDER@;
    qproperty-plotSecondaryTextColor: @SECONDARYTEXT@;
    qproperty-plotWarningColor: @WARNINGTEXT@;
    color: @TEXT@;
    font-size: @FONT_BODY@px;
    font-weight: @WEIGHT_NORMAL@;
}

QTableWidget#AnalysisStatisticsTable,
QTableWidget#AnalysisStatisticsTable QHeaderView::section {
    color: @TEXT@;
}

QFrame#PlotViewHistogramBinPopup QLabel#PlotViewHistogramBinSummaryLabel {
    color: @SECONDARYTEXT@;
}

QTabBar#GraphicsSourceTabBar::tab:selected,
QTabWidget#AnalysisPanelTabs QTabBar::tab:selected,
QTabWidget#GraphicsSettingsPanelTabs QTabBar::tab:selected {
    background: transparent;
}
