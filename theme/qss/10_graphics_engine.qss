/* theme/qss/10_graphics_engine.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

QToolBar {
    background: #ffffff;
    border: none;
    border-top: 1px solid #d9e1ea;
    border-bottom: 1px solid #d9e1ea;
    spacing: 3px;
    padding: 3px 3px;
}

QToolBar#EngineToolBar {
    background: #ffffff;
    border-top: none;
    border-bottom: 1px solid #d3dde8;
    min-height: 32px;
    padding: 6px;
    spacing: 3px;
}

QToolBar#EngineToolBar QToolButton {
    min-width: 18px;
    min-height: 18px;
    padding: 3px;
}

QToolBar::separator {
    background: #cfdae5;
    width: 1px;
    margin: 2px 6px;
}

QLabel#GraphicsSourceTitle {
    background: rgba(255, 255, 255, 220);
    color: #354657;
    border: 1px solid #d7dee6;
    border-radius: 9px;
    padding: 0 7px;
    min-height: 24px;
    max-height: 24px;
    margin: 6px;
    font-weight: 700;
}

QTabBar#GraphicsSourceTabBar {
    border-top: 1px solid #d9e1ea;
    border-right: none;
    border-bottom: none;
    border-left: none;
    margin-left: 0;
    padding-left: 6px;
}

QTabBar#GraphicsSourceTabBar::tab {
    border-top: 2px solid transparent;
    border-bottom: none;
    padding: 5px 8px;
}

QTabBar#GraphicsSourceTabBar::tab:selected {
    border-top: 2px solid #00457C;
    border-bottom: none;
}

QTabBar#GraphicsSourceTabBar::tab:hover:!selected {
    border-top: 2px solid #cbd5e1;
    border-bottom: none;
}

QScrollBar#ImageViewOverlayScrollBar:horizontal,
QScrollBar#ImageViewOverlayScrollBar:vertical {
    background: transparent;
    border: none;
    margin: 0;
    width: 10px;
    height: 10px;
}

QScrollBar#ImageViewOverlayScrollBar::handle:horizontal,
QScrollBar#ImageViewOverlayScrollBar::handle:vertical {
    background: rgba(110, 110, 110, 150);
    border: none;
    border-radius: 5px;
    min-width: 34px;
    min-height: 34px;
    margin: 1px;
}

QScrollBar#ImageViewOverlayScrollBar::handle:horizontal:hover,
QScrollBar#ImageViewOverlayScrollBar::handle:vertical:hover {
    background: rgba(95, 95, 95, 190);
}

QScrollBar#ImageViewOverlayScrollBar::add-line,
QScrollBar#ImageViewOverlayScrollBar::sub-line,
QScrollBar#ImageViewOverlayScrollBar::add-page,
QScrollBar#ImageViewOverlayScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0px;
    height: 0px;
}

QLabel#PlotLineProfilePointLabel {
    background: transparent;
    color: #354657;
    font-weight: 700;
}

/* Right-side Graphics Settings Panel */
QWidget#GraphicsSettingsPanel {
    background: #ffffff;
    border-left: 1px solid #d9e1ea;
}

QWidget#GraphicsSettingsPanelHeader {
    background: #ffffff;
    border-bottom: 1px solid #d9e1ea;
}

QLabel#GraphicsSettingsPanelTitle {
    background: transparent;
    color: #16202b;
    font-size: 10px;
    font-weight: 700;
}

QToolButton#GraphicsSettingsPanelCloseButton {
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 6px;
}

QToolButton#GraphicsSettingsPanelCloseButton:hover,
QToolButton#GraphicsSettingsPanelCloseButton:pressed {
    background: transparent;
}

QTabWidget#GraphicsSettingsPanelTabs {
    background: transparent;
    border: none;
}

QTabWidget#GraphicsSettingsPanelTabs::pane {
    background: #ffffff;
    border: none;
    border-top: 1px solid #d9e1ea;
    border-radius: 0;
    top: 0;
}

QTabWidget#GraphicsSettingsPanelTabs > QTabBar {
    background: transparent;
    border-top: none;
    padding-top: 0;
}

QTabWidget#GraphicsSettingsPanelTabs QTabBar {
    margin-left: 0;
}

QTabWidget#GraphicsSettingsPanelTabs QTabBar::tab {
    min-height: 26px;
    max-height: 26px;
    padding: 0 8px;
    background: transparent;
}

QTabWidget#GraphicsSettingsPanelTabs QTabBar QToolButton:hover,
QTabWidget#GraphicsSettingsPanelTabs QTabBar QToolButton:pressed {
    background-color: transparent;
    border: 1px solid transparent;
}

QScrollArea#GraphicsSettingsPageScrollArea {
    background: #ffffff;
    border: none;
}

QWidget#GraphicsSettingsPageViewport,
QWidget#GraphicsSettingsDisplayPage,
QWidget#GraphicsSettingsSurfacePage,
QWidget#GraphicsSettingsPointCloudPage,
QWidget#GraphicsSettingsRangePage {
    background: #ffffff;
}

QLabel#GraphicsSettingsSectionTitle {
    background: transparent;
    color: #475569;
    font-size: 11px;
    font-weight: 700;
}

QLabel#GraphicsSettingsRangeChannelNote {
    color: #64748b;
}

/* Embedded Analysis Panel */
QWidget#AnalysisPanel {
    background: transparent;
    border: none;
}

QTabWidget#AnalysisPanelTabs {
    background: transparent;
    border: none;
}

QTabWidget#AnalysisPanelTabs::pane {
    border: none;
    border-top: 1px solid #d9e1ea;
    background: transparent;
    top: 0px;
    left: -6px;
    right: -6px;
}

QTabWidget#AnalysisPanelTabs::tab-bar {
    alignment: left;
}

QTabWidget#AnalysisPanelTabs QTabBar {
    margin-left: 0px;
}

QTabWidget#AnalysisPanelTabs QTabBar::tab {
    min-height: 26px;
    max-height: 26px;
    padding: 0 6px;
    background: transparent;
}

QToolButton#AnalysisTabCloseButton {
    min-width: 16px;
    max-width: 16px;
    min-height: 16px;
    max-height: 16px;
    padding: 0;
    background: transparent;
    border: none;
    qproperty-text: "";
}

QToolButton#PlotViewActionButton {
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0;
    background: transparent;
    border: none;
}

QToolButton[plotActionRole="action"] {
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0;
    background: transparent;
    border: none;
}

QToolButton[plotActionRole="action"]:checked {
    background: #e8f0f8;
    border: 1px solid #bfd1e2;
    border-radius: 6px;
}

QToolButton#PlotViewActionButton:hover,
QToolButton[plotActionRole="action"]:hover {
    background: #f4f8fc;
    border: 1px solid #d5e1ed;
    border-radius: 6px;
}

QToolButton#PlotViewActionButton:checked:hover,
QToolButton[plotActionRole="action"]:checked:hover {
    background: #e1edf7;
    border: 1px solid #a6c3dc;
    border-radius: 6px;
}

QToolButton[plotActionRole="action"]:disabled {
    background: transparent;
    border: none;
}

QFrame#PlotViewYRangePopup {
    background: transparent;
    border: none;
}

QFrame#PlotViewYRangePopup QLabel {
    background: transparent;
    color: #24364a;
}

QLabel#PlotViewYRangePopupTitle {
    min-height: 20px;
    background: transparent;
    color: #24364a;
    font-weight: 700;
}
