/* theme/qss/10_graphics_engine.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

QToolBar {
    background: #ffffff;
    border: none;
    border-top: 1px solid #d9e1ea;
    border-bottom: 1px solid #d9e1ea;
    spacing: 3px;
    padding: 3px 3px;
}

QToolBar#EngineToolBar {
    background: #ffffff;
    border-top: none;
    border-bottom: 1px solid #d3dde8;
    padding: 3px 3px;
    spacing: 3px;
}

QToolBar#EngineToolBar QToolButton {
    min-height: 28px;
    padding: 4px 10px;
}

QToolBar::separator {
    background: #cfdae5;
    width: 1px;
    margin: 2px 6px;
}

QWidget#EngineToolbarBrand {
    background: transparent;
}

QLabel#EngineToolbarLogo {
    padding: 0 6px 0 0;
    margin: 0;
    min-height: 20px;
    background: transparent;
}

QScrollBar#ImageViewOverlayScrollBar:horizontal,
QScrollBar#ImageViewOverlayScrollBar:vertical {
    background: transparent;
    border: none;
    margin: 0;
    width: 10px;
    height: 10px;
}

QScrollBar#ImageViewOverlayScrollBar::handle:horizontal,
QScrollBar#ImageViewOverlayScrollBar::handle:vertical {
    background: rgba(110, 110, 110, 150);
    border: none;
    border-radius: 5px;
    min-width: 34px;
    min-height: 34px;
    margin: 1px;
}

QScrollBar#ImageViewOverlayScrollBar::handle:horizontal:hover,
QScrollBar#ImageViewOverlayScrollBar::handle:vertical:hover {
    background: rgba(95, 95, 95, 190);
}

QScrollBar#ImageViewOverlayScrollBar::add-line,
QScrollBar#ImageViewOverlayScrollBar::sub-line,
QScrollBar#ImageViewOverlayScrollBar::add-page,
QScrollBar#ImageViewOverlayScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0px;
    height: 0px;
}

QSpinBox#PlotLineProfileCoordinateSpinBox {
    background: #ffffff;
    border: 1px solid #cfd9e4;
    border-radius: 6px;
    padding: 1px 5px;
    color: #16202b;
}

QSpinBox#PlotLineProfileCoordinateSpinBox:focus {
    border-color: #7da7d9;
}

QLabel#PlotLineProfilePointLabel {
    background: transparent;
    color: #354657;
    font-weight: 700;
}

/* Analysis Dialog & Titlebar Styles */
#AnalysisDialog {
    background: transparent;
}

#AnalysisDialogTitleBar {
    background: transparent;
}

QLabel#AnalysisDialogTitleLabel {
    color: #16202b;
    font-weight: bold;
    font-size: 11px;
}

QPushButton#AnalysisDialogCloseButton {
    border: none;
    background: transparent;
    border-radius: 6px;
    width: 20px;
    height: 20px;
    padding: 0;
    margin: 0;
}

QPushButton#AnalysisDialogCloseButton:hover {
    background: transparent;
}

StatisticsTableWidget QTableWidget {
    background-color: #ffffff;
    border: none;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
}

StatisticsTableWidget QTableWidget QHeaderView::section {
    background-color: #f8fafc;
    border: none;
    border-bottom: 1px solid #eef2f6;
}
