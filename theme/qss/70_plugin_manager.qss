/* Compact plugin list, details, and semantic action states. */
QWidget#PluginMarketplaceContent * {
    font-size: 11px;
}
QWidget#PluginMarketplaceContent QLabel {
    min-height: 0;
}
QWidget#PluginMarketplaceContent QPushButton,
QWidget#PluginMarketplaceContent QComboBox {
    min-height: 18px;
    max-height: 18px;
}
QWidget#PluginMarketplaceContent QPushButton {
    border-radius: 6px;
    padding-left: 8px;
    padding-right: 8px;
    qproperty-iconSize: 12px 12px;
}
QTreeWidget[treeRole="PluginMarketplaceList"] {
    border: 1px solid #dbe3ec;
    border-radius: 8px;
    background: #ffffff;
    padding: 4px;
}
QTreeWidget[treeRole="PluginMarketplaceList"][interactionMode="row"]::item {
    margin: 2px 0;
    padding: 0;
}
QWidget#PluginMarketplaceCard,
QLabel#PluginMarketplaceCardIcon,
QLabel#PluginMarketplaceCardName,
QLabel#PluginMarketplaceCardStatus,
QLabel#PluginMarketplaceUpdateIcon {
    background: transparent;
    border: none;
    padding: 0;
}
QWidget#PluginMarketplaceContent QLabel#PluginMarketplaceCardIcon {
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
}
QLabel#PluginMarketplaceCardName {
    color: #16202b;
    font-size: 12px;
    font-weight: 600;
}
QLabel#PluginMarketplaceCardStatus {
    color: #516476;
    font-size: 10px;
}
QLabel#PluginMarketplaceCardStatus[installationState="update"] {
    color: #596574;
    font-weight: 500;
}
QLabel#PluginMarketplaceUpdateIcon {
    min-width: 12px;
    max-width: 12px;
    min-height: 12px;
    max-height: 12px;
    color: #596574;
}
QFrame#PluginMarketplaceDetailShell {
    border: 1px solid #dbe3ec;
    border-radius: 8px;
    background: #ffffff;
}
QScrollArea#PluginMarketplaceDetailsScroll,
QScrollArea#PluginMarketplaceDetailsScroll > QWidget > QWidget,
QFrame#PluginMarketplaceDetails {
    background: transparent;
    border: none;
}
QWidget#PluginMarketplaceContent QLabel#PluginMarketplaceDetailIcon {
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    background: transparent;
}
QLabel#PluginMarketplaceDetailName {
    color: #16202b;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
}
QLabel#PluginMarketplaceDetailId {
    color: #8593a1;
    font-size: 10px;
    background: transparent;
}
QLabel#PluginMarketplacePackageStatus {
    color: #416f9a;
    font-weight: 600;
    background: transparent;
}
QLabel#PluginMarketplaceDescription {
    color: #354657;
    background: transparent;
}
QLabel#PluginMarketplaceSectionLabel {
    color: #16202b;
    font-weight: 600;
    background: transparent;
}
QLabel#PluginMarketplaceSummary,
QLabel#PluginMarketplaceCompatibility,
QLabel#PluginMarketplaceHistoryStatus,
QLabel#PluginMarketplaceActivationNote,
QLabel#PluginMarketplaceEmpty,
QLabel#PluginMarketplaceResult,
QLabel#PluginMarketplaceOperationStatus {
    color: #6b7c8d;
    background: transparent;
}
QLabel#PluginMarketplaceSummary,
QLabel#PluginMarketplaceHistoryStatus,
QLabel#PluginMarketplaceActivationNote {
    font-size: 10px;
}
QLabel#PluginMarketplaceResult[messageState="error"],
QLabel#PluginMarketplaceCompatibility[messageState="error"] {
    color: #b44747;
}
QWidget#PluginMarketplaceContent QPushButton[commandRole="primary"] {
    background: #ffffff;
    color: #24303c;
    border-color: #bcc6d0;
    font-weight: 600;
}
QWidget#PluginMarketplaceContent QPushButton[commandRole="primary"]:hover {
    background: #f3f5f7;
    border-color: #a6b2be;
}
QWidget#PluginMarketplaceContent QPushButton[commandRole="primary"]:pressed {
    background: #e8edf2;
    border-color: #97a4b2;
}
QWidget#PluginMarketplaceContent QPushButton#PluginMarketplaceRemove {
    color: #65707c;
    border-color: #d8dee5;
    font-weight: 500;
}
QWidget#PluginMarketplaceContent QPushButton#PluginMarketplaceRemove:hover {
    background: #f3f5f7;
    color: #424c58;
    border-color: #bcc6d0;
}
QWidget#PluginMarketplaceContent QPushButton#PluginMarketplaceRemove:pressed {
    background: #e8edf2;
    color: #24303c;
    border-color: #a6b2be;
}
QWidget#PluginMarketplaceContent QPushButton[commandRole="primary"]:focus,
QWidget#PluginMarketplaceContent QPushButton#PluginMarketplaceRemove:focus {
    border-color: #7890a6;
}
QWidget#PluginMarketplaceContent QPushButton[commandRole="primary"]:disabled,
QWidget#PluginMarketplaceContent QPushButton#PluginMarketplaceRemove:disabled {
    background: #f7f8f9;
    border-color: #dee3e9;
    color: #97a0aa;
}
QSplitter#PluginMarketplaceSplitter::handle {
    background: transparent;
    width: 6px;
}
QProgressBar#PluginMarketplaceProgress {
    min-height: 6px;
    max-height: 6px;
    border: none;
    border-radius: 3px;
    background: #e2eaf2;
}
QProgressBar#PluginMarketplaceProgress::chunk {
    border-radius: 3px;
    background: #2f80c9;
}

/* Host update discovery notification. */
QFrame#UpdateNotificationPopup {
    min-width: 250px;
    max-width: 360px;
    padding: 8px 10px;
    background-color: #ffffff;
    border: 1px solid #cfd9e4;
    border-radius: 12px;
}

QFrame#UpdateNotificationPopup:hover {
    background-color: #f8fafc;
    border-color: #b7c7d8;
}

QLabel#UpdateNotificationTitle {
    min-height: 0;
    padding: 0;
    background-color: transparent;
    border: none;
    color: #16202b;
    font-weight: 700;
}

QLabel#UpdateNotificationMessage {
    min-height: 0;
    padding: 0;
    background-color: transparent;
    border: none;
    color: #516476;
}

QToolButton#UpdateNotificationCloseButton {
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0;
    border: none;
    background: transparent;
    color: #7f8b97;
    font-size: 17px;
    font-weight: 600;
}

QToolButton#UpdateNotificationCloseButton:hover,
QToolButton#UpdateNotificationCloseButton:pressed {
    background: transparent;
    color: #16202b;
}
