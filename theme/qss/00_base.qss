/* theme/qss/00_base.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

* {
    color: #16202b;
    font-family: "Inter";
    font-size: 12px;
    outline: none;
}

QDialog,
QDockWidget,
QMainWindow,
QFrame {
    background: #ffffff;
}

QToolTip {
    color: #16202b;
    background-color: transparent;
    border: 1px solid transparent;
    padding: 3px 6px;
}

QMainWindow {
    background-color: #ffffff;
    color: #16202b;
}

QMainWindow#DeviceSessionWindow {
    background: transparent;
}

QDialog {
    background: #ffffff;
    color: #16202b;
}

QMainWindow::separator {
    width: 2px;
    height: 2px;
    background: #d9e1ea;
    margin: 0;
}

QMainWindow::separator:hover {
    background: #b8c3cf;
}

MainWindow::separator:horizontal,
ThemedMainWindow::separator:horizontal {
    height: 2px;
    background-color: #d9e1ea;
    border: none;
}

QDockWidget {
    color: #16202b;
    background: #ffffff;
    border: none;
}


QTabWidget,
QGroupBox,
QTableWidget,
QTreeWidget,
QMenu,
QLineEdit,
QComboBox,
QAbstractSpinBox,
QPlainTextEdit,
QTextEdit,
QTextBrowser {
    background: #ffffff;
    color: #16202b;
}

QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #d9e1ea;
    border-radius: 10px;
    top: -2px;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d9e1ea;
    border-radius: 8px;
    margin-top: 22px;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 2px;
    top: 0px;
    padding: 0px;
    background: transparent;
    color: #475569;
    font-size: 11px;
    font-weight: 700;
}

QGroupBox QLabel,
QGroupBox QLineEdit,
QGroupBox QComboBox,
QGroupBox QAbstractSpinBox,
QGroupBox QCheckBox,
QGroupBox QRadioButton {
    font-weight: 400;
}

QTabBar {
    background: #ffffff;
    qproperty-drawBase: 0;
    border: none;
    padding: 0px;
    margin-left: 6px;
}

QTabBar::tab {
    background: transparent;
    color: #516476;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 8px;
    margin-right: 0px;
    border-radius: 0px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background: transparent;
    color: #00457C;
    border-bottom: 2px solid #00457C;
    font-weight: 700;
}

QTabBar::tab:hover:!selected {
    color: #00457C;
    border-bottom: 2px solid #cbd5e1;
}

QTabBar::tear {
    width: 0px;
    border: none;
    background: transparent;
    image: none;
}

QTabBar::scroller {
    width: 52px;
    margin-right: 6px;
}

QTabBar QToolButton {
    border: 1px solid transparent;
    background-color: #ffffff;
    width: 20px;
    height: 24px;
    margin: 0px 0px;
}

QTabBar QToolButton#ScrollLeftButton {
    margin-left: 8px;
}

QTabBar QToolButton:hover {
    background-color: #cbd5e1;
    border-radius: 4px;
}

QTabBar QToolButton:pressed {
    background-color: #94a3b8;
}

QTabBar QToolButton:disabled {
    background-color: #ffffff;
}

QTabBar QToolButton::left-arrow {
    image: url(:/Resources/Icons/icons8-back-48.png);
    width: 10px;
    height: 10px;
}

QTabBar QToolButton::left-arrow:disabled {
    image: url(:/Resources/Icons/icons8-back-48-disabled.png);
}

QTabBar QToolButton::right-arrow {
    image: url(:/Resources/Icons/icons8-forward-48.png);
    width: 10px;
    height: 10px;
}

QTabBar QToolButton::right-arrow:disabled {
    image: url(:/Resources/Icons/icons8-forward-48-disabled.png);
}

QTableView,
QTreeView,
QTableWidget,
QTreeWidget {
    border: 1px solid #d9e1ea;
    border-radius: 10px;
    padding: 3px;
    gridline-color: #edf2f7;
    alternate-background-color: #fafafa;
    selection-background-color: #efefef;
    selection-color: #16202b;
    background-color: #ffffff;
}

QTableView::viewport,
QTreeView::viewport,
QTableWidget::viewport,
QTreeWidget::viewport {
    background: transparent;
}

QTreeView,
QTreeWidget {
    padding-bottom: 0;
}

QHeaderView,
QFrame#DeviceFeatureSearchBubble {
    background: #ffffff;
    border: 1px solid #d6e0ea;
    border-radius: 9px;
}

QLabel[textRole="sectionTitle"] {
    font-weight: 700;
}

QLabel[textRole="description"] {
    color: #425467;
}

QLabel[textRole="caption"] {
    color: #64748b;
}

QHeaderView::section {
    background: transparent;
    color: #000000;
    border: none;
    border-right: 1px solid #edf2f7;
    min-height: 22px;
    padding: 0 6px;
    font-size: 12px;
    font-weight: 700;
}

QHeaderView::section:first {
    border-top-left-radius: 9px;
    border-bottom-left-radius: 9px;
}

QHeaderView::section:last {
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
    border-right: none;
}

QHeaderView[fileDialogRole="itemHeader"] {
    color: #000000;
    font-size: 12px;
    font-weight: 700;
}

QTableCornerButton::section {
    background: transparent;
    border: none;
}

/* Shared item surfaces are joined in visual coordinates by the installed delegate. */
QTreeView, QListView, QTableView {
    selection-background-color: #edf5fb;
    selection-color: #16202b;
    show-decoration-selected: 0;
}
QTreeView::item, QListView::item, QTableView::item {
    min-height: 22px;
    padding: 1px 2px;
    margin: 0;
    border: none;
    border-radius: 0;
    background: transparent;
}
QTreeView::item:hover, QListView::item:hover, QTableView::item:hover,
QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background: transparent;
    color: #16202b;
}
QWidget#ResourcesItemSelectionSurface {
    qproperty-radius: 9;
    qproperty-hoverColor: #f4f8fb;
    qproperty-focusColor: #8badc7;
}
QTableView QLabel { background: transparent; }

QTreeView::branch:has-children:closed,
QTreeWidget::branch:has-children:closed {
    image: url(:/Resources/Icons/icons8-tree-forward-48.png);
    width: 16px;
    height: 16px;
}

QTreeView::branch:has-children:open,
QTreeWidget::branch:has-children:open {
    image: url(:/Resources/Icons/icons8-tree-expand-arrow-48.png);
    width: 16px;
    height: 16px;
}

QTreeView::branch:hover,
QTreeView::branch:selected,
QTreeView::branch:open:hover,
QTreeView::branch:closed:hover,
QTreeWidget::branch:hover,
QTreeWidget::branch:selected,
QTreeWidget::branch:open:hover,
QTreeWidget::branch:closed:hover {
    background: transparent;
}


QComboBox,
QAbstractSpinBox,
QLineEdit,
QPlainTextEdit,
QTextEdit,
QTextBrowser {
    border: 1px solid #cfd9e4;
    border-radius: 8px;
    padding: 5px 4px;
    selection-background-color: #efefef;
    selection-color: #16202b;
}

QPlainTextEdit,
QTextEdit,
QTextBrowser {
    font-family: "JetBrains Mono";
}

QTextBrowser[contentRole="document"] {
    font-family: "Inter";
}

QComboBox,
QAbstractSpinBox,
QLineEdit {
    min-height: 22px;
    max-height: 22px;
    padding-top: 0;
    padding-bottom: 0;
}

QComboBox:hover,
QAbstractSpinBox:hover,
QLineEdit:hover,
QPlainTextEdit:hover,
QTextEdit:hover,
QTextBrowser:hover {
    border-color: #b7c7d8;
}

QComboBox:focus,
QAbstractSpinBox:focus,
QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QTextBrowser:focus,
QComboBox:on {
    border: 1px solid #8badc7;
}

QComboBox[popupDirection="below"] {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom: 1px solid #ffffff;
}
QComboBox[popupDirection="above"] {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-top: 1px solid #ffffff;
}


QComboBox:disabled,
QAbstractSpinBox:disabled,
QLineEdit:disabled {
    color: #8ea0b0;
    background: #f7f7f7;
    border-color: #e2e8ef;
}

QComboBox {
    padding-right: 4px;
    combobox-popup: 0;
    combobox-list-mousetracking: 1;
}

QComboBox:editable {
    padding-left: 2px;
    padding-right: 2px;
}

/* The combo owns the frame and content inset; its editor must not add a second one. */
QComboBox QLineEdit,
QComboBox QLineEdit:focus,
QComboBox QLineEdit:hover {
    border: none;
    border-radius: 0;
    padding: 0;
    min-height: 0;
    background: transparent;
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 10px;
    right: 4px;
    border-left: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(:/Resources/Icons/icons8-expand-arrow-12.png);
    width: 10px;
    height: 6px;
}

QComboBox QAbstractItemView {
    border: none;
    selection-background-color: transparent;
    selection-color: #16202b;
    background: transparent;
    padding: 2px;
    margin: 0;
    outline: 0px;
}

QComboBox QAbstractItemView::item {
    min-height: 18px;
    padding: 3px 20px;
    margin: 0px;
    border-radius: 4px;
    color: #16202b;
    background-color: transparent;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    background-color: transparent;
    background-image: url(:/Resources/Icons/combo-hover-dot.png);
    background-position: left center;
    background-repeat: no-repeat;
    color: #16202b;
}

QAbstractSpinBox {
    padding-right: 4px;
    border: 1px solid #cfd9e4;
    border-radius: 8px;
    background: #ffffff;
}


QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    subcontrol-origin: padding;
    width: 16px;
    background: transparent;
    border-left: 1px solid #cfd9e4;
    margin: 0;
    padding: 0;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 8px;
    border-bottom: 1px solid #cfd9e4;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 8px;
}

QAbstractSpinBox::up-arrow {
    image: url(:/Resources/Icons/icons8-collapse-arrow-12.png);
    width: 10px;
    height: 6px;
}

QAbstractSpinBox::down-arrow {
    image: url(:/Resources/Icons/icons8-expand-arrow-12.png);
    width: 10px;
    height: 6px;
}

QPushButton {
    min-height: 22px;
    max-height: 22px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 8px;
    border: 1px solid #cfd9e4;
    background: #ffffff;
    color: #16202b;
    font-weight: 700;
}

QPushButton:hover {
    background: #f5f5f5;
    border-color: #b7c7d8;
    color: #16202b;
}

QPushButton:pressed {
    background: #ededed;
    color: #16202b;
}

QPushButton:disabled {
    background: #f7f7f7;
    border-color: #d6dee7;
    color: #97a6b4;
}

QToolButton {
    min-height: 24px;
    padding: 3px 8px;
    margin: 0;
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    color: #2a3a4b;
    font-weight: 600;
}

QToolButton:hover {
    background: #f3f3f3;
    border-color: #d4e2ef;
    color: #16202b;
}

QToolButton:pressed {
    background: #e8e8e8;
    border-color: #c8d9ea;
}

QToolButton:checked {
    background: #f0f0f0;
    border-color: #cfcfcf;
    color: #16202b;
}

QToolButton:disabled {
    color: #95a3b1;
    background: transparent;
}

QCheckBox,
QRadioButton {
    color: #243546;
    background: transparent;
    padding: 0;
    border: none;
    min-height: 22px;
    max-height: 22px;
}

QCheckBox:hover,
QRadioButton:hover {
    background: transparent;
}

QRadioButton { spacing: 8px; }
QRadioButton::indicator, QRadioButton::indicator:hover {
    width: 22px;
    height: 22px;
    border: none;
    padding: 0;
    background: transparent;
    image: url(:/Resources/Icons/widget-radio-off.svg);
}
QRadioButton::indicator:checked { image: url(:/Resources/Icons/widget-radio-on.svg); }
QRadioButton::indicator:disabled { image: url(:/Resources/Icons/widget-radio-off-disabled.svg); }
QRadioButton::indicator:checked:disabled { image: url(:/Resources/Icons/widget-radio-on-disabled.svg); }
QRadioButton:disabled { color: #95a3b1; }

/* Default checkbox presentation; native check-state and input behavior remain intact. */
QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator,
QCheckBox::indicator:hover,
QAbstractItemView::indicator,
QAbstractItemView::indicator:hover,
QGroupBox::indicator,
QGroupBox::indicator:hover {
    width: 32px;
    height: 18px;
    padding: 1px;
    border: 1px solid transparent;
    border-radius: 11px;
    background: transparent;
    image: url(:/Resources/Icons/switch-off.svg);
}

QCheckBox::indicator:checked,
QCheckBox::indicator:checked:hover,
QAbstractItemView::indicator:checked,
QAbstractItemView::indicator:checked:hover,
QGroupBox::indicator:checked,
QGroupBox::indicator:checked:hover {
    image: url(:/Resources/Icons/switch-on.svg);
}

QCheckBox::indicator:indeterminate,
QCheckBox::indicator:indeterminate:hover,
QAbstractItemView::indicator:indeterminate,
QAbstractItemView::indicator:indeterminate:hover,
QGroupBox::indicator:indeterminate,
QGroupBox::indicator:indeterminate:hover {
    image: url(:/Resources/Icons/switch-mixed.svg);
}

QCheckBox::indicator:focus,
QAbstractItemView::indicator:focus,
QGroupBox::indicator:focus {
    border-color: #8badc7;
}

QCheckBox:disabled {
    color: #95a3b1;
}

QCheckBox::indicator:disabled,
QCheckBox::indicator:disabled:hover,
QAbstractItemView::indicator:disabled,
QAbstractItemView::indicator:disabled:hover,
QGroupBox::indicator:disabled,
QGroupBox::indicator:disabled:hover {
    image: url(:/Resources/Icons/switch-off-disabled.svg);
}

QCheckBox::indicator:checked:disabled,
QCheckBox::indicator:checked:disabled:hover,
QAbstractItemView::indicator:checked:disabled,
QAbstractItemView::indicator:checked:disabled:hover,
QGroupBox::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled:hover {
    image: url(:/Resources/Icons/switch-on-disabled.svg);
}

QCheckBox::indicator:indeterminate:disabled,
QCheckBox::indicator:indeterminate:disabled:hover,
QAbstractItemView::indicator:indeterminate:disabled,
QAbstractItemView::indicator:indeterminate:disabled:hover,
QGroupBox::indicator:indeterminate:disabled,
QGroupBox::indicator:indeterminate:disabled:hover {
    image: url(:/Resources/Icons/switch-mixed-disabled.svg);
}

QGraphicsView {
    background: #ffffff;
    border: none;
}

QScrollBar:horizontal,
QScrollBar:vertical {
    background: transparent;
    border: none;
    margin: 0;
    width: 12px;
    height: 12px;
}

QScrollBar::handle:horizontal,
QScrollBar::handle:vertical {
    background: #a0a0a0;
    border-radius: 4px;
    min-width: 28px;
    min-height: 28px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover,
QScrollBar::handle:vertical:hover {
    background: #7f7f7f;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
}

QScrollBar#ImageViewOverlayScrollBar:horizontal,
QScrollBar#ImageViewOverlayScrollBar:vertical {
    background: transparent;
    border: none;
    margin: 0;
    width: 10px;
    height: 10px;
}

QScrollBar#ImageViewOverlayScrollBar::handle:horizontal,
QScrollBar#ImageViewOverlayScrollBar::handle:vertical {
    background: rgba(110, 110, 110, 150);
    border: none;
    border-radius: 5px;
    min-width: 34px;
    min-height: 34px;
    margin: 1px;
}

QScrollBar#ImageViewOverlayScrollBar::handle:horizontal:hover,
QScrollBar#ImageViewOverlayScrollBar::handle:vertical:hover {
    background: rgba(95, 95, 95, 190);
}

QScrollBar#ImageViewOverlayScrollBar::add-line,
QScrollBar#ImageViewOverlayScrollBar::sub-line,
QScrollBar#ImageViewOverlayScrollBar::add-page,
QScrollBar#ImageViewOverlayScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0px;
    height: 0px;
}

QMenu {
    margin: @MENU_SHADOW_GUTTER@px;
    border: 1px solid #d9e1ea;
    border-radius: 8px;
    background-color: #ffffff;
    padding: 4px 2px;
}

QMenu::item {
    border: 1px solid transparent;
    padding: 2px 7px 2px 13px;
    margin: 1px 4px;
    border-radius: 4px;
}

QMenu[resourcesMenuHasLeadingColumn="true"]::item {
    padding-left: 16px;
}

QMenu::icon {
    padding-left: 22px;
}

QMenu::item:selected {
    background-color: transparent;
    background-image: url(:/Resources/Icons/menu-hover-dot.png);
    background-position: left center;
    background-repeat: no-repeat;
    color: #16202b;
}

QMenu::item:disabled {
    color: #95a3b1;
}

QMenu::indicator {
    left: 12px;
    width: 18px;
    height: 18px;
    padding: 0;
    border: none;
    background: transparent;
    image: none;
}

QMenu::indicator:non-exclusive:checked {
    image: url(:/Resources/Icons/menu-check-on.png);
}

QMenu::indicator:non-exclusive:checked:disabled {
    image: url(:/Resources/Icons/menu-check-disabled.png);
}

QMenu::indicator:exclusive {
    left: 12px;
    width: 16px;
    height: 16px;
    padding: 0;
    border: 1px solid #cfd9e4;
    border-radius: 9px;
    background: #ffffff;
    image: none;
}

QMenu::indicator:exclusive:checked {
    image: url(:/Resources/Icons/radio-selected.svg);
}

QMenu::indicator:exclusive:disabled {
    border-color: #dce5ee;
    image: none;
}

QMenu::indicator:exclusive:checked:disabled {
    image: url(:/Resources/Icons/radio-selected-disabled.svg);
}

/* Qt only queries the common check slot when this menu contains checkable actions. */
QMenu::indicator:!exclusive:!non-exclusive {
    width: 18px;
    height: 18px;
}

QMenu::right-arrow {
    width: 12px;
    height: 12px;
    image: url(:/Resources/Icons/menu-chevron-right-idle.png);
}
QMenu::right-arrow:selected {
    image: url(:/Resources/Icons/menu-chevron-right-active.png);
}
QMenu::right-arrow:disabled {
    image: url(:/Resources/Icons/menu-chevron-right-disabled.png);
}
QMenu::left-arrow {
    width: 12px;
    height: 12px;
    image: url(:/Resources/Icons/menu-chevron-left-idle.png);
}
QMenu::left-arrow:selected {
    image: url(:/Resources/Icons/menu-chevron-left-active.png);
}
QMenu::left-arrow:disabled {
    image: url(:/Resources/Icons/menu-chevron-left-disabled.png);
}
QMenu[resourcesMenuDirection="rtl"]::right-arrow {
    image: url(:/Resources/Icons/menu-chevron-left-idle.png);
}
QMenu[resourcesMenuDirection="rtl"]::right-arrow:selected {
    image: url(:/Resources/Icons/menu-chevron-left-active.png);
}
QMenu[resourcesMenuDirection="rtl"]::right-arrow:disabled {
    image: url(:/Resources/Icons/menu-chevron-left-disabled.png);
}

QMenu::separator {
    height: 1px;
    background: #e7e7e7;
    margin: 4px 4px;
}

QMenuBar {
    background: #ffffff;
    color: #1b2733;
    font-size: 13px;
}

QMenuBar::item {
    padding: 4px 10px;
    border-radius: 4px;
    background: transparent;
    font-size: 13px;
}

QMenuBar::item:selected,
QMenuBar::item:on {
    background-color: transparent;
    color: #16202b;
}

QSplitter::handle {
    background: #cfd9e4;
}

QSplitter::handle:hover {
    background: #8badc7;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter[fileDialogRole="sidebar"]::handle:horizontal {
    background: transparent;
    width: 4px;
    margin: 0px;
}

QSplitter[fileDialogRole="sidebar"]::handle:horizontal:hover {
    background: transparent;
}

QListView[fileDialogRole="sidebar"] {
    border: none;
    border-radius: 0px;
}

QTreeView[fileDialogRole="itemView"]::item:selected,
QTreeView[fileDialogRole="itemView"]::item:selected:!active,
QListView[fileDialogRole="itemView"]::item:selected,
QListView[fileDialogRole="itemView"]::item:selected:!active {
    background-color: #dcecf9;
    color: #16202b;
}

QToolButton[fileDialogRole="navigation"] {
    min-width: 22px;
    min-height: 22px;
    max-width: 22px;
    max-height: 22px;
    padding: 2px;
    qproperty-iconSize: 14px 14px;
}

#AutoCompletePopup {
    border: 1px solid transparent;
    border-radius: 8px;
    background-color: transparent;
    padding: 2px;
    outline: 0px;
}

#AutoCompletePopup > QWidget#qt_scrollarea_viewport {
    background-color: transparent;
}

#AutoCompletePopup::item {
    min-height: 18px;
    padding: 3px 6px;
    margin: 0px;
    border-radius: 4px;
    color: #16202b;
    background-color: transparent;
}

#AutoCompletePopup::item:hover,
#AutoCompletePopup::item:selected {
    background-color: #efefef;
    color: #16202b;
}

QFrame#SplashFrame, QFrame#LoadingFrame {
    background: #ffffff;
    border: 1px solid #d9e1ea;
    border-radius: 14px;
}

QLabel {
    min-height: 24px;
}

QLabel#SplashTitle {
    color: #00457C;
    font-size: 18px;
    font-weight: bold;
}

QLabel#SplashVersion {
    color: #516476;
    font-size: 10px;
    font-weight: bold;
}

QLabel#SplashText, QLabel#LoadingText {
    color: rgba(22, 32, 43, 160);
    font-size: 10px;
}

QLabel#SplashPercent, QLabel#LoadingPercent {
    color: #00457C;
    font-size: 12px;
    font-weight: bold;
}

/* Global QSlider Defaults */
QSlider {
    height: 20px;
    min-height: 20px;
    max-height: 20px;
}

QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: #edf2f7;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #00457C;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: 1px solid #cfd9e4;
    width: 12px;
    height: 12px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    border-color: #8badc7;
    background: #f8fafc;
}

QSlider::handle:horizontal:pressed {
    border-color: #7097b3;
    background: #f1f5f9;
}

/* Keep explicit progress text readable; compact bars opt in through Qt's existing property. */
QProgressBar {
    min-height: 18px;
    border: none;
    border-radius: 3px;
    background: #e7eef5;
    color: #243546;
    selection-color: #ffffff;
    text-align: center;
    qproperty-alignment: AlignCenter;
}
QProgressBar[textVisible="false"] { min-height: 6px; max-height: 6px; }
QProgressBar::chunk { border: none; border-radius: 3px; background: #00457c; }
QProgressBar:disabled { background: #edf2f6; color: #95a3b1; }
QProgressBar::chunk:disabled { background: #a9bdcf; }
QDateTimeEdit { padding-right: 24px; }
QTimeEdit { padding-right: 4px; }
QDateTimeEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border: none;
    background: transparent;
    image: none;
}
QDateTimeEdit::down-arrow {
    image: url(:/Resources/Icons/icons8-expand-arrow-12.png);
    width: 10px;
    height: 6px;
}
QCalendarWidget QWidget#qt_calendar_navigationbar { background: #ffffff; border-bottom: 1px solid #e2e8ef; }
QCalendarWidget QToolButton { background: transparent; color: #16202b; border: none; min-height: 22px; padding: 0 4px; font-weight: 600; }
QCalendarWidget QToolButton#qt_calendar_prevmonth { qproperty-icon: url(:/Resources/Icons/menu-chevron-left-idle.png); icon-size: 12px; }
QCalendarWidget QToolButton#qt_calendar_nextmonth { qproperty-icon: url(:/Resources/Icons/menu-chevron-right-idle.png); icon-size: 12px; }
QCalendarWidget QAbstractItemView { background: #ffffff; selection-background-color: #edf5fb; selection-color: #16202b; color: #243546; outline: 0; }
