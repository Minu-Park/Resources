/* theme/qss/00_base.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

* {
    color: @TEXT@;
    outline: none;

    font-family: "@FONT_UI@";
    font-size: @FONT_BODY@px;
}

QMainWindow,
QFrame {
    background: @SURFACE@;
}

QToolTip {
    color: @TEXT@;
    background-color: transparent;
    border: 1px solid transparent;
    padding: 3px 6px;
}

QMainWindow {
    background-color: @SURFACE@;
    color: @TEXT@;
}

QMainWindow#DeviceSessionWindow {
    background: transparent;
}

QDialog {
    background: @SURFACE@;
    color: @TEXT@;
}

QMainWindow::separator {
    width: 2px;
    height: 2px;
    background: @BORDER@;
    margin: 0;
}

QMainWindow::separator:hover {
    background: @PRESSED@;
}MainWindow::separator:horizontal,
ThemedMainWindow::separator:horizontal {
    height: 2px;
    background-color: @BORDER@;
    border: none;
}

QDockWidget {
    color: @TEXT@;
    background: @SURFACE@;
    border: none;
}

QTabWidget,
QTableWidget,
QTreeWidget,
QMenu,
QPlainTextEdit,
QTextEdit,
QTextBrowser {
    background: @SURFACE@;
    color: @TEXT@;
}

QGroupBox {
    background: @SURFACE@;
}

QLineEdit,
QComboBox,
QAbstractSpinBox {
    color: @TEXT@;
}

QTabWidget::pane {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    border-top: 1px solid @BORDER@;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    top: 0;
    padding: 8px;
}

QGroupBox {
    background-color: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    margin-top: 22px;

    color: @TEXT@;

    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 2px;
    top: 0px;
    padding: 0px;
    background: transparent;
    color: @TEXT@;

    font-size: @FONT_CAPTION@px;
    font-weight: @WEIGHT_WIDGET_BOLD@;
}/* A 24px title switch needs breathing room before the section frame begins. */
QGroupBox[checkable="true"] {
    margin-top: 32px;
    spacing: 8px;
}

QGroupBox QLabel,
QGroupBox QLineEdit,
QGroupBox QComboBox,
QGroupBox QAbstractSpinBox,
QGroupBox QCheckBox,
QGroupBox QRadioButton {

    font-weight: @WEIGHT_NORMAL@;
}

QTabBar {
    background: @SURFACE@;
    qproperty-drawBase: 0;
    border: none;
    padding: 0px;
    margin-left: 6px;
}

QTabBar::tab {
    background: transparent;
    color: @SECONDARYTEXT@;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 8px;
    margin-right: 0px;
    border-radius: 0px;

    font-weight: @WEIGHT_WIDGET_MEDIUM@;
}

QTabBar::tab:selected {
    background: transparent;
    color: @SELECTIONACCENT@;
    border-bottom: 2px solid @SELECTIONACCENT@;

    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QTabBar::tab:hover:!selected {
    color: @TEXT@;
    border-bottom: 2px solid @HOVERBORDER@;
}

QTabBar::tear {
    width: 0px;
    border: none;
    background: transparent;
    image: none;
}

QTabBar::scroller {
    width: 52px;
    margin-right: 6px;
}

QTabBar QToolButton {
    background-color: @SURFACE@;
    width: 20px;
    height: 24px;
    margin: 0px 0px;
    padding: 3px 8px;

    border: none;
    outline: none;
}

QTabBar QToolButton#ScrollLeftButton {
    margin-left: 8px;

    border: none;
    outline: none;
}

QTabBar QToolButton:hover:!pressed:!checked {
    background-color: @SURFACE@;
    border-radius: 4px;

    border: none;
    outline: none;
}

QTabBar QToolButton:pressed {
    background-color: @SURFACE@;

    border: none;
    outline: none;
}

QTabBar QToolButton:disabled {
    background-color: @SURFACE@;

    border: none;
    outline: none;
}

QTabBar QToolButton::left-arrow {
    image: url(:/Resources/icon/back-48.png);
    width: 10px;
    height: 10px;

    border: none;
    outline: none;
}

QTabBar QToolButton::left-arrow:disabled {
    image: url(:/Resources/icon/back-48.png);

    border: none;
    outline: none;
}

QTabBar QToolButton::right-arrow {
    image: url(:/Resources/icon/forward-48.png);
    width: 10px;
    height: 10px;

    border: none;
    outline: none;
}

QTabBar QToolButton::right-arrow:disabled {
    image: url(:/Resources/icon/forward-48.png);

    border: none;
    outline: none;
}

QTableView,
QTreeView {
    border: @TREE_FRAME_BORDER_WIDTH@px solid @BORDER@;
    border-radius: @TREE_FRAME_RADIUS@px;
    padding: 3px;
    gridline-color: @BORDER@;
    alternate-background-color: @DISABLEDSURFACE@;
    background-color: @SURFACE@;
}

QTableWidget,
QTreeWidget {
    border: @TREE_FRAME_BORDER_WIDTH@px solid @BORDER@;
    border-radius: @TREE_FRAME_RADIUS@px;
    padding: 3px;
    gridline-color: @BORDER@;
    alternate-background-color: @DISABLEDSURFACE@;
    selection-background-color: @HOVER@;
    selection-color: @TEXT@;
    background-color: @SURFACE@;
}

QTableView::viewport,
QTreeView::viewport,
QTableWidget::viewport,
QTreeWidget::viewport {
    background: transparent;
}

QTreeView,
QTreeWidget {
    padding-bottom: 0;
}

QHeaderView,
QFrame#DeviceFeatureSearchBubble {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 9px;
}/* Semantic typography is global; consumers expose roles rather than point sizes. */
QLabel[textRole="title"] {
    color: @TEXT@;
}

QLabel[textRole="sectionTitle"] {
    color: @TEXT@;

    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QLabel[textRole="body"],
QLabel[textRole="fieldName"] {
    color: @TEXT@;
}

QLabel[textRole="description"],
QLabel[textRole="caption"] {
    color: @SECONDARYTEXT@;
    min-height: 0;
}

QLabel[textRole="warning"] {
    color: @WARNINGTEXT@;
}

QLabel[textRole="error"] {
    color: @ERRORTEXT@;
}

QLabel:disabled {
    color: @DISABLEDTEXT@;
}

QHeaderView::section {
    background: transparent;
    color: @TEXT@;
    border: none;
    border-right: 1px solid @BORDER@;
    min-height: 22px;
    padding: 0 6px;

    font-size: @FONT_BODY@px;
    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QHeaderView::section:first {
    border-top-left-radius: 9px;
    border-bottom-left-radius: 9px;
}

QHeaderView::section:last {
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
    border-right: none;
}

QHeaderView[fileDialogRole="itemHeader"] {
    color: @TEXT@;

    font-size: @FONT_BODY@px;
    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QTableCornerButton::section {
    background: transparent;
    border: none;
}/* Shared item surfaces are joined in visual coordinates by the installed delegate. */
QTreeView,
QListView,
QTableView {
    selection-background-color: @SELECTION@;
    selection-color: @TEXT@;
    show-decoration-selected: 0;
}

QTreeView::item,
QListView::item,
QTableView::item {
    min-height: 22px;
    padding: 1px 6px;
    margin: 0;
    border: none;
    border-radius: 0;
    background: transparent;
}

QTreeView::item:hover,
QListView::item:hover,
QTableView::item:hover,
QTreeView::item:selected,
QListView::item:selected,
QTableView::item:selected {
    background: transparent;
    color: @TEXT@;
}

QWidget#ResourcesItemSelectionSurface {
    qproperty-radius: 12;
    qproperty-hoverColor: @ITEMHOVER@;
    qproperty-currentColor: @CURRENT@;
    qproperty-focusColor: @FOCUSBORDER@;
}

QTableView QLabel { background: transparent;
}

QTreeView::branch,
QTreeWidget::branch {
    border: none;
    image: none;
    background: transparent;
}

QTreeView::branch:has-children:closed,
QTreeWidget::branch:has-children:closed {
    image: url(:/Resources/icon/forward-48.png);
    width: 16px;
    height: 16px;
}

QTreeView::branch:has-children:open,
QTreeWidget::branch:has-children:open {
    image: url(:/Resources/icon/drop-down-arrow-48.png);
    width: 16px;
    height: 16px;
}

QTreeView::branch:hover,
QTreeView::branch:selected,
QTreeView::branch:open:hover,
QTreeView::branch:closed:hover,
QTreeWidget::branch:hover,
QTreeWidget::branch:selected,
QTreeWidget::branch:open:hover,
QTreeWidget::branch:closed:hover {
    background: transparent;
}

QComboBox,
QAbstractSpinBox,
QLineEdit,
QPlainTextEdit,
QTextEdit,
QTextBrowser {
    border: @CONTROL_BORDER_WIDTH@px solid @CONTROLBORDER@;
    border-radius: @CONTROL_RADIUS@px;
    padding: 5px @FIELD_PADDING_X@px;
    selection-background-color: @SELECTION@;
    selection-color: @TEXT@;
}

QPlainTextEdit,
QTextEdit,
QTextBrowser {

    font-family: "@FONT_MONO@";
}

QTextBrowser[contentRole="document"] {

    font-family: "@FONT_UI@";
}

QTextBrowser[frameRole="none"],
QTextBrowser[frameRole="none"]:hover,
QTextBrowser[frameRole="none"]:focus {
    border: none;
    background: transparent;
}

QComboBox,
QAbstractSpinBox,
QLineEdit {
    min-height: @FIELD_CONTENT_HEIGHT@px;
    max-height: @FIELD_CONTENT_HEIGHT@px;
    padding-top: 0;
    padding-bottom: 0;
    background: @SURFACE@;
}

QComboBox:enabled:hover,
QAbstractSpinBox:enabled:hover,
QLineEdit:enabled:hover,
QPlainTextEdit:enabled:hover,
QTextEdit:enabled:hover,
QTextBrowser:enabled:hover {
    border-color: @HOVERBORDER@;
}

QComboBox:focus,
QAbstractSpinBox:focus,
QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QTextBrowser:focus {
    border-color: @HOVERBORDER@;
}

QComboBox:enabled:on,
QComboBox:enabled[interactionPressed="true"],
QAbstractSpinBox:enabled[interactionPressed="true"],
QLineEdit:enabled[interactionPressed="true"],
QPlainTextEdit:enabled[interactionPressed="true"],
QTextEdit:enabled[interactionPressed="true"],
QTextBrowser:enabled[interactionPressed="true"] {
    border-color: @FOCUSBORDER@;
}

QComboBox[popupDirection="below"] {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom: 1px solid @SURFACE@;
}

QComboBox[popupDirection="above"] {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-top: 1px solid @SURFACE@;
}

QComboBox:disabled,
QAbstractSpinBox:disabled,
QLineEdit:disabled {
    color: @DISABLEDTEXT@;
    background: @DISABLEDSURFACE@;
    border-color: @CONTROLBORDER@;
}

QLineEdit[validationState="error"],
QAbstractSpinBox[validationState="error"],
QComboBox[validationState="error"] {
    border-color: @ERRORTEXT@;
}

QLineEdit[validationState="warning"],
QAbstractSpinBox[validationState="warning"],
QComboBox[validationState="warning"] {
    border-color: @WARNINGTEXT@;
}

QComboBox {
    padding-left: 6px;
    padding-right: 6px;
    combobox-popup: 0;
    combobox-list-mousetracking: 1;
}

QComboBox:editable {
    padding-left: 4px;
    padding-right: 4px;
}/* Composite fields own one frame; their embedded editors must not add another. */
QComboBox QLineEdit,
QComboBox QLineEdit:focus,
QComboBox QLineEdit:hover,
QComboBox QLineEdit:disabled,
QAbstractSpinBox QLineEdit,
QAbstractSpinBox QLineEdit:focus,
QAbstractSpinBox QLineEdit:hover,
QAbstractSpinBox QLineEdit:disabled {
    border: none;
    border-radius: 0;
    padding: 0;
    min-height: 0;
    background: transparent;
}/* Spin editors start at the native field edge; reserve the shared text inset here. */
QAbstractSpinBox QLineEdit,
QAbstractSpinBox QLineEdit:focus,
QAbstractSpinBox QLineEdit:hover,
QAbstractSpinBox QLineEdit:disabled {
    padding-left: @FIELD_TEXT_INSET@px;
    padding-right: @FIELD_TEXT_INSET@px;
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 10px;
    right: 4px;
    border-left: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(:/Resources/icon/chevron-down-neutral.svg);
    width: @INDICATOR_WIDTH@px;
    height: @INDICATOR_HEIGHT@px;
}

QComboBox QAbstractItemView {
    border: none;
    selection-background-color: transparent;
    selection-color: @TEXT@;
    background: transparent;
    padding: 2px;
    margin: 0;
    outline: 0px;
}

QComboBox QAbstractItemView::item {
    min-height: 18px;
    padding: 2px 6px;
    margin: 0px;
    border-radius: 6px;
    color: @TEXT@;
    background-color: transparent;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    background-color: @SELECTION@;
    color: @TEXT@;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    subcontrol-origin: padding;
    width: @SPIN_BUTTON_WIDTH@px;
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 0;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 0;
}

QAbstractSpinBox::up-arrow {
    image: url(:/Resources/icon/chevron-up-neutral.svg);
    width: @INDICATOR_WIDTH@px;
    height: @INDICATOR_HEIGHT@px;
}

QAbstractSpinBox::down-arrow {
    image: url(:/Resources/icon/chevron-down-neutral.svg);
    width: @INDICATOR_WIDTH@px;
    height: @INDICATOR_HEIGHT@px;
}

/* Shared compact vector arrows: neutral at rest, light-blue hover, dark-blue active. */
QComboBox[resourcesIndicatorHovered="true"]::down-arrow,
QAbstractSpinBox[resourcesIndicatorHovered="true"]::down-arrow,
QDateTimeEdit[resourcesIndicatorHovered="true"]::down-arrow {
    image: url(:/Resources/icon/chevron-down-hover.svg);
}
QAbstractSpinBox[resourcesIndicatorHovered="true"]::up-arrow {
    image: url(:/Resources/icon/chevron-up-hover.svg);
}
QComboBox::down-arrow:on,
QComboBox[popupDirection="below"]::down-arrow,
QComboBox[popupDirection="above"]::down-arrow,
QDateTimeEdit::down-arrow:on {
    image: url(:/Resources/icon/chevron-down-blue.svg);
}
QAbstractSpinBox::up-arrow:pressed {
    image: url(:/Resources/icon/chevron-up-blue.svg);
}
QAbstractSpinBox::down-arrow:pressed {
    image: url(:/Resources/icon/chevron-down-blue.svg);
}
QComboBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off,
QDateTimeEdit::down-arrow:disabled {
    image: url(:/Resources/icon/chevron-down-disabled.svg);
}
QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off {
    image: url(:/Resources/icon/chevron-up-disabled.svg);
}
QComboBox,
QAbstractSpinBox {
    image: none;
}


QPushButton {
    min-height: @FIELD_CONTENT_HEIGHT@px;
    max-height: @FIELD_CONTENT_HEIGHT@px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 8px;
    border: 1px solid @CONTROLBORDER@;
    background: @SURFACE@;
    color: @TEXT@;

    font-weight: @WEIGHT_WIDGET_BOLD@;
}

/* Icon buttons reserve a transparent border at rest so state outlines keep geometry. */
QPushButton[resourcesIconButton="true"] {
    border-color: transparent;
}

QPushButton:enabled:hover {
    background: @SURFACE@;
    border-color: @HOVERBORDER@;
    color: @TEXT@;
}

QPushButton:pressed {
    background: @SURFACE@;
    color: @TEXT@;
}

QPushButton:enabled:focus {
    border-color: @HOVERBORDER@;
    outline: none;
}

QPushButton:enabled:pressed,
QPushButton:enabled:checked {
    background: @SURFACE@;
    border-color: @FOCUSBORDER@;
    outline: none;
}

QPushButton:disabled {
    background: @DISABLEDSURFACE@;
    border-color: @CONTROLBORDER@;
    color: @DISABLEDTEXT@;
}

QPushButton[resourcesIconButton="true"]:disabled {
    border-color: transparent;
}

/* Tool buttons share the icon-button state outline; padding absorbs the reserved 1px border. */
QToolButton {
    min-height: @CONTROL_HEIGHT@px;
    padding: @TOOLBUTTON_PADDING_Y@px @TOOLBUTTON_PADDING_X@px;
    margin: 0;
    border: @CONTROL_BORDER_WIDTH@px solid transparent;
    border-radius: @TOOLBUTTON_RADIUS@px;
    background: transparent;
    color: @TEXT@;
    outline: none;

    font-weight: @WEIGHT_EMPHASIS@;
}


/* Reusable densities are selected by ResourcesTheme rather than screen-local templates. */
QToolButton[resourcesDensity="compact"] {
    min-width: @COMPACT_ACTION_CONTENT_SIZE@px;
    max-width: @COMPACT_ACTION_CONTENT_SIZE@px;
    min-height: @COMPACT_ACTION_CONTENT_SIZE@px;
    max-height: @COMPACT_ACTION_CONTENT_SIZE@px;
    padding: 0;
    border-radius: @COMPACT_ACTION_RADIUS@px;
}

QLineEdit[resourcesDensity="compact"],
QComboBox[resourcesDensity="compact"],
QAbstractSpinBox[resourcesDensity="compact"] {
    min-height: @COMPACT_FIELD_CONTENT_HEIGHT@px;
    max-height: @COMPACT_FIELD_CONTENT_HEIGHT@px;
}

QToolButton:enabled:hover,
QToolButton:enabled:focus {
    background: transparent;
    color: @TEXT@;
    border-color: @HOVERBORDER@;
}

QToolButton:enabled:pressed,
QToolButton:enabled:checked {
    background: transparent;
    border-color: @FOCUSBORDER@;
}

QToolButton:disabled {
    color: @DISABLEDTEXT@;
    background: transparent;
    border-color: transparent;
}

QCheckBox,
QRadioButton {
    color: @TEXT@;
    background: transparent;
    padding: 0;
    border: none;
}

QRadioButton {
    min-height: 22px;
    max-height: 22px;
}

QCheckBox:hover,
QRadioButton:hover {
    background: transparent;
}

QRadioButton { spacing: 8px;
}

QRadioButton::indicator,
QRadioButton::indicator:hover {
    width: 22px;
    height: 22px;
    border: none;
    padding: 0;
    background: transparent;
    image: url(:/Resources/icon/round-48.png);
}

QRadioButton::indicator:checked { image: url(:/Resources/icon/unchecked-radio-button-48.png);
}

QRadioButton::indicator:disabled { image: url(:/Resources/icon/radio-empty-disabled.svg);
}

QRadioButton::indicator:checked:disabled { image: url(:/Resources/icon/radio-selected-disabled.svg);
}

QRadioButton:disabled { color: @DISABLEDTEXT@;
}/* Default checkbox presentation; native check-state and input behavior remain intact. */
QCheckBox {
    spacing: 8px;
    min-height: @CONTROL_HEIGHT@px;
    max-height: @CONTROL_HEIGHT@px;
}

QCheckBox::indicator,
QCheckBox::indicator:hover,
QAbstractItemView::indicator,
QAbstractItemView::indicator:hover,
QGroupBox::indicator,
QGroupBox::indicator:hover {
    width: 36px;
    height: 20px;
    padding: 1px;
    border: 1px solid transparent;
    border-radius: 12px;
    background: transparent;
    image: url(:/Resources/icon/switch-outline-off.svg);
}

QCheckBox::indicator:checked,
QCheckBox::indicator:checked:hover,
QAbstractItemView::indicator:checked,
QAbstractItemView::indicator:checked:hover,
QGroupBox::indicator:checked,
QGroupBox::indicator:checked:hover {
    image: url(:/Resources/icon/switch-outline-on.svg);
}/* Keep the switch near the content edge without leaving a vacant marker column. */
QAbstractItemView::indicator {
    position: relative;
    left: -4px;
}

QComboBox QAbstractItemView::indicator,
QCalendarWidget QAbstractItemView::indicator,
#AutoCompletePopup::indicator {
    left: 0;
}

QCheckBox::indicator:indeterminate,
QCheckBox::indicator:indeterminate:hover,
QAbstractItemView::indicator:indeterminate,
QAbstractItemView::indicator:indeterminate:hover,
QGroupBox::indicator:indeterminate,
QGroupBox::indicator:indeterminate:hover {
    image: url(:/Resources/icon/switch-outline-mixed.svg);
}

QCheckBox::indicator:unchecked:enabled:hover,
QAbstractItemView::indicator:unchecked:enabled:hover,
QGroupBox::indicator:unchecked:enabled:hover {
    image: url(:/Resources/icon/switch-outline-off-hover.svg);
}

QCheckBox::indicator:checked:enabled:hover,
QAbstractItemView::indicator:checked:enabled:hover,
QGroupBox::indicator:checked:enabled:hover {
    image: url(:/Resources/icon/switch-outline-on-hover.svg);
}

QCheckBox::indicator:indeterminate:enabled:hover,
QAbstractItemView::indicator:indeterminate:enabled:hover,
QGroupBox::indicator:indeterminate:enabled:hover {
    image: url(:/Resources/icon/switch-outline-mixed-hover.svg);
}

QCheckBox::indicator:focus,
QAbstractItemView::indicator:focus,
QGroupBox::indicator:focus {
    border-color: @FOCUSBORDER@;
}

QCheckBox:disabled {
    color: @DISABLEDTEXT@;
}

QCheckBox::indicator:disabled,
QCheckBox::indicator:disabled:hover,
QAbstractItemView::indicator:disabled,
QAbstractItemView::indicator:disabled:hover,
QGroupBox::indicator:disabled,
QGroupBox::indicator:disabled:hover {
    image: url(:/Resources/icon/switch-outline-off-disabled.svg);
}

QCheckBox::indicator:checked:disabled,
QCheckBox::indicator:checked:disabled:hover,
QAbstractItemView::indicator:checked:disabled,
QAbstractItemView::indicator:checked:disabled:hover,
QGroupBox::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled:hover {
    image: url(:/Resources/icon/switch-outline-on-disabled.svg);
}

QCheckBox::indicator:indeterminate:disabled,
QCheckBox::indicator:indeterminate:disabled:hover,
QAbstractItemView::indicator:indeterminate:disabled,
QAbstractItemView::indicator:indeterminate:disabled:hover,
QGroupBox::indicator:indeterminate:disabled,
QGroupBox::indicator:indeterminate:disabled:hover {
    image: url(:/Resources/icon/switch-outline-mixed-disabled.svg);
}

QGraphicsView {
    background: @SURFACE@;
    border: none;
}

QScrollBar:horizontal,
QScrollBar:vertical {
    background: transparent;
    border: none;
    margin: 0;
    width: 12px;
    height: 12px;
}

QScrollBar::handle:horizontal,
QScrollBar::handle:vertical {
    background: @DISABLEDTEXT@;
    border-radius: 4px;
    min-width: 28px;
    min-height: 28px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover,
QScrollBar::handle:vertical:hover {
    background: @SECONDARYTEXT@;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
}









QMenu {
    margin: @MENU_SHADOW_GUTTER@px;
    border: 1px solid @BORDER@;
    border-radius: 8px;
    background-color: @SURFACE@;
    padding: 4px 2px;
}

QMenu::item {
    border: 1px solid transparent;
    padding: 2px 7px 2px 13px;
    margin: 1px 4px;
    border-radius: 4px;
}

QMenu[resourcesMenuHasLeadingColumn="true"]::item {
    padding-left: 16px;
}

QMenu::icon {
    padding-left: 22px;
}

QMenu::item:selected {
    background-color: @SELECTION@;
    color: @TEXT@;
}

QMenu::item:disabled {
    color: @DISABLEDTEXT@;
}

QMenu::indicator {
    left: 12px;
    width: 18px;
    height: 18px;
    padding: 0;
    border: none;
    background: transparent;
    image: none;
}

QMenu::indicator:non-exclusive:checked {
    image: url(:/Resources/icon/done-48.png);
}

QMenu::indicator:non-exclusive:checked:disabled {
    image: url(:/Resources/icon/done-48.png);
}

QMenu::indicator:exclusive {
    left: 12px;
    width: 18px;
    height: 18px;
    padding: 0;
    border: none;
    background: transparent;
    image: url(:/Resources/icon/round-48.png);
}

QMenu::indicator:exclusive:checked {
    image: url(:/Resources/icon/unchecked-radio-button-48.png);
}

QMenu::indicator:exclusive:disabled {
    image: url(:/Resources/icon/radio-empty-disabled.svg);
}

QMenu::indicator:exclusive:checked:disabled {
    image: url(:/Resources/icon/radio-selected-disabled.svg);
}/* Qt only queries the common check slot when this menu contains checkable actions. */
QMenu::indicator:!exclusive:!non-exclusive {
    width: 18px;
    height: 18px;
}

QMenu::right-arrow {
    width: 12px;
    height: 12px;
    image: url(:/Resources/icon/forward-48.png);
}

QMenu::right-arrow:selected {
    image: url(:/Resources/icon/forward-48.png);
}

QMenu::right-arrow:disabled {
    image: url(:/Resources/icon/forward-48.png);
}

QMenu::left-arrow {
    width: 12px;
    height: 12px;
    image: url(:/Resources/icon/back-48.png);
}

QMenu::left-arrow:selected {
    image: url(:/Resources/icon/back-48.png);
}

QMenu::left-arrow:disabled {
    image: url(:/Resources/icon/back-48.png);
}

QMenu[resourcesMenuDirection="rtl"]::right-arrow {
    image: url(:/Resources/icon/back-48.png);
}

QMenu[resourcesMenuDirection="rtl"]::right-arrow:selected {
    image: url(:/Resources/icon/back-48.png);
}

QMenu[resourcesMenuDirection="rtl"]::right-arrow:disabled {
    image: url(:/Resources/icon/back-48.png);
}

QMenu::separator {
    height: 1px;
    background: @PRESSED@;
    margin: 4px 4px;
}

QMenuBar {
    background: @SURFACE@;
    color: @TEXT@;

    font-size: @FONT_TITLE@px;
}

QMenuBar::item {
    padding: 4px 10px;
    border-radius: 4px;
    background: transparent;

    font-size: @FONT_TITLE@px;
}

QMenuBar::item:selected,
QMenuBar::item:on {
    background-color: transparent;
    color: @TEXT@;
}

QSplitter::handle {
    background: @PRESSED@;
}

QSplitter::handle:hover {
    background: @FOCUSBORDER@;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter[fileDialogRole="sidebar"]::handle:horizontal {
    background: transparent;
    width: 4px;
    margin: 0px;
}

QSplitter[fileDialogRole="sidebar"]::handle:horizontal:hover {
    background: transparent;
}

QListView[fileDialogRole="sidebar"] {
    border: none;
    border-radius: 0px;
}

QTreeView[fileDialogRole="itemView"]::item:selected,
QTreeView[fileDialogRole="itemView"]::item:selected:!active,
QListView[fileDialogRole="itemView"]::item:selected,
QListView[fileDialogRole="itemView"]::item:selected:!active {
    background-color: @SELECTION@;
    color: @TEXT@;
}

QToolButton[fileDialogRole="navigation"] {
    min-width: 22px;
    min-height: 22px;
    max-width: 22px;
    max-height: 22px;
    padding: 1px;
    qproperty-iconSize: 14px 14px;
}#AutoCompletePopup {
    border: 1px solid transparent;
    border-radius: 8px;
    background-color: transparent;
    padding: 2px;
    outline: 0px;
}#AutoCompletePopup > QWidget#qt_scrollarea_viewport {
    background-color: transparent;
}#AutoCompletePopup::item {
    min-height: 18px;
    padding: 3px 6px;
    margin: 0px;
    border-radius: 4px;
    color: @TEXT@;
    background-color: transparent;
}#AutoCompletePopup::item:hover,
#AutoCompletePopup::item:selected {
    background-color: @HOVER@;
    color: @TEXT@;
}/* One loading-bar appearance for startup,
downloads and package operations. */
ThemedProgressBar,
QWidget#ResourcesProgressSurface {
    qproperty-trackColor: @PROGRESSTRACK@;
    qproperty-startColor: @PROGRESSFILL@;
    qproperty-endColor: #0f3259;
    qproperty-outlineColor: rgba(0, 0, 0, 25);
}

QFrame#SplashFrame,
QFrame#LoadingFrame {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 14px;
}

QLabel {
    min-height: @CONTROL_HEIGHT@px;
}

QLabel#SplashTitle {
    color: @SELECTIONACCENT@;

    font-size: @FONT_DISPLAY@px;
    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QLabel#SplashVersion {
    color: @SECONDARYTEXT@;

    font-size: @FONT_COMPACT@px;
    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QLabel#SplashText,
QLabel#LoadingText {
    color: rgba(22, 32, 43, 160);

    font-size: @FONT_COMPACT@px;
}

QLabel#SplashPercent,
QLabel#LoadingPercent {
    color: @TEXT@;

    font-size: @FONT_BODY@px;
    font-weight: @WEIGHT_WIDGET_BOLD@;
}/* Global QSlider Defaults */
QSlider:horizontal {
    height: 24px;
    min-height: @CONTROL_HEIGHT@px;
    max-height: @CONTROL_HEIGHT@px;
}

QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: @CONTROLBORDER@;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    border: none;
    background: @FOCUSBORDER@;
    border-radius: 2px;
}
QSlider::add-page:horizontal {
    border: none;
    background: @CONTROLBORDER@;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: @SURFACE@;
    border: 1px solid @CONTROLBORDER@;
    width: 12px;
    height: 12px;
    margin-top: -5px;
    margin-bottom: -5px;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover,
QSlider::handle:horizontal:focus {
    border-color: @HOVERBORDER@;
    background: @SURFACE@;
}
QSlider::handle:horizontal:pressed {
    border-color: @FOCUSBORDER@;
    background: @SURFACE@;
}
QSlider::sub-page:horizontal:disabled {
    background: @CONTROLBORDER@;
}
QSlider::handle:horizontal:disabled {
    border-color: @CONTROLBORDER@;
    background: @SURFACE@;
}

/* Keep explicit progress text readable; compact bars opt in through Qt's existing property. */
QProgressBar {
    min-height: 18px;
    border: none;
    border-radius: 10px;
    background: transparent;
    color: @TEXT@;
    selection-color: @SURFACE@;
    text-align: center;
    qproperty-alignment: AlignCenter;
}

QProgressBar[textVisible="false"] { min-height: 8px; max-height: 8px; border-radius: 4px;
}

QProgressBar::chunk { border: none; background: transparent;
}

QProgressBar:disabled { color: @DISABLEDTEXT@;
}

QDateTimeEdit { padding-right: 24px;
}

QTimeEdit { padding-right: 4px;
}

QDateTimeEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border: none;
    background: transparent;
    image: none;
}

QDateTimeEdit::down-arrow {
    image: url(:/Resources/icon/chevron-down-neutral.svg);
    width: @INDICATOR_WIDTH@px;
    height: @INDICATOR_HEIGHT@px;
}

QCalendarWidget QWidget#qt_calendar_navigationbar { background: @SURFACE@; border-bottom: 1px solid @CONTROLBORDER@;
}

QCalendarWidget QToolButton { background: transparent; color: @TEXT@; min-height: 22px; padding: 0 4px;
    font-weight: @WEIGHT_EMPHASIS@;

    border: none;
    outline: none;
}

QCalendarWidget QToolButton#qt_calendar_prevmonth { qproperty-icon: url(:/Resources/icon/back-48.png); icon-size: 12px;

    border: none;
    outline: none;
}

QCalendarWidget QToolButton#qt_calendar_nextmonth { qproperty-icon: url(:/Resources/icon/forward-48.png); icon-size: 12px;

    border: none;
    outline: none;
}

QCalendarWidget QAbstractItemView { background: @SURFACE@; selection-background-color: @HOVER@; selection-color: @TEXT@; color: @TEXT@; outline: 0;
}

QCalendarWidget QAbstractItemView::item { padding: 1px 2px;
}

QFrame#DeviceFeatureSearchBubble { border-color: @CONTROLBORDER@; }

/* State-only radio proposal; supplied default radio artwork remains unchanged. */
QRadioButton[radioPreview="outline"]::indicator {
    width: 22px;
    height: 22px;
    border: none;
    padding: 0;
    background: transparent;
    image: url(:/Resources/icon/radio-outline-off.svg);
}
QRadioButton[radioPreview="outline"]::indicator:checked {
    image: url(:/Resources/icon/radio-outline-on.svg);
}
QRadioButton[radioPreview="outline"]::indicator:disabled {
    image: url(:/Resources/icon/radio-outline-off-disabled.svg);
}
QRadioButton[radioPreview="outline"]::indicator:checked:disabled {
    image: url(:/Resources/icon/radio-outline-on-disabled.svg);
}
