/* theme/qss/00_base.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

* {
    color: #16202b;
    font-family: "Inter";
    font-size: 12px;
    outline: none;
}

QDialog,
QDockWidget,
QMainWindow,
QFrame {
    background: #ffffff;
}

QToolTip {
    color: #16202b;
    background: #ffffff;
    border: 0px solid transparent;
    border-radius: 6px;
    padding: 1px 3px;
}

QMainWindow {
    background-color: #ffffff;
    color: #16202b;
}

QMainWindow#DeviceSessionWindow {
    background: transparent;
}

QDialog {
    background: #ffffff;
    color: #16202b;
}

QMainWindow::separator {
    width: 2px;
    height: 2px;
    background: #b8c3cf;
    margin: 0;
}

QMainWindow::separator:hover {
    background: #9eacba;
}

QDockWidget {
    color: #16202b;
    background: #ffffff;
    border: none;
}


QTabWidget,
QGroupBox,
QTableWidget,
QTreeWidget,
QMenu,
QLineEdit,
QComboBox,
QAbstractSpinBox,
QPlainTextEdit,
QTextEdit {
    background: #ffffff;
    color: #16202b;
}

QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #d9e1ea;
    border-radius: 10px;
    top: -1px;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d9e1ea;
    border-radius: 8px;
    margin-top: 22px;
    font-weight: 700;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 2px;
    top: 0px;
    padding: 0px;
    background: transparent;
    color: #475569;
    font-size: 11px;
    font-weight: 700;
}

QGroupBox QLabel,
QGroupBox QLineEdit,
QGroupBox QComboBox,
QGroupBox QAbstractSpinBox,
QGroupBox QCheckBox,
QGroupBox QRadioButton {
    font-weight: 400;
}

QTabBar {
    background: #ffffff;
    qproperty-drawBase: 0;
    border: none;
    border-top: 1px solid #d9e1ea;
    padding-top: 4px;
}

QTabBar::tab {
    background: #f4f6f8;
    color: #516476;
    border: 1px solid #d9e1ea;
    border-bottom: none;
    padding: 6px 16px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #00457C;
    border-color: #d9e1ea;
    border-bottom: 1px solid #ffffff;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    color: #16202b;
    background: #eef1f4;
}

QTableView,
QTreeView,
QTableWidget,
QTreeWidget {
    border: 1px solid #d9e1ea;
    border-radius: 10px;
    padding: 3px;
    gridline-color: #edf2f7;
    alternate-background-color: #fafafa;
    selection-background-color: #efefef;
    selection-color: #16202b;
    background-color: #ffffff;
}

QTableView::viewport,
QTreeView::viewport,
QTableWidget::viewport,
QTreeWidget::viewport {
    background: transparent;
}

QHeaderView {
    background: #ffffff;
    border: 1px solid #d6e0ea;
    border-radius: 9px;
}

QHeaderView::section {
    background: transparent;
    color: #000000;
    border: none;
    border-right: 1px solid #edf2f7;
    min-height: 22px;
    padding: 0 6px;
    font-size: 12px;
    font-weight: 700;
}

QHeaderView::section:first {
    border-top-left-radius: 9px;
    border-bottom-left-radius: 9px;
}

QHeaderView::section:last {
    border-top-right-radius: 9px;
    border-bottom-right-radius: 9px;
    border-right: none;
}

QTableCornerButton::section {
    background: transparent;
    border: none;
}

QTableWidget::item,
QTreeWidget::item {
    border: none;
}

QTableWidget::item:hover,
QTreeWidget::item:hover {
    background: #f5f5f5;
}

QTreeWidget::item:selected {
    color: #16202b;
}

QTreeView::branch:has-children:closed,
QTreeWidget::branch:has-children:closed {
    image: url(:/Resources/Icons/icons8-tree-forward-48.png);
    width: 16px;
    height: 16px;
}

QTreeView::branch:has-children:open,
QTreeWidget::branch:has-children:open {
    image: url(:/Resources/Icons/icons8-tree-expand-arrow-48.png);
    width: 16px;
    height: 16px;
}

QTreeView::branch:hover,
QTreeView::branch:selected,
QTreeView::branch:open:hover,
QTreeView::branch:closed:hover,
QTreeWidget::branch:hover,
QTreeWidget::branch:selected,
QTreeWidget::branch:open:hover,
QTreeWidget::branch:closed:hover {
    background: transparent;
}


QComboBox,
QAbstractSpinBox,
QLineEdit,
QPlainTextEdit,
QTextEdit {
    border: 1px solid #cfd9e4;
    border-radius: 8px;
    padding: 5px 4px;
    selection-background-color: #efefef;
    selection-color: #16202b;
}

QPlainTextEdit,
QTextEdit {
    font-family: "JetBrains Mono";
}

QComboBox,
QAbstractSpinBox,
QLineEdit {
    min-height: 22px;
    max-height: 22px;
    padding-top: 0;
    padding-bottom: 0;
}

QComboBox:hover,
QAbstractSpinBox:hover,
QLineEdit:hover,
QPlainTextEdit:hover,
QTextEdit:hover {
    border-color: #b7c7d8;
}

QComboBox:focus,
QAbstractSpinBox:focus,
QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QComboBox:on {
    border: 1px solid #8badc7;
}

QComboBox:on {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom: none;
}


QComboBox:disabled,
QAbstractSpinBox:disabled,
QLineEdit:disabled {
    color: #8ea0b0;
    background: #f7f7f7;
    border-color: #e2e8ef;
}

QComboBox {
    padding-right: 4px;
    combobox-popup: 0;
}

QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 10px;
    right: 4px;
    border-left: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(:/Resources/Icons/icons8-expand-arrow-12.png);
    width: 10px;
    height: 6px;
}

QComboBox QAbstractItemView {
    border-left: 1px solid #8badc7;
    border-right: 1px solid #8badc7;
    border-bottom: 1px solid #8badc7;
    border-top: none;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    selection-background-color: #efefef;
    selection-color: #16202b;
    background: #ffffff;
    padding: 2px;
    margin: 0;
    outline: 0px;
}

QComboBox QAbstractItemView::item {
    min-height: 18px;
    padding: 3px 6px;
    margin: 0px;
    border-radius: 4px;
    color: #16202b;
    background-color: transparent;
}

QComboBox QAbstractItemView::item:hover,
QComboBox QAbstractItemView::item:selected {
    background-color: #efefef;
    color: #16202b;
}

QAbstractSpinBox {
    padding-right: 4px;
    border: 1px solid #cfd9e4;
    border-radius: 8px;
    background: #ffffff;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    subcontrol-origin: padding;
    width: 16px;
    background: transparent;
    border-left: 1px solid #cfd9e4;
    margin: 0;
    padding: 0;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 8px;
    border-bottom: 1px solid #cfd9e4;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 8px;
}

QAbstractSpinBox::up-arrow {
    image: url(:/Resources/Icons/icons8-collapse-arrow-12.png);
    width: 10px;
    height: 6px;
}

QAbstractSpinBox::down-arrow {
    image: url(:/Resources/Icons/icons8-expand-arrow-12.png);
    width: 10px;
    height: 6px;
}

QPushButton {
    min-height: 22px;
    max-height: 22px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 8px;
    border: 1px solid #cfd9e4;
    background: #ffffff;
    color: #16202b;
    font-weight: 700;
}

QPushButton:hover {
    background: #f5f5f5;
    border-color: #b7c7d8;
    color: #16202b;
}

QPushButton:pressed {
    background: #ededed;
    color: #16202b;
}

QPushButton:disabled {
    background: #f7f7f7;
    border-color: #d6dee7;
    color: #97a6b4;
}

QToolButton {
    min-height: 24px;
    padding: 3px 8px;
    margin: 0;
    border: 1px solid transparent;
    border-radius: 7px;
    background: transparent;
    color: #2a3a4b;
    font-weight: 600;
}

QToolButton:hover {
    background: #f3f3f3;
    border-color: #d4e2ef;
    color: #16202b;
}

QToolButton:pressed {
    background: #e8e8e8;
    border-color: #c8d9ea;
}

QToolButton:checked {
    background: #f0f0f0;
    border-color: #cfcfcf;
    color: #16202b;
}

QToolButton:disabled {
    color: #95a3b1;
    background: transparent;
}

QCheckBox,
QRadioButton {
    color: #243546;
    background: transparent;
    padding: 0;
    border: none;
    min-height: 22px;
}

QCheckBox:hover,
QRadioButton:hover {
    background: transparent;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 22px;
    height: 22px;
}

QCheckBox::indicator {
    border: 1px solid #cfd9e4;
    border-radius: 8px;
    background: #ffffff;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    background: #f8fafc;
    border-color: #8badc7;
}

QCheckBox::indicator:checked {
    image: url(:/Resources/Icons/icons8-check-48.png);
    border-color: #8badc7;
    background: #f7fbff;
}

QCheckBox::indicator:checked:hover {
    border-color: #7097b3;
    background: #eef5fc;
}

QGraphicsView {
    background: #ffffff;
    border: none;
}

QScrollBar:horizontal,
QScrollBar:vertical {
    background: transparent;
    border: none;
    margin: 0;
    width: 12px;
    height: 12px;
}

QScrollBar::handle:horizontal,
QScrollBar::handle:vertical {
    background: #a0a0a0;
    border-radius: 4px;
    min-width: 28px;
    min-height: 28px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover,
QScrollBar::handle:vertical:hover {
    background: #7f7f7f;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
}

QScrollBar#ImageViewOverlayScrollBar:horizontal,
QScrollBar#ImageViewOverlayScrollBar:vertical {
    background: transparent;
    border: none;
    margin: 0;
    width: 10px;
    height: 10px;
}

QScrollBar#ImageViewOverlayScrollBar::handle:horizontal,
QScrollBar#ImageViewOverlayScrollBar::handle:vertical {
    background: rgba(110, 110, 110, 150);
    border: none;
    border-radius: 5px;
    min-width: 34px;
    min-height: 34px;
    margin: 1px;
}

QScrollBar#ImageViewOverlayScrollBar::handle:horizontal:hover,
QScrollBar#ImageViewOverlayScrollBar::handle:vertical:hover {
    background: rgba(95, 95, 95, 190);
}

QScrollBar#ImageViewOverlayScrollBar::add-line,
QScrollBar#ImageViewOverlayScrollBar::sub-line,
QScrollBar#ImageViewOverlayScrollBar::add-page,
QScrollBar#ImageViewOverlayScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0px;
    height: 0px;
}

QMenu {
    border: none;
    border-radius: 8px;
    background-color: transparent;
    padding: 4px 2px;
}

QMenu::item {
    padding: 3px 8px 3px 8px;
    margin: 1px 4px;
    border-radius: 4px;
}

QMenu::icon {
    padding-left: 6px;
}

QMenu::item:selected {
    background-color: #efefef;
    color: #16202b;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    left: 3px;
}

QMenu::indicator:checked {
    image: url(:/Resources/Icons/icons8-check-48.png);
}

QMenu::indicator:unchecked {
    image: none;
}

QMenu::separator {
    height: 1px;
    background: #e7e7e7;
    margin: 4px 4px;
}

QMenuBar {
    background: #ffffff;
    color: #1b2733;
    font-size: 13px;
}

QMenuBar::item {
    padding: 4px 10px;
    border-radius: 4px;
    background: transparent;
    font-size: 13px;
}

QMenuBar::item:selected,
QMenuBar::item:on {
    background-color: #efefef;
    color: #16202b;
}

QSplitter::handle {
    background: #cfd9e4;
}

QSplitter::handle:hover {
    background: #8badc7;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

#AutoCompletePopup {
    border: 1px solid transparent;
    border-radius: 8px;
    background-color: transparent;
    padding: 2px;
    outline: 0px;
}

#AutoCompletePopup > QWidget#qt_scrollarea_viewport {
    background-color: transparent;
}

#AutoCompletePopup::item {
    min-height: 18px;
    padding: 3px 6px;
    margin: 0px;
    border-radius: 4px;
    color: #16202b;
    background-color: transparent;
}

#AutoCompletePopup::item:hover,
#AutoCompletePopup::item:selected {
    background-color: #efefef;
    color: #16202b;
}

QFrame#SplashFrame, QFrame#LoadingFrame {
    background: #ffffff;
    border: 1px solid #d9e1ea;
    border-radius: 14px;
}

QLabel {
    min-height: 24px;
}

QLabel#SplashTitle {
    color: #00457C;
    font-size: 18px;
    font-weight: bold;
}

QLabel#SplashVersion {
    color: #516476;
    font-size: 10px;
    font-weight: bold;
}

QLabel#SplashText, QLabel#LoadingText {
    color: rgba(22, 32, 43, 160);
    font-size: 10px;
}

QLabel#SplashPercent, QLabel#LoadingPercent {
    color: #00457C;
    font-size: 12px;
    font-weight: bold;
}
