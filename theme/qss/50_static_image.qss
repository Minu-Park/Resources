/* theme/qss/50_static_image.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

/* Static image and 3D Data source controls */
StaticImageControlWidget,
Static3DDataControlWidget {
    background: #ffffff;
}

StaticImageControlWidget QLabel {
    font-weight: 600;
    color: #2a3a4b;
}

StaticImageControlWidget QToolButton,
Static3DDataControlWidget QToolButton {
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
    padding: 0;
    border-radius: 8px;
}

StaticImageControlWidget QListWidget,
Static3DDataControlWidget QListWidget {
    background-color: #ffffff;
    border: 1px solid #d9e1ea;
    border-radius: 8px;
    padding: 4px;
}

StaticImageControlWidget QListWidget::item,
Static3DDataControlWidget QListWidget::item {
    padding: 6px 10px;
    border-radius: 6px;
    color: #16202b;
}

StaticImageControlWidget QListWidget::item:hover,
Static3DDataControlWidget QListWidget::item:hover {
    background-color: #f3f3f3;
}

StaticImageControlWidget QListWidget::item:selected,
Static3DDataControlWidget QListWidget::item:selected {
    background-color: #f0f0f0;
    color: #16202b;
    font-weight: 600;
}
