/* theme/qss/50_static_image.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

/* Static image and 3D Data source controls */
StaticImageControlWidget,
Static3DDataControlWidget {
    background: #ffffff;
}

StaticImageControlWidget QLabel {
    font-weight: 600;
    color: @FONT_COLOR@;
}

StaticImageControlWidget QToolButton,
Static3DDataControlWidget QToolButton {
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
    padding: 0;
    border-radius: 8px;
}

StaticImageControlWidget QListWidget,
Static3DDataControlWidget QListWidget {
    background-color: #ffffff;
    border: 1px solid @BORDER_COLOR@;
    border-radius: 8px;
    padding: 4px;
}

/* File rows inherit the shared compact item surface and adjoining selection corners. */
