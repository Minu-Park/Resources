/* theme/qss/40_chrome.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

QMdiArea {
    border: none;
}

QMdiSubWindow {
    border: none;
    background: transparent;
    padding: 0px;
    margin: 0px;
}

QMainWindow#MainWindow {
    background-color: transparent;
    border: none;
}

QMainWindow#MainWindow[maximized="true"] {
    background-color: @SURFACE@;
    border: none;
}

/* Main Window Title Bar Styles */
QWidget#ThemedMainTitleBar {
    background-color: @SURFACE@;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom: 1px solid @BORDER@;
}

QWidget#ThemedMainTitleBar[maximized="true"] {
    background-color: @SURFACE@;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom: 1px solid @BORDER@;
}

QWidget#ThemedMainTitleBar[fullscreenOverlay="true"] {
    border-radius: 0px;
}

QWidget#ThemedMainTitleBar QMenuBar {
    background: transparent;
    border: none;
}

QWidget#ThemedMdiTitleBar QMenuBar {
    background: transparent;
    border: none;

    font-size: @FONT_CAPTION@px;
}

QWidget#ThemedMainTitleBar QMenuBar::item,
QWidget#ThemedMdiTitleBar QMenuBar::item {
    padding: 3px 8px;
    margin: 0;
}

QLabel#MainTitleLabel {
    background: transparent;
    color: @TEXT@;
    margin: 0px;
    padding: 0px;

    font-size: @FONT_TITLE@px;
    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QPushButton#MainMinButton,
QPushButton#MainMaxButton,
QPushButton#MainCloseButton {
    border: none;
    background: transparent;
    border-radius: 6px;
    width: 20px;
    height: 20px;
    margin: 0px;
    padding: 0px;
}

QPushButton#MainMinButton:hover,
QPushButton#MainMaxButton:hover,
QPushButton#MainCloseButton:hover {
    background: transparent;
}

QPushButton#MainMinButton:pressed,
QPushButton#MainMaxButton:pressed,
QPushButton#MainCloseButton:pressed {
    background-color: transparent;
}

/* MDI SubWindow Custom Container */
QWidget#ThemedMdiShadow {
    qproperty-shadowColor: rgba(@SHADOW_RGB@, 14);
    qproperty-shadowExtent: 6;
    qproperty-cornerRadius: 12;
    qproperty-offsetX: 0;
    qproperty-offsetY: 1;
}

QWidget#ThemedMdiContainer {
    qproperty-frameCornerRadius: 12;
    background-color: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QWidget#ThemedMdiContainer[maximized="true"] {
    border-left: none;
    border-right: none;
    border-radius: 0px;
}

/* HMI display workspace and editable viewer shell */
QWidget#HmiWorkspace {
    background-color: @HOVER@;
}

QWidget#HmiViewWrapper[hmiEditable="true"] {
    background-color: @SURFACE@;
    border: 4px solid @SECONDARYTEXT@;
    border-radius: 8px;
}

QWidget#HmiViewWrapper[hmiEditable="false"] {
    background: transparent;
    border: none;
}

QLabel#HmiMoveHandle {
    background-color: @SECONDARYTEXT@;
    border: none;
    border-radius: 0px;
    color: @SURFACE@;
    min-height: 28px;
    max-height: 28px;
    padding-left: 10px;

    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QWidget#HmiResizeHandle {
    background-color: @SECONDARYTEXT@;
    border: none;
}

QWidget#ThemedMdiResizeHandle {
    background: transparent;
    border: none;
}

/* Host Themed Dialog Shell */
QWidget#ThemedDialogContainer {
    background-color: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
}

QWidget#ThemedDialogTitleBar {
    background-color: @SURFACE@;
    border-bottom: 1px solid @BORDER@;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QLabel#ThemedDialogTitleLabel {
    background: transparent;
    color: @TEXT@;
    margin: 0px;
    padding: 0px;

    font-size: @FONT_CAPTION@px;
    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QPushButton#ThemedDialogCloseButton {
    border: none;
    background: transparent;
    border-radius: 6px;
    width: 20px;
    height: 20px;
    margin: 0px;
    padding: 0px;
}



QPushButton#ThemedDialogCloseButton:hover {
    background: transparent;
}

QPushButton#ThemedDialogCloseButton:pressed {
    background-color: transparent;
}

/* Custom SubWindow Title Bar */
QWidget#ThemedMdiTitleBar {
    background-color: @SURFACE@;
    border-bottom: 1px solid @BORDER@;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QWidget#ThemedMdiTitleBar[maximized="true"] {
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}

QLabel#ThemedMdiTitleBarLabel {
    background: transparent;
    color: @TEXT@;
    margin: 0px;
    padding: 0px;

    font-size: @FONT_CAPTION@px;
    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QPushButton#TitleMinButton,
QPushButton#TitleMaxButton,
QPushButton#TitleCloseButton {
    border: none;
    background: transparent;
    border-radius: 6px;
    width: 20px;
    height: 20px;
    margin: 0px;
    padding: 0px;
}

QPushButton#TitleMinButton:hover,
QPushButton#TitleMaxButton:hover,
QPushButton#TitleCloseButton:hover {
    background: transparent;
}

QPushButton#TitleMinButton:pressed,
QPushButton#TitleMaxButton:pressed,
QPushButton#TitleCloseButton:pressed {
    background-color: transparent;
}

/* Custom Dock Title Bar */
QWidget#ThemedDockTitleBar {
    background-color: @SURFACE@;
    border-bottom: 1px solid @BORDER@;
}

QLabel#ThemedDockTitleBarLabel {
    background: transparent;
    color: @TEXT@;
    padding-top: 1px; /* Slightly lower the font vertical alignment */

    font-size: @FONT_CAPTION@px;
    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QPushButton#DockMaxButton,
QPushButton#DockCloseButton {
    border: none;
    background: transparent;
    border-radius: 6px;
    width: 20px;
    height: 20px;
    margin: 0px;
    padding: 0px;
}

QPushButton#DockMaxButton:hover,
QPushButton#DockCloseButton:hover {
    background: transparent;
}

QPushButton#DockMaxButton:pressed,
QPushButton#DockCloseButton:pressed {
    background-color: transparent;
}

QFrame#DockContainerWidget {
    background-color: @SURFACE@;
    border: none;
}

QDockWidget[floatingState="true"] {
    background: transparent;
    background-color: transparent;
    border: none;
}

QFrame#DockContainerWidget[floatingState="true"],
QDockWidget[floatingState="true"] QFrame#DockContainerWidget {
    border: 1px solid @BORDER@;
    border-top: none;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
    background-color: @SURFACE@;
}

QDockWidget[floatingState="true"] QWidget#ThemedDockTitleBar {
    background-color: @SURFACE@;
    border: 1px solid @BORDER@;
    border-bottom: 1px solid @BORDER@;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QDockWidget[floatingState="true"] QFrame#DockContainerWidget > QWidget {
    background-color: @SURFACE@;
    border: none;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

QRubberBand {
    background-color: rgba(@SURFACE_RGB@, 220);
    border: 1px solid @BORDER@;
}

/* Typography policy is dialog-only. Workspace/session/dock/data widgets keep original metrics. */
QDialog, QDialog QWidget {
    font-size: @FONT_BODY@px;
    font-weight: @WEIGHT_NORMAL@;
}
QDialog QLabel[textRole="title"], QDialog QLabel#ThemedDialogTitleLabel,
QDialog QLabel#PluginMarketplaceDetailName {
    font-size: @FONT_TITLE@px;
    font-weight: @WEIGHT_EMPHASIS@;
    color: @TEXT@;
}
QDialog QGroupBox::title, QDialog QLabel[textRole="sectionTitle"],
QDialog QLabel#PluginMarketplaceSectionLabel, QDialog QLabel#RuntimePathsHeading {
    font-size: @FONT_BODY@px;
    font-weight: @WEIGHT_EMPHASIS@;
    color: @TEXT@;
}
QDialog QLabel[textRole="body"], QDialog QLabel[textRole="fieldName"],
QDialog QLineEdit#RuntimePathsNameEdit, QDialog QLabel#RuntimePathsNameLabel {
    font-size: @FONT_BODY@px;
    font-weight: @WEIGHT_NORMAL@;
    color: @TEXT@;
}
QDialog QLabel[textRole="description"], QDialog QLabel[textRole="caption"] {
    font-size: @FONT_CAPTION@px;
    font-weight: @WEIGHT_NORMAL@;
    color: @SECONDARYTEXT@;
}
QDialog QHeaderView::section, QDialog QHeaderView[fileDialogRole="itemHeader"] {
    font-size: @FONT_BODY@px;
    font-weight: @WEIGHT_NORMAL@;
    color: @TEXT@;
}

QDialog QLabel:disabled { color: @DISABLEDTEXT@; }

QDialog QTabBar::tab {
    font-size: @FONT_BODY@px;
    font-weight: @WEIGHT_NORMAL@;
}
QDialog QTabBar::tab:selected {
    color: @SELECTIONACCENT@;
    font-weight: @WEIGHT_EMPHASIS@;
    border-bottom: 2px solid @SELECTIONACCENT@;
    background: transparent;
}

QDialog QTreeWidget#RuntimePathsListWidget,
QDialog QTreeWidget#RuntimePathsListWidget::item:selected,
QDialog QWidget#RuntimePathsFormContainer QLabel#RuntimePathsLabel {
    font-size: @FONT_BODY@px;
    font-weight: @WEIGHT_NORMAL@;
    color: @TEXT@;
}
