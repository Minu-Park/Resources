/* theme/qss/20_statusbar.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

QStatusBar {
    background: transparent;
    border-top: 1px solid @BORDER@;
    border-bottom: none;
    color: @TEXT@;
    height: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 3px 0;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

QStatusBar[maximized="true"] {
    background: @SURFACE@;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

QTextEdit#SystemLogViewer {
    background-color: @SURFACE@;
    color: @TEXT@;
    border: none;
    border-radius: 0px;
    font-family: "JetBrains Mono";
    font-size: 11px;
    padding: 0px 12px;
}

QStatusBar::item {
    border: none;
    background: transparent;
    margin: 0;
    padding: 0;
}



/* Device state labels and the full GraphicsEngine statusbar use bubble geometry. */
QLabel#CameraStatusLabel,
QLabel#FramegrabberStatusLabel,
QLabel#GocatorStatusLabel,
QLabel#HeliotisC4StatusLabel,
QLabel#EngineStatusMode,
QLabel#EngineStatusSummary,
QLabel#EngineStatusRenderPath,
QLabel#EngineStatusPointer,
QLabel#EngineStatusZoom,
QLabel#EngineStatusFps {
    background: @SURFACE@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 9px;
    padding: 0 7px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    margin: 0 2px 0 0;
    color: @TEXT@;
}

QLabel#EngineStatusSummary[performancePath="native-tile"] {
    border-color: @NATIVEPATH@;
}

QLabel#EngineStatusSummary[performancePath="fit-sampling"] {
    border-color: @SAMPLEDPATH@;
}

QToolButton#EngineStatusModeButton,
QToolButton#EngineStatusViewButton,
QToolButton#ProcessingEnableToggle {
    background: @SURFACE@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 9px;
    padding: 0 7px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    margin: 0 2px 0 0;
    color: @TEXT@;
}

QLabel#CameraStatusLabel,
QLabel#FramegrabberStatusLabel,
QLabel#GocatorStatusLabel,
QLabel#HeliotisC4StatusLabel,
QLabel#EngineStatusMode,
QLabel#EngineStatusZoom,
QToolButton#EngineStatusModeButton,
QToolButton#EngineStatusViewButton {
    color: @TEXT@;
    font-weight: 700;
}

QStatusBar QLabel[statusRole="message"] {
    background: transparent;
    border: none;
    border-radius: 0px;
    padding: 0;
    margin: 0 8px 0 0;
    min-width: 0px;
    color: @TEXT@;
    font-weight: 400;
}

QStatusBar QLabel[statusRole="message"][messageState="error"] {
    font-weight: 700;
}

QLabel[statusRole="coordinates"],
QLabel[statusRole="fps"] {
    font-family: "JetBrains Mono", "Inter";
}

QLabel#EngineStatusMode,
QLabel#EngineStatusSummary,
QLabel#EngineStatusRenderPath,
QToolButton#EngineStatusModeButton,
QToolButton#EngineStatusViewButton {
    font-family: "Inter";
}

QLabel#EngineStatusPointer,
QLabel#EngineStatusZoom,
QLabel#EngineStatusFps {
    font-family: "JetBrains Mono";
}

QToolButton#EngineStatusModeButton,
QToolButton#EngineStatusViewButton,
QToolButton#ProcessingEnableToggle {
    icon-size: 16px;
}

QToolButton#EngineStatusViewButton:disabled {
    background: @SURFACE@;
    border-color: @CONTROLBORDER@;
    color: @TEXT@;
}

QToolButton#EngineStatusModeButton:hover,
QToolButton#EngineStatusViewButton:hover {
    background: @HOVER@;
    border-color: @HOVERBORDER@;
    color: @TEXT@;
}

QToolButton#EngineStatusModeButton:pressed,
QToolButton#EngineStatusViewButton:pressed {
    background: @PRESSED@;
    border-color: @HOVERBORDER@;
}

QToolButton#EngineStatusModeButton::menu-indicator,
QToolButton#EngineStatusViewButton::menu-indicator {
    image: none;
    width: 0px;
}

QPushButton#MainLogToggleBtn {
    background: @SURFACE@;
    border: 1px solid @CURRENT@;
    border-radius: 9px;
    padding: 0 8px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    margin: 0 2px 0 0;
    color: @TEXT@;
    font-weight: 700;
    font-size: 11px;
}

QPushButton#RuntimeLibrariesStatusButton {
    background: @SURFACE@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 9px;
    padding: 0 8px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    margin: 0 2px 0 0;
    color: @TEXT@;
    font-weight: 700;
    font-size: 11px;
}

QPushButton#RuntimeLibrariesStatusButton:hover {
    background: @HOVER@;
    border-color: @HOVERBORDER@;
    color: @TEXT@;
}

QPushButton#RuntimeLibrariesStatusButton:pressed {
    background: @PRESSED@;
    border-color: @HOVERBORDER@;
}

QPushButton#MainLogToggleBtn:hover {
    background: @HOVER@;
    border-color: @HOVERBORDER@;
    color: @TEXT@;
}

QPushButton#MainLogToggleBtn:checked {
    background: @PRESSED@;
    border-color: @DISABLEDTEXT@;
    color: @TEXT@;
}

QPushButton#MainLogToggleBtn:checked:hover {
    background: @PRESSED@;
    border-color: @DISABLEDTEXT@;
    color: @TEXT@;
}

QPushButton#MainLogToggleBtn[logState="warning"] {
    border-color: @WARNING@;
}

QPushButton#MainLogToggleBtn[logState="warning"]:hover {
    border-color: @WARNING@;
}

QPushButton#MainLogToggleBtn[logState="error"] {
    border-color: @ERROR@;
}

QPushButton#MainLogToggleBtn[logState="error"]:hover {
    border-color: @ERROR@;
}

QWidget#MinimizedSessionIndicator {
    background: @SURFACE@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 9px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    margin: 0 2px 0 0;
    padding: 0;
}

QWidget#MinimizedSessionIndicator[minimized="true"] {
    background: @HOVER@;
}

QPushButton#MinimizedSessionRestore {
    background: transparent;
    border: none;
    color: @TEXT@;
    font-size: 11px;
    font-weight: 600;
    padding: 0 4px 0 6px;
    margin: 0;
}

QPushButton#MinimizedSessionRestore:hover {
    color: @TEXT@;
}

QPushButton#MinimizedSessionClose {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0 4px 0 2px;
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    max-width: 16px;
    max-height: 16px;
}
