
/* theme/qss/20_statusbar.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

QStatusBar {
    background: transparent;
    border-top: 1px solid @BORDER@;
    border-bottom: none;
    color: @TEXT@;
    height: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 3px 0;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}
QStatusBar[maximized="true"] {
    background: @SURFACE@;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}
QTextEdit#SystemLogViewer {
    background-color: @SURFACE@;
    color: @TEXT@;
    border: none;
    border-radius: 0px;
    padding: 0px 12px;

    font-family: "@FONT_MONO@";
    font-size: @FONT_CAPTION@px;
}
QStatusBar::item {
    border: none;
    background: transparent;
    margin: 0;
    padding: 0;
}
/* Device state labels and the full GraphicsEngine statusbar use bubble geometry. */
QLabel#CameraStatusLabel,
QLabel#FramegrabberStatusLabel,
QLabel#GocatorStatusLabel,
QLabel#HeliotisC4StatusLabel,
QLabel#EngineStatusMode,
QLabel#EngineStatusZoom,
QToolButton[controlRole="statusBubble"][statusBubbleVariant="menu"] {
    background: @SURFACE@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 9px;
    padding: 0 7px;
    height: 24px;
    min-height: @CONTROL_HEIGHT@px;
    max-height: @CONTROL_HEIGHT@px;
    margin: 0 2px 0 0;
}
QLabel#EngineStatusSummary,
QLabel#EngineStatusRenderPath,
QLabel#EngineStatusPointer,
QLabel#EngineStatusFps {
    background: @SURFACE@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 9px;
    padding: 0 7px;
    height: 24px;
    min-height: @CONTROL_HEIGHT@px;
    max-height: @CONTROL_HEIGHT@px;
    margin: 0 2px 0 0;
    color: @TEXT@;
}
QLabel#EngineStatusSummary[performancePath="native-tile"] {
    border-color: @NATIVEPATH@;
}
QLabel#EngineStatusSummary[performancePath="fit-sampling"] {
    border-color: @SAMPLEDPATH@;
}
QLabel#CameraStatusLabel,
QLabel#FramegrabberStatusLabel,
QLabel#GocatorStatusLabel,
QLabel#HeliotisC4StatusLabel,
QLabel#EngineStatusMode,
QLabel#EngineStatusZoom {
    color: @TEXT@;

    font-weight: @WEIGHT_WIDGET_BOLD@;
}
QToolButton[controlRole="statusBubble"][statusBubbleVariant="menu"] {
    color: @TEXT@;
    font-weight: @WEIGHT_WIDGET_BOLD@;
}
QStatusBar QLabel[statusRole="deviceFailed"],
QStatusBar QLabel[statusRole="deviceFps"] {
    background: @SURFACE@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 9px;
    padding: 0 7px;
    height: 24px;
    min-height: @CONTROL_HEIGHT@px;
    max-height: @CONTROL_HEIGHT@px;
    margin: 0 2px 0 0;
    color: @TEXT@;
}
QStatusBar QLabel[statusRole="deviceFps"] {
    font-family: "@FONT_MONO@";
}
QStatusBar QLabel[statusRole="deviceFailed"][failedState="warning"] {
    border-color: @WARNING@;
    color: @WARNINGTEXT@;
}
QStatusBar QLabel[statusRole="message"] {
    background: transparent;
    border: none;
    border-radius: 0px;
    padding: 0;
    margin: 0 8px 0 0;
    min-width: 0px;
    color: @TEXT@;

    font-weight: @WEIGHT_NORMAL@;
}
QStatusBar QLabel[statusRole="message"][messageState="error"] {

    color: @TEXT@;

    font-weight: @WEIGHT_WIDGET_BOLD@;
}
QLabel[statusRole="coordinates"],
QLabel[statusRole="fps"] {

    font-family: "@FONT_MONO@", "@FONT_UI@";
}
QLabel#EngineStatusMode,
QLabel#EngineStatusSummary,
QLabel#EngineStatusRenderPath {

    font-family: "@FONT_UI@";
}
QToolButton[controlRole="statusBubble"][statusBubbleVariant="menu"] {
    font-family: "@FONT_UI@";
}
QLabel#EngineStatusPointer,
QLabel#EngineStatusZoom,
QLabel#EngineStatusFps {

    font-family: "@FONT_MONO@";
}
QToolButton[controlRole="statusBubble"][statusBubbleVariant="menu"] {
    icon-size: 16px;

    outline: none;
}
QToolButton[controlRole="statusBubble"][statusBubbleVariant="menu"]:disabled {
    background: @SURFACE@;
    color: @TEXT@;

    border-color: @CONTROLBORDER@;
    outline: none;
}
QToolButton[controlRole="statusBubble"][statusBubbleVariant="menu"]::menu-indicator {
    image: none;
    width: 0px;

    border: none;
    outline: none;
}
QPushButton[controlRole="statusBubble"][statusBubbleVariant="alert"],
QPushButton[controlRole="statusBubble"][statusBubbleVariant="action"] {
    background: @SURFACE@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 9px;
    padding: 0 8px;
    height: 24px;
    min-height: @CONTROL_HEIGHT@px;
    max-height: @CONTROL_HEIGHT@px;
    margin: 0 2px 0 0;
    color: @TEXT@;

    font-weight: @WEIGHT_WIDGET_BOLD@;
    font-size: @FONT_CAPTION@px;
}

QPushButton[controlRole="statusBubble"][statusBubbleVariant="alert"] {
    border-color: @STATUSBORDER@;
}
QPushButton[controlRole="statusBubble"][statusBubbleVariant="alert"][logState="warning"] {
    border-color: @WARNING@;
}
QPushButton[controlRole="statusBubble"][statusBubbleVariant="alert"][logState="error"] {
    border-color: @ERROR@;
}
/* A composite bubble is a plain QWidget container; `.QWidget` excludes button bubbles. */
.QWidget[controlRole="statusBubble"] {
    background: @SURFACE@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 9px;
    height: 24px;
    min-height: @CONTROL_HEIGHT@px;
    max-height: @CONTROL_HEIGHT@px;
    margin: 0 2px 0 0;
    padding: 0;
}
QWidget#MinimizedSessionIndicator[minimized="true"] {
    background: @HOVER@;
}
.QWidget[controlRole="statusBubble"] QPushButton {
    color: @TEXT@;
}
/* Its label color follows the composite bubble state below. */
QPushButton#MinimizedSessionRestore {
    background: transparent;
    border: none;
    padding: 0 4px 0 6px;
    margin: 0;

    font-size: @FONT_CAPTION@px;
    font-weight: @WEIGHT_EMPHASIS@;
}
QPushButton#MinimizedSessionClose {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0 4px 0 2px;
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    max-width: 16px;
    max-height: 16px;
}

/* Every clickable status bubble shares one state rule; variants keep only their rest presentation.
 * Composite bubbles take interactionHovered/interactionPressed from the Resources runtime, and
 * their text buttons follow the bubble. Active interaction, including an open menu, takes
 * precedence over hover and keyboard focus; its label takes the selection accent, as in menu rows. */
QToolButton[controlRole="statusBubble"]:enabled[resourcesKeyboardFocus="true"]:!pressed:!checked,
QPushButton[controlRole="statusBubble"]:enabled[resourcesKeyboardFocus="true"]:!pressed:!checked {
    border-color: @HOVERBORDER@;
    outline: none;
}
QToolButton[controlRole="statusBubble"]:enabled:hover:!pressed:!checked,
QPushButton[controlRole="statusBubble"]:enabled:hover:!pressed:!checked {
    background: @SURFACE@;
    border-color: @HOVERBORDER@;
    color: @HOVERBORDER@;
    outline: none;
}
.QWidget[controlRole="statusBubble"][interactionHovered="true"]:enabled {
    border-color: @HOVERBORDER@;
}
.QWidget[controlRole="statusBubble"][interactionHovered="true"]:enabled QPushButton {
    color: @HOVERBORDER@;
}
QToolButton[controlRole="statusBubble"]:enabled:pressed,
QToolButton[controlRole="statusBubble"]:enabled:checked,
QPushButton[controlRole="statusBubble"]:enabled:pressed,
QPushButton[controlRole="statusBubble"]:enabled:checked {
    background: @SURFACE@;
    border-color: @FOCUSBORDER@;
    color: @SELECTIONACCENT@;
    outline: none;
}
.QWidget[controlRole="statusBubble"][interactionPressed="true"]:enabled {
    border-color: @FOCUSBORDER@;
}
.QWidget[controlRole="statusBubble"][interactionPressed="true"]:enabled QPushButton {
    color: @SELECTIONACCENT@;
}

/* Keyboard focus remains distinct from pointer hover on named action surfaces. */
QToolButton[controlRole="statusBubble"]:enabled[resourcesKeyboardFocus="true"]:focus:!pressed:!checked,
QPushButton[controlRole="statusBubble"]:enabled[resourcesKeyboardFocus="true"]:focus:!pressed:!checked {
    border-color: @FOCUSBORDER@;
    outline: none;
}
