/* theme/qss/20_statusbar.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

QStatusBar {
    background: #ffffff;
    border-top: 1px solid #d9e1ea;
    color: #3d5063;
    height: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 3px 0;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

QTextEdit#SystemLogViewer {
    background-color: #ffffff;
    color: #16202b;
    border-top: 1px solid #d9e1ea;
    border-bottom: 1px solid #d9e1ea;
    border-left: none;
    border-right: none;
    border-radius: 0px;
    font-family: "Menlo", "Monaco", "Consolas", "DejaVu Sans Mono", "Liberation Mono", "Courier New", monospace;
    font-size: 11px;
    padding: 8px;
}

QStatusBar::item {
    border: none;
    background: transparent;
    margin: 0;
    padding: 0;
}



QStatusBar QLabel,
QLabel#CameraStatusLabel,
QLabel#GocatorStatusLabel,
QLabel#EngineStatusMode,
QLabel#EngineStatusSummary,
QLabel#EngineStatusPointer,
QLabel#EngineStatusZoom,
QLabel#EngineStatusFps,
QToolButton#EngineStatusModeButton,
QToolButton#EngineStatusViewButton,
QToolButton#ProcessingEnableToggle {
    background: #ffffff;
    border: 1px solid #d7dee6;
    border-radius: 9px;
    padding: 0 7px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    margin: 0 2px 0 0;
    color: #425467;
}

QStatusBar QLabel:hover,
QLabel#EngineStatusMode:hover,
QLabel#EngineStatusSummary:hover,
QLabel#EngineStatusPointer:hover,
QLabel#EngineStatusZoom:hover,
QLabel#EngineStatusFps:hover {
    background: #ffffff;
    border: 1px solid #d7dee6;
    color: #425467;
}

QLabel#CameraStatusLabel,
QLabel#GocatorStatusLabel,
QLabel#EngineStatusMode,
QLabel#EngineStatusZoom,
QToolButton#EngineStatusModeButton,
QToolButton#EngineStatusViewButton {
    color: #354657;
    font-weight: 700;
}

QLabel#EngineStatusMode {
    background: #f6f6f6;
    border-color: #d7d7d7;
}

QLabel#EngineStatusSummary {
    padding: 0 6px;
}

QToolButton#EngineStatusModeButton,
QToolButton#EngineStatusViewButton,
QToolButton#ProcessingEnableToggle {
    icon-size: 16px;
}

QToolButton#EngineStatusViewButton:disabled {
    background: #ffffff;
    border-color: #d7dee6;
    color: #425467;
}

QToolButton#EngineStatusModeButton:hover,
QToolButton#EngineStatusViewButton:hover {
    background: #eef3f8;
    border-color: #c7d4e2;
    color: #26384a;
}

QToolButton#EngineStatusModeButton:pressed,
QToolButton#EngineStatusViewButton:pressed {
    background: #e7eef6;
    border-color: #bccbda;
}

QToolButton#EngineStatusModeButton::menu-indicator,
QToolButton#EngineStatusViewButton::menu-indicator {
    image: none;
    width: 0px;
}

QLabel#CameraStatusLabel[status="connected"],
QLabel#GocatorStatusLabel[status="connected"] {
    color: #2e7d32;
}

QLabel#CameraStatusLabel[status="idle"],
QLabel#GocatorStatusLabel[status="idle"] {
    color: #5c6b7a;
}

QLabel#CameraStatusLabel[status="disconnected"],
QLabel#GocatorStatusLabel[status="disconnected"] {
    color: #c62828;
}

QLabel#CameraStatusLabel[status="grabbing"],
QLabel#GocatorStatusLabel[status="grabbing"] {
    color: #1565c0;
}
