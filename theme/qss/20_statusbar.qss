/* theme/qss/20_statusbar.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

QStatusBar {
    background: transparent;
    border-top: 1px solid @BORDER@;
    border-bottom: none;
    color: @TEXT@;
    height: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 3px 0;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

QStatusBar[maximized="true"] {
    background: @SURFACE@;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

QTextEdit#SystemLogViewer {
    background-color: @SURFACE@;
    color: @TEXT@;
    border: none;
    border-radius: 0px;
    padding: 0px 12px;

    font-family: "@FONT_MONO@";
    font-size: @FONT_CAPTION@px;
}

QStatusBar::item {
    border: none;
    background: transparent;
    margin: 0;
    padding: 0;
}/* Device state labels and the full GraphicsEngine statusbar use bubble geometry. */
QLabel#CameraStatusLabel,
QLabel#FramegrabberStatusLabel,
QLabel#GocatorStatusLabel,
QLabel#HeliotisC4StatusLabel,
QLabel#EngineStatusMode,
QLabel#EngineStatusZoom,
QToolButton#EngineStatusModeButton,
QToolButton#EngineStatusViewButton {
    background: @SURFACE@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 9px;
    padding: 0 7px;
    height: 24px;
    min-height: @CONTROL_HEIGHT@px;
    max-height: @CONTROL_HEIGHT@px;
    margin: 0 2px 0 0;
}

QLabel#EngineStatusSummary,
QLabel#EngineStatusRenderPath,
QLabel#EngineStatusPointer,
QLabel#EngineStatusFps {
    background: @SURFACE@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 9px;
    padding: 0 7px;
    height: 24px;
    min-height: @CONTROL_HEIGHT@px;
    max-height: @CONTROL_HEIGHT@px;
    margin: 0 2px 0 0;
    color: @TEXT@;
}

QLabel#EngineStatusSummary[performancePath="native-tile"] {
    border-color: @NATIVEPATH@;
}

QLabel#EngineStatusSummary[performancePath="fit-sampling"] {
    border-color: @SAMPLEDPATH@;
}

QLabel#CameraStatusLabel,
QLabel#FramegrabberStatusLabel,
QLabel#GocatorStatusLabel,
QLabel#HeliotisC4StatusLabel,
QLabel#EngineStatusMode,
QLabel#EngineStatusZoom {
    color: @TEXT@;

    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QToolButton#EngineStatusModeButton,
QToolButton#EngineStatusViewButton {
    color: @TEXT@;
    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QStatusBar QLabel[statusRole="message"] {
    background: transparent;
    border: none;
    border-radius: 0px;
    padding: 0;
    margin: 0 8px 0 0;
    min-width: 0px;
    color: @TEXT@;

    font-weight: @WEIGHT_NORMAL@;
}

QStatusBar QLabel[statusRole="message"][messageState="error"] {

    color: @TEXT@;

    font-weight: @WEIGHT_WIDGET_BOLD@;
}

QLabel[statusRole="coordinates"],
QLabel[statusRole="fps"] {

    font-family: "@FONT_MONO@", "@FONT_UI@";
}

QLabel#EngineStatusMode,
QLabel#EngineStatusSummary,
QLabel#EngineStatusRenderPath {

    font-family: "@FONT_UI@";
}

QToolButton#EngineStatusModeButton,
QToolButton#EngineStatusViewButton {
    font-family: "@FONT_UI@";
}

QLabel#EngineStatusPointer,
QLabel#EngineStatusZoom,
QLabel#EngineStatusFps {

    font-family: "@FONT_MONO@";
}

QToolButton#EngineStatusModeButton,
QToolButton#EngineStatusViewButton {
    icon-size: 16px;

    outline: none;
}

QToolButton#EngineStatusModeButton:disabled,
QToolButton#EngineStatusViewButton:disabled {
    background: @SURFACE@;
    color: @TEXT@;

    border-color: @CONTROLBORDER@;
    outline: none;
}

QToolButton#EngineStatusModeButton:enabled:hover:!pressed:!checked,
QToolButton#EngineStatusViewButton:enabled:hover:!pressed:!checked {
    background: @SURFACE@;
    color: @TEXT@;

    border-color: @HOVERBORDER@;
    outline: none;
}

QToolButton#EngineStatusModeButton:enabled:pressed,
QToolButton#EngineStatusViewButton:enabled:pressed {
    background: @SURFACE@;
}

QToolButton#EngineStatusModeButton:enabled:focus:!pressed:!checked,
QToolButton#EngineStatusViewButton:enabled:focus:!pressed:!checked {

    border-color: @HOVERBORDER@;
    outline: none;
}

QToolButton#EngineStatusModeButton::menu-indicator,
QToolButton#EngineStatusViewButton::menu-indicator {
    image: none;
    width: 0px;

    border: none;
    outline: none;
}

QPushButton#MainLogToggleBtn {
    background: @SURFACE@;
    border: 1px solid @STATUSBORDER@;
    border-radius: 9px;
    padding: 0 8px;
    height: 24px;
    min-height: @CONTROL_HEIGHT@px;
    max-height: @CONTROL_HEIGHT@px;
    margin: 0 2px 0 0;
    color: @TEXT@;

    font-weight: @WEIGHT_WIDGET_BOLD@;
    font-size: @FONT_CAPTION@px;
}

QPushButton#RuntimeLibrariesStatusButton {
    background: @SURFACE@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 9px;
    padding: 0 8px;
    height: 24px;
    min-height: @CONTROL_HEIGHT@px;
    max-height: @CONTROL_HEIGHT@px;
    margin: 0 2px 0 0;
    color: @TEXT@;

    font-weight: @WEIGHT_WIDGET_BOLD@;
    font-size: @FONT_CAPTION@px;
}

QPushButton#RuntimeLibrariesStatusButton:enabled:hover:!pressed:!checked {
    background: @SURFACE@;
    border-color: @HOVERBORDER@;
    color: @TEXT@;
}

QPushButton#RuntimeLibrariesStatusButton:enabled:pressed {
    background: @SURFACE@;
}

QPushButton#MainLogToggleBtn:enabled:hover:!pressed:!checked {
    color: @TEXT@;
}

QPushButton#MainLogToggleBtn:checked,
QPushButton#MainLogToggleBtn:checked:hover {
    background: @SURFACE@;
    border-color: @FOCUSBORDER@;
    color: @TEXT@;
}

QPushButton#MainLogToggleBtn[logState="warning"] {
    border-color: @WARNING@;
}

QPushButton#MainLogToggleBtn[logState="error"] {
    border-color: @ERROR@;
}

QPushButton#MainLogToggleBtn:enabled:hover:!pressed:!checked,
QPushButton#MainLogToggleBtn:enabled:focus:!pressed:!checked,
QPushButton#RuntimeLibrariesStatusButton:enabled:focus:!pressed:!checked {
    background: @SURFACE@;
    border-color: @HOVERBORDER@;
}

QPushButton#MainLogToggleBtn:enabled:pressed,
QPushButton#MainLogToggleBtn:enabled:checked {
    background: @SURFACE@;
}

QWidget#MinimizedSessionIndicator {
    background: @SURFACE@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 9px;
    height: 24px;
    min-height: @CONTROL_HEIGHT@px;
    max-height: @CONTROL_HEIGHT@px;
    margin: 0 2px 0 0;
    padding: 0;
}

QWidget#MinimizedSessionIndicator[minimized="true"] {
    background: @HOVER@;
}

QPushButton#MinimizedSessionRestore {
    background: transparent;
    border: none;
    color: @TEXT@;
    padding: 0 4px 0 6px;
    margin: 0;

    font-size: @FONT_CAPTION@px;
    font-weight: @WEIGHT_EMPHASIS@;
}

QPushButton#MinimizedSessionRestore:hover {
    color: @TEXT@;
}

QPushButton#MinimizedSessionClose {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0 4px 0 2px;
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    max-width: 16px;
    max-height: 16px;
}

QPushButton#RuntimeLibrariesStatusButton:enabled:pressed,
QPushButton#RuntimeLibrariesStatusButton:enabled:checked,
QPushButton#MainLogToggleBtn:enabled:pressed,
QPushButton#MainLogToggleBtn:enabled:checked {
    border-color: @FOCUSBORDER@;
}

/* Active interaction takes precedence over hover and keyboard focus. */
QToolButton#EngineStatusModeButton:enabled:pressed,
QToolButton#EngineStatusModeButton:enabled:checked,
QToolButton#EngineStatusViewButton:enabled:pressed,
QToolButton#EngineStatusViewButton:enabled:checked {

    border-color: @FOCUSBORDER@;
    outline: none;
}
