/* theme/qss/20_statusbar.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

QStatusBar {
    background: transparent;
    border-top: 1px solid #d9e1ea;
    border-bottom: none;
    color: #3d5063;
    height: 32px;
    min-height: 32px;
    max-height: 32px;
    padding: 3px 0;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

QStatusBar[maximized="true"] {
    background: #ffffff;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

QTextEdit#SystemLogViewer {
    background-color: #ffffff;
    color: #16202b;
    border: none;
    border-radius: 0px;
    font-family: "JetBrains Mono";
    font-size: 11px;
    padding: 8px;
}

QStatusBar::item {
    border: none;
    background: transparent;
    margin: 0;
    padding: 0;
}



/* Device state labels and the full GraphicsEngine statusbar use bubble geometry. */
QLabel#CameraStatusLabel,
QLabel#FramegrabberStatusLabel,
QLabel#GocatorStatusLabel,
QLabel#HeliotisC4StatusLabel,
QLabel#EngineStatusMode,
QLabel#EngineStatusSummary,
QLabel#EngineStatusRenderPath,
QLabel#EngineStatusPointer,
QLabel#EngineStatusZoom,
QLabel#EngineStatusFps,
QLabel#MainLogErrorLabel {
    background: #ffffff;
    border: 1px solid #d7dee6;
    border-radius: 9px;
    padding: 0 7px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    margin: 0 2px 0 0;
    color: #425467;
}

QLabel#EngineStatusSummary[performancePath="native-tile"] {
    border-color: #1565c0;
}

QToolButton#EngineStatusModeButton,
QToolButton#EngineStatusViewButton,
QToolButton#ProcessingEnableToggle {
    background: #ffffff;
    border: 1px solid #d7dee6;
    border-radius: 9px;
    padding: 0 7px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    margin: 0 2px 0 0;
    color: #425467;
}

QLabel#CameraStatusLabel,
QLabel#FramegrabberStatusLabel,
QLabel#GocatorStatusLabel,
QLabel#HeliotisC4StatusLabel,
QLabel#EngineStatusMode,
QLabel#EngineStatusZoom,
QToolButton#EngineStatusModeButton,
QToolButton#EngineStatusViewButton {
    color: #354657;
    font-weight: 700;
}

QStatusBar QLabel[statusRole="message"] {
    background: transparent;
    border: none;
    border-radius: 0px;
    padding: 0;
    margin: 0 8px 0 0;
    min-width: 0px;
    color: #425467;
    font-weight: 400;
}

QStatusBar QLabel[statusRole="message"][messageState="error"] {
    color: #c62828;
    font-weight: 700;
}

QLabel[statusRole="coordinates"],
QLabel[statusRole="fps"] {
    font-family: "JetBrains Mono", "Inter";
}

QLabel#EngineStatusMode,
QLabel#EngineStatusSummary,
QLabel#EngineStatusRenderPath,
QLabel#EngineStatusPointer,
QLabel#EngineStatusZoom,
QLabel#EngineStatusFps,
QToolButton#EngineStatusModeButton,
QToolButton#EngineStatusViewButton {
    font-family: "JetBrains Mono";
}

QToolButton#EngineStatusModeButton,
QToolButton#EngineStatusViewButton,
QToolButton#ProcessingEnableToggle {
    icon-size: 16px;
}

QToolButton#EngineStatusViewButton:disabled {
    background: #ffffff;
    border-color: #d7dee6;
    color: #425467;
}

QToolButton#EngineStatusModeButton:hover,
QToolButton#EngineStatusViewButton:hover {
    background: #eef3f8;
    border-color: #c7d4e2;
    color: #26384a;
}

QToolButton#EngineStatusModeButton:pressed,
QToolButton#EngineStatusViewButton:pressed {
    background: #e7eef6;
    border-color: #bccbda;
}

QToolButton#EngineStatusModeButton::menu-indicator,
QToolButton#EngineStatusViewButton::menu-indicator {
    image: none;
    width: 0px;
}

QLabel#CameraStatusLabel[status="connected"],
QLabel#FramegrabberStatusLabel[status="connected"],
QLabel#GocatorStatusLabel[status="connected"],
QLabel#HeliotisC4StatusLabel[status="connected"] {
    color: #2e7d32;
}

QLabel#CameraStatusLabel[status="idle"],
QLabel#FramegrabberStatusLabel[status="idle"],
QLabel#GocatorStatusLabel[status="idle"],
QLabel#HeliotisC4StatusLabel[status="idle"] {
    color: #5c6b7a;
}

QLabel#CameraStatusLabel[status="disconnected"],
QLabel#FramegrabberStatusLabel[status="disconnected"],
QLabel#GocatorStatusLabel[status="disconnected"],
QLabel#HeliotisC4StatusLabel[status="disconnected"] {
    color: #c62828;
}

QLabel#CameraStatusLabel[status="grabbing"],
QLabel#FramegrabberStatusLabel[status="grabbing"],
QLabel#GocatorStatusLabel[status="grabbing"],
QLabel#HeliotisC4StatusLabel[status="grabbing"] {
    color: #1565c0;
}

QPushButton#MainLogToggleBtn {
    background: #ffffff;
    border: 1px solid #c8d9eb;
    border-radius: 9px;
    padding: 0 8px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    margin: 0 2px 0 0;
    color: #00457C;
    font-weight: 700;
    font-size: 11px;
}

QPushButton#RuntimeLibrariesStatusButton {
    background: #ffffff;
    border: 1px solid #d7dee6;
    border-radius: 9px;
    padding: 0 8px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    margin: 0 2px 0 0;
    color: #425467;
    font-weight: 700;
    font-size: 11px;
}

QPushButton#RuntimeLibrariesStatusButton:hover {
    background: #eef3f8;
    border-color: #c7d4e2;
    color: #26384a;
}

QPushButton#RuntimeLibrariesStatusButton:pressed {
    background: #e7eef6;
    border-color: #bccbda;
}

QPushButton#MainLogToggleBtn:hover {
    background: #f0f5fa;
    border-color: #8badc7;
    color: #00457C;
}

QPushButton#MainLogToggleBtn:checked {
    background: #e1ebf5;
    border-color: #8badc7;
    color: #00457C;
}

QPushButton#MainLogToggleBtn:checked:hover {
    background: #d4e3f0;
    border-color: #7097b3;
    color: #00457C;
}

QPushButton#MainLogToggleBtn[logState="warning"] {
    background: #fff3e0;
    border-color: #ffb74d;
    color: #e65100;
}

QPushButton#MainLogToggleBtn[logState="warning"]:hover {
    background: #ffe0b2;
    border-color: #fb8c00;
    color: #e65100;
}

QLabel#MainLogErrorLabel {
    color: #c62828;
    font-weight: 700;
    font-size: 11px;
}

QWidget#MinimizedSessionIndicator {
    background: #ffffff;
    border: 1px solid #d7dee6;
    border-radius: 9px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    margin: 0 2px 0 0;
    padding: 0;
}

QWidget#MinimizedSessionIndicator[minimized="true"] {
    background: #f0f4f8;
}

QPushButton#MinimizedSessionRestore {
    background: transparent;
    border: none;
    color: #354657;
    font-size: 11px;
    font-weight: 600;
    padding: 0 4px 0 6px;
    margin: 0;
}

QPushButton#MinimizedSessionRestore:hover {
    color: #1565c0;
}

QPushButton#MinimizedSessionClose {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0 4px 0 2px;
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    max-width: 16px;
    max-height: 16px;
}
