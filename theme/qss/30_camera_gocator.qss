/* theme/qss/30_camera_gocator.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

QCameraWidget,
QGocatorWidget {
    background: #ffffff;
}

QCameraWidget QToolButton,
QGocatorWidget QToolButton {
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
    padding: 0;
    border-radius: 8px;
}

QTreeWidget[treeRole="DeviceFeatureTree"] {
    background: #ffffff;
    alternate-background-color: #ffffff;
    gridline-color: #edf2f7;
    selection-background-color: #ffffff;
    selection-color: #16202b;
    show-decoration-selected: 0;
}

QTreeWidget[treeRole="DeviceFeatureTree"]::item {
    min-height: 22px;
    padding: 0 6px;
}

QTreeWidget[treeRole="DeviceFeatureTree"] QCheckBox,
QTreeWidget[treeRole="DeviceFeatureTree"] QRadioButton {
    padding: 0;
    margin: 0;
}

QTreeWidget[treeRole="DeviceFeatureTree"]::item:hover {
    background: #ffffff;
}

QTreeWidget[treeRole="DeviceFeatureTree"]::item:selected {
    background: #ffffff;
    color: #16202b;
}


QCameraWidget QLabel {
    background: transparent;
    min-height: 22px;
    padding: 0 6px;
    margin: 0;
}

QCameraWidget QLabel:hover {
    background: #f5f5f5;
}

QCameraWidget QLabel#CameraStatusLabel:hover,
QGocatorWidget QLabel#GocatorStatusLabel:hover {
    background: #ffffff;
}

QCameraWidget QLabel#CameraMessageLabel,
QGocatorWidget QLabel#GocatorMessageLabel {
    background: transparent;
    border: none;
    padding: 0;
    margin-left: 3px;
    color: #354657;
    font-weight: 400;
}

QCameraWidget QLabel#CameraMessageLabel[messageState="normal"],
QGocatorWidget QLabel#GocatorMessageLabel[messageState="normal"] {
    color: #354657;
    font-weight: 400;
}

QCameraWidget QLabel#CameraMessageLabel[messageState="error"],
QGocatorWidget QLabel#GocatorMessageLabel[messageState="error"] {
    color: #c62828;
    font-weight: 700;
}

QTreeWidget[treeRole="DeviceFeatureTree"]::viewport {
    background: transparent;
}
