/* theme/qss/30_camera_gocator.qss: single-theme stylesheet part; keep load order in Resources.cpp. */

QCameraWidget,
QGocatorWidget {
    background: #ffffff;
}

QCameraWidget QToolButton,
QGocatorWidget QToolButton {
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
    padding: 0;
    border-radius: 8px;
}

QCameraWidget QToolButton:hover,
QGocatorWidget QToolButton:hover {
    background: #f3f3f3;
}

QCameraWidget QToolButton:pressed,
QGocatorWidget QToolButton:pressed {
    background: #e8e8e8;
}

QTreeWidget#CameraFeaturesTree,
QTreeWidget#GocatorFeaturesTree {
    border: none;
    border-radius: 0;
    background: #ffffff;
    padding: 0;
    alternate-background-color: #ffffff;
    gridline-color: #edf2f7;
    selection-background-color: #ffffff;
    selection-color: #16202b;
    show-decoration-selected: 0;
}

QTreeWidget#CameraFeaturesTree::item,
QTreeWidget#GocatorFeaturesTree::item {
    min-height: 22px;
    padding: 0 6px;
}

QTreeWidget#CameraFeaturesTree QCheckBox,
QTreeWidget#CameraFeaturesTree QRadioButton,
QTreeWidget#GocatorFeaturesTree QCheckBox,
QTreeWidget#GocatorFeaturesTree QRadioButton {
    padding: 0;
    margin: 0;
}

QTreeWidget#CameraFeaturesTree::item:hover,
QTreeWidget#GocatorFeaturesTree::item:hover {
    background: #ffffff;
}

QTreeWidget#CameraFeaturesTree::item:selected,
QTreeWidget#GocatorFeaturesTree::item:selected {
    background: #ffffff;
    color: #16202b;
}

QTreeWidget#CameraFeaturesTree::branch:has-children:closed,
QTreeWidget#GocatorFeaturesTree::branch:has-children:closed {
    image: url(:/Resources/Icons/icons8-tree-forward-48.png);
    width: 16px;
    height: 16px;
}

QTreeWidget#CameraFeaturesTree::branch:has-children:open,
QTreeWidget#GocatorFeaturesTree::branch:has-children:open {
    image: url(:/Resources/Icons/icons8-tree-expand-arrow-48.png);
    width: 16px;
    height: 16px;
}

QTreeWidget#CameraFeaturesTree::branch:hover,
QTreeWidget#CameraFeaturesTree::branch:selected,
QTreeWidget#CameraFeaturesTree::branch:open:hover,
QTreeWidget#CameraFeaturesTree::branch:closed:hover,
QTreeWidget#GocatorFeaturesTree::branch:hover,
QTreeWidget#GocatorFeaturesTree::branch:selected,
QTreeWidget#GocatorFeaturesTree::branch:open:hover,
QTreeWidget#GocatorFeaturesTree::branch:closed:hover {
    background: transparent;
}

QTreeWidget#CameraFeaturesTree QHeaderView,
QTreeWidget#GocatorFeaturesTree QHeaderView {
    background: #ffffff;
    border: 1px solid #d6e0ea;
    border-radius: 10px;
}

QTreeWidget#CameraFeaturesTree QHeaderView::section,
QTreeWidget#GocatorFeaturesTree QHeaderView::section {
    background: transparent;
    color: #354657;
    border: none;
    border-right: 1px solid #edf2f7;
    min-height: 26px;
    padding: 0 12px;
    font-size: 12px;
    font-weight: 700;
}

QTreeWidget#CameraFeaturesTree QHeaderView::section:first,
QTreeWidget#GocatorFeaturesTree QHeaderView::section:first {
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
}

QTreeWidget#CameraFeaturesTree QHeaderView::section:last,
QTreeWidget#GocatorFeaturesTree QHeaderView::section:last {
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-right: none;
}

QCameraWidget QLabel {
    background: transparent;
    min-height: 22px;
    padding: 0 6px;
    margin: 0;
}

QCameraWidget QLabel:hover {
    background: #f5f5f5;
}

QCameraWidget QLabel#CameraStatusLabel:hover,
QGocatorWidget QLabel#GocatorStatusLabel:hover {
    background: #ffffff;
}

QCameraWidget QLabel#CameraMessageLabel,
QGocatorWidget QLabel#GocatorMessageLabel {
    background: transparent;
    border: none;
    padding: 0;
    margin-left: 3px;
    color: #354657;
    font-weight: 400;
}

QCameraWidget QLabel#CameraMessageLabel[messageState="normal"],
QGocatorWidget QLabel#GocatorMessageLabel[messageState="normal"] {
    color: #354657;
    font-weight: 400;
}

QCameraWidget QLabel#CameraMessageLabel[messageState="error"],
QGocatorWidget QLabel#GocatorMessageLabel[messageState="error"] {
    color: #c62828;
    font-weight: 700;
}

QTreeWidget#CameraFeaturesTree::item[messageState="error"],
QTreeWidget#GocatorFeaturesTree::item[messageState="error"] {
    color: #c62828;
    font-weight: 700;
}

QTreeWidget#CameraFeaturesTree::viewport,
QTreeWidget#GocatorFeaturesTree::viewport {
    background: transparent;
}
