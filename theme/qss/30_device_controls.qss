/* theme/qss/30_device_controls.qss: shared device-control theme; keep load order in Resources.cpp. */

QWidget[controlRole="devicePanel"] {
    background: @SURFACE@;
}

/* Compact panel-header state token; values are Idle, Connected or Live. */
QLabel[stateRole="deviceState"] {
    color: @TEXT@;
    font-weight: @WEIGHT_WIDGET_BOLD@;
}

/* Shared counter bubble for the device-panel counter row and statusbars. */
QLabel[statusRole="deviceCounter"] {
    background: @SURFACE@;
    border: 1px solid @CONTROLBORDER@;
    border-radius: 9px;
    padding: 0 7px;
    height: 24px;
    min-height: @CONTROL_HEIGHT@px;
    max-height: @CONTROL_HEIGHT@px;
    margin: 0 2px 0 0;
    color: @TEXT@;
    font-family: "@FONT_MONO@";
}
QLabel[statusRole="deviceCounter"][failedState="warning"] {
    border-color: @WARNING@;
    color: @WARNINGTEXT@;
}

QTabWidget[tabRole="DeviceControls"]::pane {
    padding: 0;
    background: transparent;
    border: none;
    border-top: 1px solid @BORDER@;
    border-radius: 0;
    top: 0;
}

QTabWidget[tabRole="DeviceControls"] > QTabBar {
    background: transparent;
    border-top: none;
    padding-top: 0;
}

/* Borderless tab scroll arrows keep their full 20px slot. */
QWidget[controlRole="devicePanel"] QTabBar QToolButton,
QWidget[controlRole="devicePanel"] QTabBar QToolButton#ScrollLeftButton {
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
    padding: 0;
    margin: 0;
}

/* In-card scope tabs: one frame owns the strip, separator, header and rows. */
QFrame[tabRole="DeviceScopeCard"] {
    background: @SURFACE@;
    border: @TREE_FRAME_BORDER_WIDTH@px solid @BORDER@;
    border-radius: @TREE_FRAME_RADIUS@px;
}

QFrame[tabRole="DeviceScopeCard"] > QTabBar {
    background: transparent;
}

QFrame[tabRole="DeviceScopeCard"] > QFrame#DeviceScopeCardSeparator {
    background: @BORDER@;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

QFrame[tabRole="DeviceScopeCard"] > QStackedWidget {
    background: transparent;
    border: none;
}

/* The card owns the frame; its feature pages keep the header, rows and search surface. */
QFrame[tabRole="DeviceScopeCard"] QTreeWidget[treeRole="DeviceFeatureTree"] {
    background: transparent;
    border: none;
    border-radius: 0;
}

QTreeWidget[treeRole="DeviceFeatureTree"] {
    background: @SURFACE@;
    alternate-background-color: @SURFACE@;
    selection-color: @TEXT@;
    show-decoration-selected: 0;
}

QTreeWidget[treeRole="DeviceFeatureTree"]::item:hover,
QTreeWidget[treeRole="DeviceFeatureTree"]::item:selected {
    background: transparent;
    color: @TEXT@;
}

/* Search uses the feature header surface with a compact,
softly lifted frame. */
SearchableTreeSurface {
    qproperty-searchInset: 10;
    qproperty-searchMaximumWidth: 440;
    qproperty-favoriteColor: @FOCUSBORDER@;
    qproperty-searchShadowBlur: 14;
    qproperty-searchShadowOffset: 2;
    qproperty-searchShadowColor: rgba(@SHADOW_RGB@, 42);
}/* Border,
white surface and corner geometry are shared with QHeaderView in 00_base.qss. */
QFrame#DeviceFeatureSearchBubble {
    padding: 0;
    height: 24px;
    min-height: @CONTROL_HEIGHT@px;
    max-height: @CONTROL_HEIGHT@px;
    margin: 0;
    color: @TEXT@;
}

QLineEdit#DeviceFeatureSearchInput,
QLineEdit#DeviceFeatureSearchInput:hover,
QLineEdit#DeviceFeatureSearchInput:focus {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    min-height: 22px;
    max-height: 22px;
    selection-background-color: @SELECTION@;
    selection-color: @TEXT@;
}

QLabel#DeviceFeatureSearchCount {
    background: transparent;
    border: none;
    color: @SECONDARYTEXT@;

    font-size: @FONT_COMPACT@px;
}

QToolButton#DeviceFeatureSearchClear {
    qproperty-icon: url(:/Resources/icon/search-clear.svg);
    qproperty-iconSize: 16px 16px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0;
    background: transparent;
    border-radius: 5px;

    border: none;
    outline: none;
}

QToolButton#DeviceFeatureSearchClear:enabled:hover:!pressed:!checked,
QToolButton#DeviceFeatureSearchClear:enabled[resourcesKeyboardFocus="true"]:!pressed:!checked,
QToolButton#DeviceFeatureFavoritesOnly:hover,
QToolButton#DeviceFeatureFavoritesOnly:pressed {
    background: transparent;

    border: none;
    outline: none;
}

QToolButton#DeviceFeatureSearchClear:enabled:pressed {
    background: transparent;
}

QToolButton#DeviceFeatureFavoritesOnly {
    qproperty-iconSize: 16px 16px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0;
    margin: 0;
    background: transparent;
    color: @SECONDARYTEXT@;

    font-size: @FONT_DISPLAY@px;

    border: none;
    outline: none;
}

QToolButton#DeviceFeatureFavoritesOnly:checked {
    background: transparent;
}

QToolButton#DeviceFeatureFavoritesOnly:checked {
    color: @TEXT@;

    border: none;
    outline: none;
}/* Active interaction takes precedence over hover and keyboard focus. */
QToolButton#DeviceFeatureSearchClear:enabled:pressed,
QToolButton#DeviceFeatureSearchClear:enabled:checked {

    border: none;
    outline: none;
}

/* Opt-in search-bubble state proposal; the inner input remains borderless. */
QFrame#DeviceFeatureSearchBubble[searchPreview="state-border"]:enabled:hover,
QFrame#DeviceFeatureSearchBubble[searchPreview="state-border"][designHovered="true"]:enabled,
QFrame#DeviceFeatureSearchBubble[searchPreview="state-border"][searchFocusWithin="true"]:enabled {
    border-color: @HOVERBORDER@;
}
QFrame#DeviceFeatureSearchBubble[searchPreview="state-border"][searchPressed="true"]:enabled {
    border-color: @FOCUSBORDER@;
}
QFrame#DeviceFeatureSearchBubble[searchPreview="state-border"]:disabled {
    border-color: @CONTROLBORDER@;
}

/* Keyboard focus remains distinct from pointer hover on named action surfaces. */
QToolButton#DeviceFeatureSearchClear:enabled[resourcesKeyboardFocus="true"]:focus:!pressed:!checked {
    border-color: @FOCUSBORDER@;
    outline: none;
}

/* Borderless favorites reserve the same 20px outer target during keyboard navigation. */
QToolButton#DeviceFeatureFavoritesOnly[resourcesKeyboardFocus="true"]:enabled:focus {
    border: @CONTROL_BORDER_WIDTH@px solid @FOCUSBORDER@;
    min-width: @COMPACT_ACTION_CONTENT_SIZE@px;
    max-width: @COMPACT_ACTION_CONTENT_SIZE@px;
    min-height: @COMPACT_ACTION_CONTENT_SIZE@px;
    max-height: @COMPACT_ACTION_CONTENT_SIZE@px;
}
