/* theme/qss/30_device_controls.qss: shared device-control theme; keep load order in Resources.cpp. */

QFramegrabberWidget,
QCameraWidget,
QGocatorWidget,
QHeliotisC4Widget,
QOneGenWidget,
QOneGenDeviceWidget {
    background: @SURFACE@;
}

QTabWidget#FramegrabberControlTabs::pane,
QTabWidget[tabRole="DeviceControls"]::pane {
    padding: 0;
    background: transparent;
    border: none;
    border-top: 1px solid @BORDER@;
    border-radius: 0;
    top: 0;
}

QTabWidget#FramegrabberControlTabs > QTabBar,
QTabWidget[tabRole="DeviceControls"] > QTabBar {
    background: transparent;
    border-top: none;
    padding-top: 0;
}



/* Borderless tab scroll arrows keep their full 20px slot. */
QFramegrabberWidget QTabBar QToolButton,
QCameraWidget QTabBar QToolButton,
QGocatorWidget QTabBar QToolButton,
QHeliotisC4Widget QTabBar QToolButton,
QOneGenWidget QTabBar QToolButton,
QOneGenDeviceWidget QTabBar QToolButton {
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
}

QTreeWidget[treeRole="DeviceFeatureTree"] {
    background: @SURFACE@;
    alternate-background-color: @SURFACE@;
    selection-color: @TEXT@;
    show-decoration-selected: 0;
}

QTreeWidget[treeRole="DeviceFeatureTree"]::item:hover,
QTreeWidget[treeRole="DeviceFeatureTree"]::item:selected {
    background: transparent;
    color: @TEXT@;
}



QFramegrabberWidget QLabel#FramegrabberStatusLabel:hover,
QCameraWidget QLabel#CameraStatusLabel:hover,
QGocatorWidget QLabel#GocatorStatusLabel:hover,
QHeliotisC4Widget QLabel#HeliotisC4StatusLabel:hover {
    background: @SURFACE@;
}/* Search uses the feature header surface with a compact,
softly lifted frame. */
SearchableTreeSurface {
    qproperty-searchInset: 10;
    qproperty-searchMaximumWidth: 440;
    qproperty-favoriteColor: @FOCUSBORDER@;
    qproperty-searchShadowBlur: 14;
    qproperty-searchShadowOffset: 2;
    qproperty-searchShadowColor: rgba(@SHADOW_RGB@, 42);
}/* Border,
white surface and corner geometry are shared with QHeaderView in 00_base.qss. */
QFrame#DeviceFeatureSearchBubble {
    padding: 0;
    height: 24px;
    min-height: @CONTROL_HEIGHT@px;
    max-height: @CONTROL_HEIGHT@px;
    margin: 0;
    color: @TEXT@;
}

QLineEdit#DeviceFeatureSearchInput,
QLineEdit#DeviceFeatureSearchInput:hover,
QLineEdit#DeviceFeatureSearchInput:focus {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
    min-height: 22px;
    max-height: 22px;
    selection-background-color: @SELECTION@;
    selection-color: @TEXT@;
}

QLabel#DeviceFeatureSearchCount {
    background: transparent;
    border: none;
    color: @SECONDARYTEXT@;

    font-size: @FONT_COMPACT@px;
}

QToolButton#DeviceFeatureSearchClear {
    qproperty-icon: url(:/Resources/icon/search-clear.svg);
    qproperty-iconSize: 16px 16px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0;
    background: transparent;
    border-radius: 5px;

    border: none;
    outline: none;
}

QToolButton#DeviceFeatureSearchClear:enabled:hover:!pressed:!checked,
QToolButton#DeviceFeatureSearchClear:enabled:focus:!pressed:!checked {
    background: transparent;

    border: none;
    outline: none;
}

QToolButton#DeviceFeatureSearchClear:enabled:pressed {
    background: transparent;
}

QToolButton#DeviceFeatureFavoritesOnly {
    qproperty-iconSize: 16px 16px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0;
    margin: 0;
    background: transparent;
    color: @SECONDARYTEXT@;

    font-size: @FONT_DISPLAY@px;

    border: none;
    outline: none;
}

QToolButton#DeviceFeatureFavoritesOnly:hover,
QToolButton#DeviceFeatureFavoritesOnly:pressed {
    background: transparent;
    border: none;
    outline: none;
}

QToolButton#DeviceFeatureFavoritesOnly:checked {
    background: transparent;
}

QToolButton#DeviceFeatureFavoritesOnly:checked {
    color: @TEXT@;

    border: none;
    outline: none;
}/* Active interaction takes precedence over hover and keyboard focus. */
QToolButton#DeviceFeatureSearchClear:enabled:pressed,
QToolButton#DeviceFeatureSearchClear:enabled:checked {

    border: none;
    outline: none;
}

/* Opt-in search-bubble state proposal; the inner input remains borderless. */
QFrame#DeviceFeatureSearchBubble[searchPreview="state-border"]:enabled:hover,
QFrame#DeviceFeatureSearchBubble[searchPreview="state-border"][designHovered="true"]:enabled,
QFrame#DeviceFeatureSearchBubble[searchPreview="state-border"][searchFocusWithin="true"]:enabled {
    border-color: @HOVERBORDER@;
}
QFrame#DeviceFeatureSearchBubble[searchPreview="state-border"][searchPressed="true"]:enabled {
    border-color: @FOCUSBORDER@;
}
QFrame#DeviceFeatureSearchBubble[searchPreview="state-border"]:disabled {
    border-color: @CONTROLBORDER@;
}
